# ==========================================
# CinemaHub Production Environment Variables
# ==========================================
# Copy file này thành .env.prod và điền giá trị thật
# KHÔNG commit file .env.prod lên git!

# 1. PostgreSQL Database
DB_NAME=CinemaManagement
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD
ADMIN_INITIAL_PASSWORD=cinema2005@

# 2. Gemini AI Chatbot
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# 3. VnPay Payment Gateway (Sandbox)
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET

# 4. Google OAuth 2.0 Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 5. SMTP Email (Quên mật khẩu)
GOOGLE_CLIENT_ID=dien_id_google_neu_co
GOOGLE_CLIENT_SECRET=dien_secret_google_neu_co
SMTP_HOST=mail.cinemahubvn.io.vn
SMTP_PORT=587
SMTP_USER=support@cinemahubvn.io.vn
SMTP_PASS=Manh2005@
SMTP_FROM="CinemaHub Support <support@cinemahubvn.io.vn>"

# 6. Telegram Security Alert Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
