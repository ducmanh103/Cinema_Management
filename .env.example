# ==========================================
# CinemaHub Environment Variables Template
# ==========================================
# Copy file này thành .env hoặc .env.prod và điền giá trị thật
# KHÔNG commit file chứa giá trị bí mật lên git!

# 1. PostgreSQL Database
DB_NAME=CinemaManagement
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD
ADMIN_INITIAL_PASSWORD=YOUR_ADMIN_PASSWORD

# 2. Gemini AI Chatbot
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# 3. VnPay Payment Gateway (Sandbox)
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET

# 4. Google OAuth 2.0 Login
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# 5. SMTP Email (MFA OTP, Xác thực email & Quên mật khẩu)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL
SMTP_PASS=YOUR_APP_PASSWORD
SMTP_FROM=support@cinemahubvn.io.vn

# 6. Telegram Security Alert Bot (MFA OTP & Giám sát bảo mật)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ALERT_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# 7. Google reCAPTCHA v2 (Chống bot đăng ký / form spam)
RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY
