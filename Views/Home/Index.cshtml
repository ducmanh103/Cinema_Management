@model HomeLandingViewModel
@using CinemaManagement.Helpers
@using System.Text.Json
@{
    ViewData["Title"] = "Trải Nghiệm Điện Ảnh Thế Hệ Mới";
    ViewBag.FullWidth = true;

    var featured = Model.FeaturedMovies?.Any() == true ? Model.FeaturedMovies : Model.NowShowing.Take(6).ToList();
    var firstHero = featured.FirstOrDefault();

    var heroJsonList = featured.Select(m => new {
        id = m.MovieId,
        title = m.Title,
        description = string.IsNullOrWhiteSpace(m.Description)
            ? "Trải nghiệm siêu phẩm điện ảnh với chuẩn hình ảnh IMAX Laser 4K HDR và âm thanh vòm Dolby Atmos sống động tại hệ thống rạp CinemaHub."
            : m.Description,
        duration = m.Duration,
        releaseDate = m.ReleaseDate?.ToString("dd/MM/yyyy") ?? "Đang khởi chiếu",
        posterUrl = string.IsNullOrWhiteSpace(m.PosterUrl) ? "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800" : m.PosterUrl,
        bannerUrl = !string.IsNullOrWhiteSpace(m.BannerUrl) ? m.BannerUrl : (string.IsNullOrWhiteSpace(m.PosterUrl) ? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1400" : m.PosterUrl),
        ageBadgeText = MovieDisplayHelper.GetAgeBadgeText(m.Title),
        ageBadgeClass = MovieDisplayHelper.GetAgeBadgeClass(m.Title),
        format = MovieDisplayHelper.GetMovieFormat(m.Title),
        rating = MovieDisplayHelper.GetMovieRating(m.MovieId).ToString("0.0"),
        trailerUrl = MovieDisplayHelper.GetTrailerEmbedUrl(m.Title),
        genres = m.Genres ?? new List<string>()
    }).ToList();

    var showtimesJsonList = (Model.UpcomingShowtimes ?? new List<ShowtimeDto>()).Select(s => new {
        showtimeId = s.ShowtimeId,
        movieTitle = s.MovieTitle,
        theaterName = s.TheaterName,
        roomName = s.RoomName,
        dateKey = s.StartTime.ToString("yyyy-MM-dd"),
        dateDisplay = s.StartTime.ToString("dd/MM (ddd)"),
        timeDisplay = s.StartTime.ToString("HH:mm"),
        price = s.Price.ToString("N0") + "đ"
    }).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<!-- =========================================================================
     KINETIC MARQUEE RIBBON (Monochrome & Modern)
     ========================================================================= -->
<div class="ch-marquee-wrap" aria-label="CinemaHub Highlights">
    <div class="ch-marquee-track">
        <span class="ch-marquee-item"><i class="bi bi-badge-4k"></i> IMAX LASER 4K PROJECTION</span>
        <span class="ch-marquee-item"><i class="bi bi-soundwave"></i> DOLBY ATMOS 360° AUDIO</span>
        <span class="ch-marquee-item"><i class="bi bi-qr-code"></i> VÉ ĐIỆN TỬ VÀO RẠP TỨC THÌ</span>
        <span class="ch-marquee-item"><i class="bi bi-shield-check"></i> THANH TOÁN TRỰC TUYẾN BẢO MẬT</span>
        <span class="ch-marquee-item"><i class="bi bi-stars"></i> TRỢ LÝ AI GỢI Ý PHIM 24/7</span>
        <span class="ch-marquee-item"><i class="bi bi-badge-4k"></i> IMAX LASER 4K PROJECTION</span>
        <span class="ch-marquee-item"><i class="bi bi-soundwave"></i> DOLBY ATMOS 360° AUDIO</span>
        <span class="ch-marquee-item"><i class="bi bi-qr-code"></i> VÉ ĐIỆN TỬ VÀO RẠP TỨC THÌ</span>
        <span class="ch-marquee-item"><i class="bi bi-shield-check"></i> THANH TOÁN TRỰC TUYẾN BẢO MẬT</span>
        <span class="ch-marquee-item"><i class="bi bi-stars"></i> TRỢ LÝ AI GỢI Ý PHIM 24/7</span>
    </div>
</div>

<!-- =========================================================================
     1. FULL-BLEED KINETIC 3D HERO STAGE
     ========================================================================= -->
<section class="lp-hero" id="heroStage">
    <!-- Ambient Subtle Background Glow -->
    <div class="lp-ambient-orb lp-ambient-orb-1" aria-hidden="true"></div>
    <div class="lp-ambient-orb lp-ambient-orb-2" aria-hidden="true"></div>

    <div class="lp-hero-bg-layer">
        <div class="lp-hero-backdrop" id="heroBackdrop"
             style="background-image: url('@(!string.IsNullOrWhiteSpace(firstHero?.BannerUrl) ? firstHero.BannerUrl : (firstHero?.PosterUrl ?? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1400"))');"></div>
        <div class="lp-hero-vignette"></div>
        <div class="lp-hero-grid-overlay"></div>
    </div>

    <div class="lp-hero-inner">
        <div class="lp-hero-grid">
            <!-- Left Column: Active Blockbuster Details -->
            <div data-animate="fade-up" class="lp-hero-copy">
                <div class="lp-kicker-bar">
                    <span class="lp-kicker-pill">
                        <span class="lp-live-dot"></span>
                        Tâm Điểm Phòng Vé
                    </span>
                    <span class="lp-format-chip" id="heroFormat">
                        <i class="bi bi-badge-hd"></i>
                        @(firstHero != null ? MovieDisplayHelper.GetMovieFormat(firstHero.Title) : "IMAX 3D")
                    </span>
                    <span class="lp-age-chip @(firstHero != null ? MovieDisplayHelper.GetAgeBadgeClass(firstHero.Title) : "badge-age-t13")" id="heroAgeBadge">
                        @(firstHero != null ? MovieDisplayHelper.GetAgeBadgeText(firstHero.Title) : "T13")
                    </span>
                </div>

                <h1 class="lp-hero-title" id="heroTitle">
                    @(firstHero?.Title ?? "Siêu Phẩm Điện Ảnh CinemaHub")
                </h1>

                <div class="lp-hero-meta">
                    <span class="lp-meta-item lp-meta-rating">
                        <i class="bi bi-star-fill"></i>
                        <span id="heroRating">@(firstHero != null ? MovieDisplayHelper.GetMovieRating(firstHero.MovieId).ToString("0.0") : "9.2")</span>
                        <small class="text-white-50">/10</small>
                    </span>
                    <span class="lp-meta-divider"></span>
                    <span class="lp-meta-item">
                        <i class="bi bi-clock"></i>
                        <span id="heroDuration">@(firstHero?.Duration ?? 135) phút</span>
                    </span>
                    <span class="lp-meta-divider"></span>
                    <span class="lp-meta-item">
                        <i class="bi bi-calendar3"></i>
                        <span id="heroRelease">@(firstHero?.ReleaseDate?.ToString("dd/MM/yyyy") ?? "Đang chiếu")</span>
                    </span>
                </div>

                <div class="lp-hero-genres" id="heroGenres">
                    @if (firstHero?.Genres != null && firstHero.Genres.Any())
                    {
                        foreach (var g in firstHero.Genres.Take(4))
                        {
                            <span class="lp-genre-pill">@g</span>
                        }
                    }
                    else
                    {
                        <span class="lp-genre-pill">Hành Động</span>
                        <span class="lp-genre-pill">Viễn Tưởng</span>
                        <span class="lp-genre-pill">IMAX Blockbuster</span>
                    }
                </div>

                <p class="lp-hero-desc" id="heroDesc">
                    @(string.IsNullOrWhiteSpace(firstHero?.Description)
                        ? "Đắm chìm trong không gian điện ảnh chuẩn quốc tế với màn hình cong cực đại IMAX Laser 4K và hệ thống âm thanh vòm đa chiều Dolby Atmos."
                        : firstHero.Description)
                </p>

                <div class="lp-hero-actions">
                    <a id="heroBookBtn"
                       href="@(firstHero != null ? Url.Action("Index", "Showtimes", new { movieId = firstHero.MovieId }) : Url.Action("Index", "Showtimes"))"
                       class="lp-btn-primary cinema-magnetic">
                        <i class="bi bi-ticket-perforated"></i>
                        <span>Đặt Vé Suất Sớm Nhất</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <button type="button"
                            id="heroTrailerBtn"
                            class="lp-btn-glass"
                            data-trailer="@(firstHero != null ? MovieDisplayHelper.GetTrailerEmbedUrl(firstHero.Title) : "https://www.youtube.com/embed/YoHD9XEInc0")"
                            data-title="@(firstHero?.Title ?? "Trailer")">
                        <span class="lp-play-ring"><i class="bi bi-play-fill"></i></span>
                        <span>Trailer Official</span>
                    </button>

                    <a id="heroDetailBtn"
                       href="@(firstHero != null ? Url.Action("Details", "Movies", new { id = firstHero.MovieId }) : Url.Action("Index", "Movies"))"
                       class="lp-btn-glass">
                        <i class="bi bi-info-circle"></i>
                        <span>Chi Tiết</span>
                    </a>
                </div>

                <!-- Live Animated Counter Strip -->
                <div class="lp-hero-kpis">
                    <div class="lp-kpi-item">
                        <div class="lp-kpi-val"><b data-count-to="@Model.NowShowingCount">@Model.NowShowingCount</b><span>+</span></div>
                        <div class="lp-kpi-lbl">Phim Đang Chiếu</div>
                    </div>
                    <div class="lp-kpi-item">
                        <div class="lp-kpi-val"><b data-count-to="@Model.ShowtimesToday">@Model.ShowtimesToday</b><span>+</span></div>
                        <div class="lp-kpi-lbl">Suất Chiếu Hôm Nay</div>
                    </div>
                    <div class="lp-kpi-item">
                        <div class="lp-kpi-val"><b data-count-to="@Model.TotalTheaters">@Model.TotalTheaters</b></div>
                        <div class="lp-kpi-lbl">Cụm Rạp Tiêu Chuẩn</div>
                    </div>
                    <div class="lp-kpi-item">
                        <div class="lp-kpi-val"><b data-count-to="@Model.TotalSeats">@Model.TotalSeats</b><span>+</span></div>
                        <div class="lp-kpi-lbl">Ghế Ngồi Hiện Đại</div>
                    </div>
                </div>
            </div>

            <!-- Right Column: 3D Tilt Poster Stage + Interactive Thumbnail Deck -->
            <div class="lp-hero-showcase" data-animate="scale-in" data-delay="120">
                <div class="lp-poster-stage" id="posterTiltStage">
                    <div class="lp-poster-floating-badge lp-floating-badge-a">
                        <i class="bi bi-trophy"></i>
                        <div class="text-start">
                            <div class="text-white fw-bold" style="font-size:0.78rem;">Top Phòng Vé</div>
                            <div class="text-white-50" style="font-size:0.68rem;">Được đặt nhiều nhất</div>
                        </div>
                    </div>

                    <img id="heroPosterImg"
                         src="@(firstHero?.PosterUrl ?? "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800")"
                         alt="@(firstHero?.Title ?? "Poster")"
                         onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800'" />

                    <div class="lp-poster-floating-sound lp-floating-badge-b">
                        <i class="bi bi-soundwave"></i>
                        <div class="text-start">
                            <div class="text-white fw-bold" style="font-size:0.78rem;">Dolby Atmos 3D</div>
                            <div class="text-white-50" style="font-size:0.68rem;">Âm thanh vòm đa chiều</div>
                        </div>
                    </div>
                </div>

                @if (featured.Count > 1)
                {
                    <div class="lp-slide-progress-wrap" aria-hidden="true">
                        <div class="lp-slide-progress-bar" id="heroSlideProgress"></div>
                    </div>

                    <div class="lp-thumb-strip" role="tablist" aria-label="Chọn phim tiêu điểm">
                        @for (int i = 0; i < featured.Count; i++)
                        {
                            var item = featured[i];
                            <button type="button"
                                    class="lp-thumb-btn @(i == 0 ? "active" : "")"
                                    data-slide-idx="@i"
                                    title="@item.Title"
                                    aria-label="Xem @item.Title">
                                <img src="@item.PosterUrl"
                                     alt="@item.Title"
                                     onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=200'" />
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     2. FLOATING 4-STEP SMART QUICK BOOKING DOCK
     ========================================================================= -->
<div class="lp-booking-dock-wrap" data-animate="fade-up" data-delay="150">
    <div class="lp-booking-dock cinema-spotlight">
        <div class="lp-dock-header">
            <div class="lp-dock-title">
                <i class="bi bi-lightning-charge"></i>
                <span>ĐẶT VÉ NHANH TRỰC TUYẾN</span>
            </div>
            <div class="d-flex align-items-center gap-3 text-white-50" style="font-size:0.8rem;">
                <span><i class="bi bi-check2 me-1"></i>Chọn ghế thời gian thực</span>
                <span class="d-none d-sm-inline"><i class="bi bi-check2 me-1"></i>Giữ chỗ chuẩn xác</span>
            </div>
        </div>

        <div class="lp-dock-grid">
            <div class="lp-dock-step">
                <label class="lp-dock-step-label" for="qbMovie">
                    <span class="lp-dock-step-num">1</span> Phim
                </label>
                <select id="qbMovie" class="lp-dock-select">
                    <option value="">-- Tất cả phim đang mở bán --</option>
                </select>
            </div>

            <div class="lp-dock-step">
                <label class="lp-dock-step-label" for="qbTheater">
                    <span class="lp-dock-step-num">2</span> Cụm Rạp
                </label>
                <select id="qbTheater" class="lp-dock-select" disabled>
                    <option value="">-- Chọn phim trước --</option>
                </select>
            </div>

            <div class="lp-dock-step">
                <label class="lp-dock-step-label" for="qbDate">
                    <span class="lp-dock-step-num">3</span> Ngày Chiếu
                </label>
                <select id="qbDate" class="lp-dock-select" disabled>
                    <option value="">-- Chọn rạp trước --</option>
                </select>
            </div>

            <div class="lp-dock-step">
                <label class="lp-dock-step-label" for="qbTime">
                    <span class="lp-dock-step-num">4</span> Suất Chiếu
                </label>
                <select id="qbTime" class="lp-dock-select" disabled>
                    <option value="">-- Chọn ngày trước --</option>
                </select>
            </div>

            <button type="button" id="qbSubmitBtn" class="lp-dock-submit" disabled>
                <i class="bi bi-armchair"></i>
                <span>Chọn Ghế</span>
            </button>
        </div>
    </div>
</div>

<!-- =========================================================================
     3. INTERACTIVE MOVIE CATALOG (NOW SHOWING / COMING SOON + GENRE FILTER)
     ========================================================================= -->
<section class="lp-section" id="catalogSection">
    <div class="lp-container">
        <div class="lp-section-head" data-animate="fade-up">
            <div>
                <span class="lp-eyebrow"><i class="bi bi-film"></i> Danh Mục Điện Ảnh</span>
                <h2 class="lp-section-title">Khám Phá Lịch Phim Tại Rạp</h2>
                <p class="lp-section-sub">Lọc tức thì theo trạng thái khởi chiếu và thể loại bạn yêu thích.</p>
            </div>
            <a asp-controller="Movies" asp-action="Index" class="lp-btn-glass">
                <span>Xem Toàn Bộ Kho Phim</span>
                <i class="bi bi-arrow-up-right"></i>
            </a>
        </div>

        <!-- Tabs + Genre Pills -->
        <div class="lp-catalog-controls" data-animate="fade-up" data-delay="80">
            <div class="lp-tab-switch" role="tablist">
                <button type="button" class="lp-tab-btn active" data-catalog-tab="now">
                    <i class="bi bi-play-circle"></i>
                    <span>Đang Khởi Chiếu</span>
                    <span class="lp-tab-count">@Model.NowShowing.Count</span>
                </button>
                <button type="button" class="lp-tab-btn" data-catalog-tab="soon">
                    <i class="bi bi-calendar-plus"></i>
                    <span>Sắp Ra Mắt</span>
                    <span class="lp-tab-count">@Model.ComingSoon.Count</span>
                </button>
            </div>

            <div class="lp-genre-scroller" role="group" aria-label="Lọc theo thể loại">
                <button type="button" class="lp-genre-filter-btn active" data-genre-filter="all">Tất cả</button>
                @foreach (var genre in Model.Genres.Take(10))
                {
                    <button type="button" class="lp-genre-filter-btn" data-genre-filter="@genre">@genre</button>
                }
            </div>
        </div>

        <!-- Now Showing Grid -->
        <div class="lp-movie-grid" id="gridNowShowing">
            @foreach (var m in Model.NowShowing.Take(8))
            {
                var ageClass = MovieDisplayHelper.GetAgeBadgeClass(m.Title);
                var ageText = MovieDisplayHelper.GetAgeBadgeText(m.Title);
                var format = MovieDisplayHelper.GetMovieFormat(m.Title);
                var rating = MovieDisplayHelper.GetMovieRating(m.MovieId).ToString("0.0");
                var trailer = MovieDisplayHelper.GetTrailerEmbedUrl(m.Title);
                var genreStr = m.Genres != null ? string.Join("|", m.Genres) : "";

                <article class="lp-movie-card cinema-spotlight" data-genres="@genreStr" data-animate="fade-up">
                    <div class="lp-card-poster">
                        <div class="lp-card-badges-top">
                            <span class="lp-age-chip @ageClass">@ageText</span>
                            <span class="lp-card-format">@format</span>
                        </div>
                        <img src="@m.PosterUrl"
                             alt="@m.Title"
                             loading="lazy"
                             onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=600'" />
                        <span class="lp-card-rating-badge">
                            <i class="bi bi-star-fill"></i> @rating
                        </span>
                        <div class="lp-card-hover-overlay">
                            <button type="button"
                                    class="lp-play-trailer-circle js-open-trailer"
                                    data-trailer="@trailer"
                                    data-title="@m.Title"
                                    aria-label="Xem trailer @m.Title">
                                <i class="bi bi-play-fill"></i>
                            </button>
                            <span class="text-white fw-semibold" style="font-size:0.8rem;">Xem Trailer</span>
                        </div>
                    </div>
                    <div class="lp-card-body">
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@m.MovieId" class="lp-card-title" title="@m.Title">
                            @m.Title
                        </a>
                        <div class="lp-card-submeta">
                            <span><i class="bi bi-clock me-1"></i>@m.Duration phút</span>
                            <span>•</span>
                            <span class="text-truncate">@(m.Genres != null && m.Genres.Any() ? string.Join(", ", m.Genres.Take(2)) : "Điện ảnh")</span>
                        </div>
                        <div class="lp-card-footer">
                            <a asp-controller="Showtimes" asp-action="Index" asp-route-movieId="@m.MovieId" class="lp-card-book-btn">
                                <i class="bi bi-ticket-perforated"></i> Đặt Vé
                            </a>
                            <a asp-controller="Movies" asp-action="Details" asp-route-id="@m.MovieId" class="lp-card-info-btn" title="Chi tiết phim">
                                <i class="bi bi-arrow-up-right"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <!-- Coming Soon Grid (Hidden by default) -->
        <div class="lp-movie-grid d-none" id="gridComingSoon">
            @if (Model.ComingSoon.Any())
            {
                @foreach (var m in Model.ComingSoon.Take(8))
                {
                    var ageClass = MovieDisplayHelper.GetAgeBadgeClass(m.Title);
                    var ageText = MovieDisplayHelper.GetAgeBadgeText(m.Title);
                    var format = MovieDisplayHelper.GetMovieFormat(m.Title);
                    var trailer = MovieDisplayHelper.GetTrailerEmbedUrl(m.Title);
                    var genreStr = m.Genres != null ? string.Join("|", m.Genres) : "";

                    <article class="lp-movie-card cinema-spotlight" data-genres="@genreStr">
                        <div class="lp-card-poster">
                            <div class="lp-card-badges-top">
                                <span class="lp-age-chip @ageClass">@ageText</span>
                                <span class="lp-card-format">@format</span>
                            </div>
                            <img src="@m.PosterUrl"
                                 alt="@m.Title"
                                 loading="lazy"
                                 onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=600'" />
                            <span class="lp-card-rating-badge">
                                <i class="bi bi-calendar3"></i> @(m.ReleaseDate?.ToString("dd/MM") ?? "Sắp chiếu")
                            </span>
                            <div class="lp-card-hover-overlay">
                                <button type="button"
                                        class="lp-play-trailer-circle js-open-trailer"
                                        data-trailer="@trailer"
                                        data-title="@m.Title"
                                        aria-label="Xem trailer @m.Title">
                                    <i class="bi bi-play-fill"></i>
                                </button>
                                <span class="text-white fw-semibold" style="font-size:0.8rem;">Xem Trailer</span>
                            </div>
                        </div>
                        <div class="lp-card-body">
                            <a asp-controller="Movies" asp-action="Details" asp-route-id="@m.MovieId" class="lp-card-title" title="@m.Title">
                                @m.Title
                            </a>
                            <div class="lp-card-submeta">
                                <span><i class="bi bi-clock me-1"></i>@m.Duration phút</span>
                                <span>•</span>
                                <span class="text-truncate">@(m.Genres != null && m.Genres.Any() ? string.Join(", ", m.Genres.Take(2)) : "Bom tấn")</span>
                            </div>
                            <div class="lp-card-footer">
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@m.MovieId" class="lp-card-book-btn">
                                    <i class="bi bi-info-circle"></i> Xem Chi Tiết
                                </a>
                                <a asp-controller="Showtimes" asp-action="Index" asp-route-movieId="@m.MovieId" class="lp-card-info-btn" title="Kiểm tra lịch chiếu">
                                    <i class="bi bi-calendar3"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="col-12 text-center py-5 text-white-50">
                    <i class="bi bi-film fs-2 d-block mb-2"></i>
                    Hiện các siêu phẩm mới đang được cập nhật lịch khởi chiếu.
                </div>
            }
        </div>
    </div>
</section>

<!-- =========================================================================
     4. BENTO SHOWCASE: TOP BOX OFFICE PODIUM + INTERACTIVE 3D SEAT SIMULATOR
     ========================================================================= -->
<section class="lp-section pt-2">
    <div class="lp-container">
        <div class="lp-bento-split">
            <!-- Left Bento: Box Office Leaderboard -->
            <div class="lp-bento-panel cinema-spotlight" data-animate="fade-right">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <span class="lp-eyebrow"><i class="bi bi-trophy"></i> Bảng Xếp Hạng</span>
                        <h3 class="lp-section-title" style="font-size:1.65rem;">Top Phòng Vé Tuần Này</h3>
                    </div>
                    <a asp-controller="Showtimes" asp-action="Index" class="text-white-50 text-decoration-none small hover-white">
                        Xem tất cả <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="lp-rank-list">
                    @{
                        var topList = Model.TopBoxOffice?.Any() == true
                            ? Model.TopBoxOffice.Take(5).ToList()
                            : Model.NowShowing.Take(5).ToList();
                    }
                    @for (int i = 0; i < topList.Count; i++)
                    {
                        var t = topList[i];
                        var rankNum = i + 1;
                        var soldCount = t.BookedTicketCount > 0 ? t.BookedTicketCount : (120 - i * 15);
                        <a asp-controller="Showtimes" asp-action="Index" asp-route-movieId="@t.MovieId"
                           class="lp-rank-row rank-@rankNum">
                            <div class="lp-rank-num">#@rankNum</div>
                            <img src="@t.PosterUrl"
                                 alt="@t.Title"
                                 class="lp-rank-poster"
                                 onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=200'" />
                            <div>
                                <div class="lp-rank-title">@t.Title</div>
                                <div class="lp-rank-sub">
                                    <span><i class="bi bi-ticket me-1"></i>@soldCount.ToString("N0") vé</span>
                                    <span><i class="bi bi-star-fill me-1" style="color:#f5b942;"></i>@MovieDisplayHelper.GetMovieRating(t.MovieId).ToString("0.0")</span>
                                </div>
                            </div>
                            <span class="btn btn-sm rounded-pill px-3 py-1 fw-semibold"
                                  style="background:rgba(255,255,255,0.06);color:#ffffff;border:1px solid rgba(255,255,255,0.12);">
                                Đặt Vé
                            </span>
                        </a>
                    }
                </div>
            </div>

            <!-- Right Bento: Interactive 3D Auditorium Seat Simulator -->
            <div class="lp-bento-panel cinema-spotlight" data-animate="fade-left" data-delay="100">
                <span class="lp-eyebrow"><i class="bi bi-sliders"></i> Trải Nghiệm Chọn Ghế</span>
                <h3 class="lp-section-title" style="font-size:1.65rem;">Mô Phỏng Phòng Chiếu 3D</h3>
                <p class="text-white-50 mb-0" style="font-size:0.88rem;">
                    Trải nghiệm trực quan hệ thống đặt ghế chuẩn xác theo thời gian thực của CinemaHub.
                </p>

                <div class="lp-mini-auditorium">
                    <div class="lp-mini-screen"></div>
                    <div class="lp-mini-screen-lbl">MÀN HÌNH CONG IMAX LASER 4K</div>

                    <div class="lp-mini-seat-grid" id="demoMiniSeatGrid">
                        @foreach (var r in new[] { "A", "B", "C", "D" })
                        {
                            var isVip = r == "C" || r == "D";
                            <div class="lp-mini-seat-row">
                                @for (int c = 1; c <= 8; c++)
                                {
                                    var code = $"{r}{c}";
                                    var isBooked = (r == "B" && (c == 4 || c == 5)) || (r == "C" && c == 2);
                                    var isSelected = (r == "C" && (c == 4 || c == 5));
                                    <button type="button"
                                            class="lp-mini-seat @(isVip ? "vip" : "") @(isBooked ? "booked" : "") @(isSelected ? "selected" : "")"
                                            data-seat="@code"
                                            data-price="@(isVip ? 105000 : 90000)"
                                            @(isBooked ? "disabled" : "")>
                                        @code
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-center flex-wrap gap-3 mb-3" style="font-size:0.75rem;color:#94A3B8;">
                        <span><i class="bi bi-square-fill me-1" style="color:rgba(255,255,255,0.25);"></i>Ghế Thường (90K)</span>
                        <span><i class="bi bi-square-fill me-1" style="color:rgba(255,46,85,0.5);"></i>Ghế VIP (105K)</span>
                        <span><i class="bi bi-square-fill me-1" style="color:#FF2E55;"></i>Đang Chọn</span>
                        <span><i class="bi bi-square-fill me-1" style="color:rgba(255,255,255,0.08);"></i>Đã Đặt</span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-3 border-top border-secondary border-opacity-25">
                        <div class="text-start">
                            <div class="text-white-50" style="font-size:0.75rem;">Ghế thử nghiệm đang chọn:</div>
                            <div class="text-white fw-bold" id="demoSelectedSeatsText">C4, C5 • 210,000đ</div>
                        </div>
                        <a asp-controller="Showtimes" asp-action="Index" class="lp-btn-primary py-2 px-3" style="min-height:40px;font-size:0.84rem;">
                            <span>Chọn Suất Chiếu Thật</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     5. FLAGSHIP THEATERS SHOWCASE & AI CONCIERGE CTA
     ========================================================================= -->
<section class="lp-section pt-2">
    <div class="lp-container">
        <div class="lp-section-head" data-animate="fade-up">
            <div>
                <span class="lp-eyebrow"><i class="bi bi-geo-alt"></i> Hệ Thống Cụm Rạp</span>
                <h2 class="lp-section-title">Không Gian Điện Ảnh Đẳng Cấp</h2>
            </div>
            <a asp-controller="Home" asp-action="Theaters" class="lp-btn-glass">
                <span>Tất Cả Rạp</span>
                <i class="bi bi-arrow-up-right"></i>
            </a>
        </div>

        <div class="lp-theater-grid mb-5">
            @foreach (var th in (Model.Theaters ?? new List<TheaterCardDto>()).Take(3))
            {
                <div class="lp-theater-card cinema-spotlight" data-animate="fade-up">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="lp-format-chip"><i class="bi bi-building"></i> Flagship Cinema</span>
                        <span class="text-white-50 fw-semibold" style="font-size:0.82rem;"><i class="bi bi-star-fill text-warning me-1"></i>4.9/5</span>
                    </div>
                    <h3 class="text-white fw-bold mb-0" style="font-size:1.2rem;">@th.TheaterName</h3>
                    <p class="text-white-50 mb-0" style="font-size:0.88rem;">
                        <i class="bi bi-geo-alt me-1"></i>@th.Address
                    </p>
                    <div class="d-flex flex-wrap gap-2 mt-auto pt-2">
                        <span class="lp-genre-pill">@th.RoomCount phòng chiếu</span>
                        <span class="lp-genre-pill">@th.SeatCount ghế ngồi</span>
                    </div>
                    <a asp-controller="Showtimes" asp-action="Index" asp-route-theaterId="@th.TheaterId"
                       class="lp-card-book-btn mt-2">
                        <i class="bi bi-calendar3"></i> Xem Suất Chiếu
                    </a>
                </div>
            }
        </div>

        <!-- AI Concierge Interactive Banner -->
        <div class="lp-ai-concierge-banner cinema-spotlight" data-animate="scale-in">
            <div>
                <span class="lp-eyebrow"><i class="bi bi-stars"></i> Trợ Lý Thông Minh 24/7</span>
                <h2 class="lp-section-title mb-3">Chưa Biết Xem Phim Gì Tối Nay?</h2>
                <p class="text-white-50 mb-4" style="font-size:0.95rem;line-height:1.7;">
                    Hỏi ngay <strong class="text-white">Trợ lý AI CinemaHub</strong> để được gợi ý phim hợp gu, tra cứu suất chiếu trống gần nhất hoặc giá vé chỉ qua một câu trò chuyện tự nhiên.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <button type="button" class="lp-btn-primary" onclick="(document.getElementById('chatbot-trigger') || document.getElementById('mobileDockChatBtn'))?.click()">
                        <i class="bi bi-chat-text"></i>
                        <span>Trò Chuyện Với AI</span>
                    </button>
                    <a asp-controller="Home" asp-action="News" class="lp-btn-glass">
                        <span>Tin &amp; Ưu Đãi</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            <div class="d-flex flex-column gap-3">
                <div class="p-3 rounded-4" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);">
                    <div class="text-white-50 fw-semibold mb-1" style="font-size:0.78rem;">Gợi ý câu hỏi nhanh:</div>
                    <div class="text-white" style="font-size:0.9rem;">"Tối nay có suất phim hành động nào quanh 20:00 không?"</div>
                </div>
                <div class="p-3 rounded-4" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);">
                    <div class="text-white-50 fw-semibold mb-1" style="font-size:0.78rem;">Phản hồi tức thì:</div>
                    <div class="text-white-50" style="font-size:0.86rem;">AI tự động đối chiếu lịch chiếu thời gian thực để dẫn bạn trực tiếp tới phòng chọn ghế.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     OFFICIAL TRAILER MODAL
     ========================================================================= -->
<div class="modal fade" id="landingTrailerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content" style="background:#080c18;border:1px solid rgba(255,255,255,0.15);border-radius:24px;overflow:hidden;">
            <div class="modal-header border-0 px-4 pt-3 pb-2 d-flex align-items-center justify-content-between">
                <h5 class="modal-title text-white fw-bold d-flex align-items-center gap-2" id="landingTrailerTitle">
                    <i class="bi bi-play-circle"></i> Trailer Chính Thức
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9 bg-black">
                    <iframe id="landingTrailerIframe" src="" title="Movie Trailer" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.CINEMAHUB_HERO_MOVIES = @Html.Raw(JsonSerializer.Serialize(heroJsonList));
        window.CINEMAHUB_QUICK_SHOWTIMES = @Html.Raw(JsonSerializer.Serialize(showtimesJsonList));
        window.CINEMAHUB_SELECT_SEAT_URL = '@Url.Action("SelectSeat", "Booking")';
    </script>
    <script src="~/js/landing.js" asp-append-version="true"></script>
}
