                        <span class="lp-pay-pill"><i class="bi bi-qr-code-scan text-info" aria-hidden="true"></i> VNPay QR</span>
                        <span class="lp-pay-pill"><i class="bi bi-bank text-success" aria-hidden="true"></i> Thẻ ATM Nội Địa</span>
                        <span class="lp-pay-pill"><i class="bi bi-credit-card-2-front text-warning" aria-hidden="true"></i> Quốc Tế</span>
                    </div>
                    <a asp-controller="Booking" asp-action="MyTickets" class="lp-card-quick-btn">
