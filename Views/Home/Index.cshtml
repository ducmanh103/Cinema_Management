                            <button type="button" class="lp-mini-seat is-vip js-demo-seat is-selected" data-seat="E4" data-price="95000" aria-pressed="true">E4</button>
                            <button type="button" class="lp-mini-seat is-vip js-demo-seat is-selected" data-seat="E5" data-price="95000" aria-pressed="true">E5</button>
                            <button type="button" class="lp-mini-seat is-vip js-demo-seat" data-seat="E6" data-price="95000" aria-pressed="false">E6</button>
                            <button type="button" class="lp-mini-seat is-vip is-held" disabled title="Đã đặt">E7</button>
                            <button type="button" class="lp-mini-seat is-vip js-demo-seat" data-seat="E8" data-price="95000" aria-pressed="false">E8</button>
