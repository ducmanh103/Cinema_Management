                        </a>
                    </div>
                </div>
            </div>

            @* Bento 2: CinemaHub AI Assistant (Connected to /api/chatbot/message) *@
            <div class="lp-bento-card lp-bento-span-5">
                <div>
                    <span class="lp-bento-tag" style="background: rgba(99,102,241,0.16); color:#a5b4fc; border:1px solid rgba(99,102,241,0.35);">
                        <i class="bi bi-stars" aria-hidden="true"></i> Gemini AI Assistant • 24/7
                    </span>
                    <h3 class="lp-bento-title">Trợ Lý Điện Ảnh Thông Minh</h3>
                    <p class="lp-bento-desc">
                        Tra cứu phim đang chiếu, suất chiếu theo thời gian thực và kiểm tra vé đã đặt ngay trong khung trò chuyện. Chạm thử một câu hỏi bên dưới:
                    </p>
                </div>

                <div class="lp-ai-prompts">
                    <button type="button" class="lp-ai-chip js-chatbot-prompt" data-prompt="phim đang chiếu">
                        <span><i class="bi bi-chat-dots me-2 text-info" aria-hidden="true"></i>Gợi ý các phim đang chiếu nổi bật</span>
                        <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
