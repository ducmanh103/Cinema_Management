                    <p class="lp-bento-desc">
                        Đăng nhập một chạm bằng tài khoản Google hoặc xác thực mã OTP qua Email. Dữ liệu phiên đăng nhập được bảo vệ bởi cơ chế chống giả mạo và kiểm soát truy cập đa tầng.
                    </p>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="lp-pay-badges">
                        <span class="lp-pay-pill"><i class="bi bi-google text-danger" aria-hidden="true"></i> Google Sign-In</span>
                        <span class="lp-pay-pill"><i class="bi bi-envelope-check text-primary" aria-hidden="true"></i> Xác Thực Email OTP</span>
                    </div>
                    @if (isLoggedIn)
                    {
                        <a asp-controller="Account" asp-action="Profile" class="lp-card-quick-btn">
                            Hồ sơ của bạn <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="lp-card-quick-btn">
                            Đăng nhập ngay <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    @* =====================================================================
       6. THEATER NETWORK SPOTLIGHT (LIVE FROM POSTGRESQL)
       ===================================================================== *@
    @if (theaters.Any())
    {
        <section class="lp-section container lp-reveal" aria-labelledby="lpTheatersHeading">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
                <div>
                    <div class="lp-eyebrow">
                        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Không Gian Trình Chiếu
                    </div>
                    <h2 id="lpTheatersHeading" class="lp-section-heading">Hệ Thống Cụm Rạp Tiêu Biểu</h2>
                    <p class="lp-section-sub mb-0">Xem nhanh số phòng chiếu, sức chứa ghế ngồi và mở lịch chiếu từng cụm rạp ngay tại chỗ.</p>
                </div>
                <a asp-controller="Home" asp-action="Theaters" class="lp-btn-glass py-2 px-4">
                    <span>Xem tất cả @vm.TotalTheaters rạp</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </div>

            <div class="row g-4">
                @for (int i = 0; i < Math.Min(3, theaters.Count); i++)
                {
                    var t = theaters[i];
                    var cover = theaterCovers[i % theaterCovers.Length];
                    var tech = techLabels[i % techLabels.Length];

                    <div class="col-lg-4 col-md-6">
                        <article class="lp-theater-card">
                            <div class="lp-theater-cover">
                                <img src="@cover" alt="@t.TheaterName" loading="lazy" />
                                <span class="lp-theater-tech">@tech</span>
                                @if (t.NextShowtime.HasValue)
                                {
                                    <span class="lp-theater-status">
                                        <span class="lp-live-dot" style="background:#34d399;box-shadow:0 0 8px #34d399;" aria-hidden="true"></span>
                                        Suất kế: @t.NextShowtime.Value.ToString("HH:mm")
                                    </span>
                                }
                            </div>
                            <div class="lp-theater-body">
                                <h3 class="h5 fw-bold text-white mb-2">@t.TheaterName</h3>
                                <p class="small text-muted mb-0">
                                    <i class="bi bi-geo-alt-fill text-danger me-1" aria-hidden="true"></i>
                                    @(string.IsNullOrWhiteSpace(t.Address) ? "Hệ thống rạp CinemaHub Việt Nam" : t.Address)
                                </p>

                                <div class="lp-theater-specs">
                                    <span class="lp-spec-pill">
                                        <i class="bi bi-easel2 me-1 text-danger" aria-hidden="true"></i>@t.RoomCount phòng
                                    </span>
                                    <span class="lp-spec-pill">
                                        <i class="bi bi-person-workspace me-1 text-info" aria-hidden="true"></i>@t.SeatCount.ToString("N0") ghế
                                    </span>
                                    @if (t.ShowtimesToday > 0)
                                    {
                                        <span class="lp-spec-pill">
                                            <i class="bi bi-play-btn me-1 text-warning" aria-hidden="true"></i>@t.ShowtimesToday suất hôm nay
                                        </span>
                                    }
                                </div>

                                <div class="mt-auto d-flex gap-2">
                                    <button type="button"
                                            class="lp-btn-primary py-2 px-3 flex-grow-1 js-quick-view-theater"
                                            style="font-size: 0.86rem;"
                                            data-theater-id="@t.TheaterId"
                                            data-theater-name="@t.TheaterName"
                                            data-theater-address="@t.Address">
                                        <i class="bi bi-calendar2-week" aria-hidden="true"></i>
                                        <span>Lịch Chiếu Nhanh</span>
                                    </button>
                                    <a href="https://maps.google.com/?q=@Uri.EscapeDataString(t.Address ?? t.TheaterName)"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="lp-btn-glass py-2 px-3"
                                       aria-label="Mở bản đồ @t.TheaterName"
                                       title="Xem bản đồ">
                                        <i class="bi bi-map" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </section>
    }

