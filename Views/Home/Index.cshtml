                    </a>
                </div>
            </div>

            @* Bento 4: Google OAuth 2.0, OTP Email & Enterprise Security *@
            <div class="lp-bento-card lp-bento-span-6">
                <div>
                    <span class="lp-bento-tag" style="background: rgba(245,197,24,0.14); color:var(--lp-gold); border:1px solid rgba(245,197,24,0.32);">
                        <i class="bi bi-person-check-fill" aria-hidden="true"></i> Google OAuth 2.0 • Bảo Mật OTP
                    </span>
