@using System.Globalization
@using CinemaManagement.Helpers
@using CinemaManagement.Models.ViewModels
@model HomeLandingViewModel
@{
    ViewData["Title"] = "Trang Chủ";
    Layout = "_Layout";
    ViewBag.FullWidth = true;

    var vm = Model ?? new HomeLandingViewModel();
    var featured = vm.FeaturedMovies;
    var nowShowing = vm.NowShowing;
    var comingSoon = vm.ComingSoon;
    var topBoxOffice = vm.TopBoxOffice;
    var theaters = vm.Theaters;
    var upcoming = vm.UpcomingShowtimes;
    var genres = vm.Genres;

    var theaterCovers = new[]
    {
        "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=900&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=900&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1595769816263-9b910be24d5f?q=80&w=900&auto=format&fit=crop"
    };
    var techLabels = new[] { "IMAX LASER", "DOLBY ATMOS", "4DX SCREENX" };

    bool isLoggedIn = User.Identity?.IsAuthenticated == true;
    string memberName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Bạn";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<div class="lp-root pb-5">

    @* =====================================================================
       1. WIDESCREEN IMMERSIVE HERO STAGE
       ===================================================================== *@
    <section class="lp-hero" aria-label="Phim tâm điểm tại CinemaHub">
        @if (featured.Any())
        {
            <div id="lpHeroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < featured.Count; i++)
                    {
                        var movie = featured[i];
                        var bgUrl = !string.IsNullOrWhiteSpace(movie.BannerUrl) ? movie.BannerUrl : movie.PosterUrl;
                        var bgStyle = !string.IsNullOrWhiteSpace(bgUrl) ? $"background-image: url('{bgUrl}');" : "";
                        var rating = GetMovieRating(movie.MovieId).ToString("F1");
                        var format = GetMovieFormat(movie.Title);
                        var ageCls = GetAgeBadgeClass(movie.Title);
                        var ageTxt = GetAgeBadgeText(movie.Title);
                        var ageDesc = GetAgeBadgeDesc(movie.Title);
                        var synopsis = string.IsNullOrWhiteSpace(movie.Description)
                            ? "Trải nghiệm siêu phẩm điện ảnh với chất lượng hình ảnh sắc nét chuẩn IMAX và âm thanh vòm sống động tại hệ thống rạp CinemaHub."
                            : (movie.Description.Length > 195 ? movie.Description.Substring(0, 195) + "..." : movie.Description);

                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="lp-hero-slide">
                                <div class="lp-hero-backdrop" style="@bgStyle"></div>
                                <div class="lp-hero-vignette"></div>

                                <div class="lp-hero-inner">
                                    <div class="container">
                                        <div class="row align-items-center g-4 g-lg-5">
                                            <div class="col-lg-7 col-xl-8">
                                                <div class="lp-eyebrow-group">
                                                    <span class="lp-pill-live">
                                                        <span class="lp-live-dot" aria-hidden="true"></span>
                                                        @(movie.IsHot ? "Top Phòng Vé • Đang Chiếu" : "Tâm Điểm Điện Ảnh")
                                                    </span>
                                                    @if (movie.HasShowtimes)
                                                    {
                                                        <span class="lp-pill-available">
                                                            <i class="bi bi-check2-circle" aria-hidden="true"></i> Đang mở bán vé
                                                        </span>
                                                    }
                                                </div>

                                                <h1 class="lp-hero-title">@movie.Title</h1>

                                                <div class="lp-hero-meta">
                                                    <span class="lp-meta-rating">
                                                        <i class="bi bi-star-fill" aria-hidden="true"></i> @rating<span class="opacity-75 fw-normal">/10</span>
                                                    </span>
                                                    <span class="lp-age-badge @ageCls" title="@ageDesc">@ageTxt</span>
                                                    <span class="lp-meta-format">@format</span>
                                                    <span class="lp-meta-divider" aria-hidden="true"></span>
                                                    <span><i class="bi bi-clock me-1" aria-hidden="true"></i>@movie.Duration phút</span>
                                                    @if (movie.ReleaseDate.HasValue)
                                                    {
                                                        <span class="lp-meta-divider" aria-hidden="true"></span>
                                                        <span><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@movie.ReleaseDate.Value.ToString("dd/MM/yyyy")</span>
                                                    }
                                                </div>

                                                @if (movie.Genres.Any())
                                                {
                                                    <div class="lp-hero-genres">
                                                        @foreach (var g in movie.Genres.Take(4))
                                                        {
                                                            <span class="lp-genre-chip-hero">@g</span>
                                                        }
                                                    </div>
                                                }

                                                <p class="lp-hero-desc d-none d-sm-block">@synopsis</p>

                                                <div class="lp-hero-actions">
                                                    <button type="button"
                                                            class="lp-btn-primary js-quick-book-movie"
                                                            data-movie-id="@movie.MovieId"
                                                            data-movie-title="@movie.Title">
                                                        <i class="bi bi-ticket-perforated-fill" aria-hidden="true"></i>
                                                        <span>Mua Vé Nhanh</span>
                                                    </button>
                                                    <a asp-controller="Showtimes"
                                                       asp-action="Index"
                                                       asp-route-movieId="@movie.MovieId"
                                                       class="lp-btn-glass">
                                                        <i class="bi bi-calendar2-week" aria-hidden="true"></i>
                                                        <span>Xem Lịch Chiếu</span>
                                                    </a>
                                                    <a asp-controller="Movies"
                                                       asp-action="Details"
                                                       asp-route-id="@movie.MovieId"
                                                       class="lp-btn-glass">
                                                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                                                        <span>Chi Tiết</span>
                                                    </a>
                                                </div>
                                            </div>

                                            <div class="col-lg-5 col-xl-4 d-none d-lg-block">
                                                <div class="lp-hero-poster-stage">
                                                    <div class="lp-hero-poster-card">
                                                        @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
                                                        {
                                                            <img src="@movie.PosterUrl" alt="Poster phim @movie.Title" />
                                                        }
                                                        <div class="lp-hero-poster-ribbon">
                                                            <span class="fw-bold text-white">
                                                                <i class="bi bi-badge-hd-fill text-danger me-1" aria-hidden="true"></i>@format
                                                            </span>
                                                            <span class="text-warning fw-bold">
                                                                <i class="bi bi-star-fill me-1" aria-hidden="true"></i>@rating
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (featured.Count > 1)
                {
                    <div class="lp-hero-dock-wrap">
                        <div class="container d-flex justify-content-lg-end justify-content-center">
                            <div class="lp-hero-dock" role="group" aria-label="Điều khiển banner phim nổi bật">
                                @for (int i = 0; i < featured.Count; i++)
                                {
                                    var f = featured[i];
                                    var thumbSrc = !string.IsNullOrWhiteSpace(f.PosterUrl) ? f.PosterUrl : f.BannerUrl;
                                    <button type="button"
                                            class="lp-dock-thumb js-hero-thumb @(i == 0 ? "active" : "")"
                                            data-slide-to="@i"
                                            aria-label="Xem phim @f.Title"
                                            aria-current="@(i == 0 ? "true" : "false")"
                                            title="@f.Title">
                                        @if (!string.IsNullOrWhiteSpace(thumbSrc))
                                        {
                                            <img src="@thumbSrc" alt="" />
                                        }
                                    </button>
                                }
                                <button type="button"
                                        id="lpHeroPauseBtn"
                                        class="lp-dock-control ms-1"
                                        aria-pressed="false"
                                        aria-label="Tạm dừng chuyển cảnh tự động"
                                        title="Tạm dừng">
                                    <i class="bi bi-pause-fill" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="lp-hero-slide">
                <div class="lp-hero-vignette"></div>
                <div class="lp-hero-inner">
                    <div class="container text-center">
                        <span class="lp-pill-live mb-3">
                            <span class="lp-live-dot" aria-hidden="true"></span> CinemaHub Vietnam
                        </span>
                        <h1 class="lp-hero-title">Định Chuẩn Trải Nghiệm Điện Ảnh Hiện Đại</h1>
                        <p class="lp-hero-desc mx-auto">Đặt vé siêu tốc, chọn ghế 3D trực quan, giữ chỗ tự động 15 phút và thanh toán trực tuyến an toàn qua cổng VNPay.</p>
                        <div class="lp-hero-actions justify-content-center">
                            <a asp-controller="Movies" asp-action="Index" class="lp-btn-primary">
                                <i class="bi bi-film" aria-hidden="true"></i> Khám Phá Phim
                            </a>
                            <a asp-controller="Showtimes" asp-action="Index" class="lp-btn-glass">
                                <i class="bi bi-calendar2-week" aria-hidden="true"></i> Xem Lịch Chiếu
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>

    @* =====================================================================
       2. 4-STEP SMART LIVE BOOKING COMMAND BAR (CONNECTED TO /api/ShowtimesApi)
       ===================================================================== *@
    <section class="lp-booking-wrap" aria-label="Công cụ đặt vé nhanh">
        <div class="container">
            <div class="lp-booking-bar">
                <div class="lp-booking-head">
                    <div class="lp-booking-title">
                        <i class="bi bi-lightning-charge-fill text-warning fs-5" aria-hidden="true"></i>
                        <span>Đặt Vé Nhanh 30 Giây</span>
                        <span class="badge rounded-pill ms-1" style="background: rgba(16,185,129,0.14); color:#34d399; font-size:0.7rem;">
                            Live API
                        </span>
                    </div>
                    <div class="lp-booking-badge">
                        <span id="lpBookingLiveHint">Chọn phim để tải suất chiếu thời gian thực</span>
                        <span class="d-none d-md-inline text-secondary">•</span>
                        <span class="d-none d-md-inline">
                            <i class="bi bi-shield-lock-fill text-danger me-1" aria-hidden="true"></i>Giữ ghế 15 phút &amp; Thanh toán VNPay
                        </span>
                    </div>
                </div>

                <form id="lpQuickBookingForm" asp-controller="Showtimes" asp-action="Index" method="get" class="row g-3 align-items-end">
                    <div class="col-lg-3 col-md-6">
                        <div class="lp-step-field">
                            <label for="lpSelectMovie" class="lp-step-label">
                                <span class="lp-step-num">01</span> Chọn Phim
                            </label>
                            <select id="lpSelectMovie" name="movieId" class="form-select lp-select">
                                <option value="">-- Tất cả phim đang chiếu --</option>
                                @foreach (var m in nowShowing)
                                {
                                    <option value="@m.MovieId">@m.Title @(m.IsHot ? "(Hot)" : "")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="lp-step-field">
                            <label for="lpSelectTheater" class="lp-step-label">
                                <span class="lp-step-num">02</span> Cụm Rạp
                            </label>
                            <select id="lpSelectTheater" name="theaterId" class="form-select lp-select">
                                <option value="">-- Tất cả các rạp (@theaters.Count) --</option>
                                @foreach (var t in theaters)
                                {
                                    <option value="@t.TheaterId">@t.TheaterName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-4">
                        <div class="lp-step-field">
                            <label for="lpSelectDate" class="lp-step-label">
                                <span class="lp-step-num">03</span> Ngày Chiếu
                            </label>
                            <select id="lpSelectDate" name="date" class="form-select lp-select">
                                @for (int i = 0; i < 14; i++)
                                {
                                    var targetDate = VietnamTime.Today.AddDays(i);
                                    var dateVal = targetDate.ToString("yyyy-MM-dd");
                                    var dateLbl = i == 0 ? "Hôm nay, " + targetDate.ToString("dd/MM")
                                                : i == 1 ? "Ngày mai, " + targetDate.ToString("dd/MM")
                                                : targetDate.ToString("ddd, dd/MM", new CultureInfo("vi-VN"));
                                    <option value="@dateVal">@dateLbl</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-4">
                        <div class="lp-step-field">
                            <label for="lpSelectShowtime" class="lp-step-label">
                                <span class="lp-step-num">04</span> Giờ Chiếu
                            </label>
                            <select id="lpSelectShowtime" class="form-select lp-select" disabled aria-label="Chọn suất chiếu cụ thể">
                                <option value="">-- Chọn phim trước --</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-4">
                        <button type="submit" id="lpBookingSubmitBtn" class="lp-booking-submit">
                            <i class="bi bi-arrow-right-circle-fill" aria-hidden="true"></i>
                            <span id="lpBookingSubmitText">Tìm Suất Chiếu</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    @* =====================================================================
       3. LIVE SYSTEM METRICS & NEXT-UP SHOWTIMES STRIP
       ===================================================================== *@
    <section class="container pt-5 lp-reveal" aria-label="Thống kê hệ thống và suất chiếu sắp diễn ra">
        <div class="lp-metrics-grid">
            <div class="lp-metric-card">
                <div class="lp-metric-icon"><i class="bi bi-buildings-fill" aria-hidden="true"></i></div>
                <div>
                    <div class="lp-metric-value">@(vm.TotalTheaters > 0 ? vm.TotalTheaters.ToString() : "7+")</div>
                    <div class="lp-metric-label">Cụm Rạp Hiện Đại Toàn Quốc</div>
                </div>
            </div>
            <div class="lp-metric-card">
                <div class="lp-metric-icon"><i class="bi bi-easel2-fill" aria-hidden="true"></i></div>
                <div>
                    <div class="lp-metric-value">@(vm.TotalRooms > 0 ? vm.TotalRooms.ToString() : "24+")</div>
                    <div class="lp-metric-label">Phòng Chiếu Chuẩn Quốc Tế</div>
                </div>
            </div>
            <div class="lp-metric-card">
                <div class="lp-metric-icon"><i class="bi bi-grid-3x3-gap-fill" aria-hidden="true"></i></div>
                <div>
                    <div class="lp-metric-value">@(vm.TotalSeats > 0 ? vm.TotalSeats.ToString("N0") : "2.400+")</div>
                    <div class="lp-metric-label">Ghế Standard • VIP • Couple</div>
                </div>
            </div>
            <div class="lp-metric-card">
                <div class="lp-metric-icon"><i class="bi bi-film" aria-hidden="true"></i></div>
                <div>
                    <div class="lp-metric-value">@vm.NowShowingCount Phim</div>
                    <div class="lp-metric-label">
                        @(vm.ShowtimesToday > 0 ? $"{vm.ShowtimesToday} suất chiếu trong hôm nay" : "Đang công chiếu trên toàn hệ thống")
                    </div>
                </div>
            </div>
        </div>

        @if (upcoming.Any())
        {
            <div class="lp-upcoming-box mt-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="lp-live-dot" aria-hidden="true"></span>
                        <span class="fw-bold text-white small text-uppercase" style="letter-spacing: 0.8px;">
                            Suất Chiếu Sắp Bắt Đầu — Chọn Ghế 1 Chạm
                        </span>
                    </div>
                    <a asp-controller="Showtimes" asp-action="Index" class="text-decoration-none small fw-semibold" style="color: #ff6b74;">
                        Xem toàn bộ lịch chiếu <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </div>

                <div class="lp-upcoming-scroll">
                    @foreach (var st in upcoming)
                    {
                        var isToday = st.StartTime.Date == VietnamTime.Today;
                        var timeBadge = isToday
                            ? st.StartTime.ToString("HH:mm")
                            : st.StartTime.ToString("HH:mm • dd/MM");

                        <a asp-controller="Booking"
                           asp-action="SelectSeat"
                           asp-route-id="@st.ShowtimeId"
                           class="lp-ticket-stub"
                           title="Đặt ghế @st.MovieTitle lúc @st.StartTime.ToString("HH:mm dd/MM")">
                            @if (!string.IsNullOrWhiteSpace(st.MoviePosterUrl))
                            {
                                <img src="@st.MoviePosterUrl" alt="" class="lp-stub-poster" loading="lazy" />
                            }
                            else
                            {
                                <div class="lp-stub-poster d-flex align-items-center justify-content-center text-secondary">
                                    <i class="bi bi-film" aria-hidden="true"></i>
                                </div>
                            }
                            <div class="lp-stub-body">
                                <div class="lp-stub-time-row">
                                    <span class="lp-stub-time">@timeBadge</span>
                                    <span class="lp-stub-seats">Còn @st.AvailableSeats ghế</span>
                                </div>
                                <div class="lp-stub-movie">@st.MovieTitle</div>
                                <div class="lp-stub-venue">
                                    @st.TheaterName • @st.RoomName • <span style="color: var(--lp-gold); font-weight:600;">@st.Price.ToString("N0")₫</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    </section>

    @* =====================================================================
       4. INTERACTIVE MOVIE CATALOG & BOX OFFICE RANKING
       ===================================================================== *@
    <section id="movies-showcase" class="lp-section container lp-reveal" aria-labelledby="lpMoviesHeading">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <div class="lp-eyebrow">
                    <i class="bi bi-camera-reels-fill" aria-hidden="true"></i> Kho Phim Điện Ảnh
                </div>
                <h2 id="lpMoviesHeading" class="lp-section-heading">Khám Phá Danh Mục Phim Tại Rạp</h2>
                <p class="lp-section-sub mb-0">Lọc tức thì theo trạng thái công chiếu, bảng xếp hạng vé đặt thực tế và thể loại yêu thích.</p>
            </div>
            <a asp-controller="Movies" asp-action="Index" class="lp-btn-glass py-2 px-4">
                <span>Tất cả phim</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>

        <div class="lp-catalog-controls">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="lp-tab-group" role="tablist" aria-label="Chọn danh mục phim">
                    <button type="button" class="lp-tab-btn js-movie-tab active" role="tab" aria-selected="true" data-tab="now">
                        <i class="bi bi-play-circle-fill" aria-hidden="true"></i>
                        <span>Đang Chiếu</span>
                        <span class="lp-tab-count">@nowShowing.Count</span>
                    </button>
                    <button type="button" class="lp-tab-btn js-movie-tab" role="tab" aria-selected="false" data-tab="soon">
                        <i class="bi bi-calendar-event" aria-hidden="true"></i>
                        <span>Sắp Chiếu</span>
                        <span class="lp-tab-count">@comingSoon.Count</span>
                    </button>
                    <button type="button" class="lp-tab-btn js-movie-tab" role="tab" aria-selected="false" data-tab="hot">
                        <i class="bi bi-trophy-fill" aria-hidden="true"></i>
                        <span>Top Thịnh Hành</span>
                        <span class="lp-tab-count">@topBoxOffice.Count</span>
                    </button>
                </div>

                <div class="lp-search-box">
                    <i class="bi bi-search lp-search-icon" aria-hidden="true"></i>
                    <input type="search"
                           id="lpMovieSearch"
                           class="form-control lp-search-input"
                           placeholder="Tìm nhanh tên phim..."
                           aria-label="Tìm nhanh tên phim" />
                </div>
            </div>

            @if (genres.Any())
            {
                <div class="lp-genre-scroll" role="group" aria-label="Lọc theo thể loại">
                    <button type="button" class="lp-genre-pill js-genre-pill active" data-genre="all">Tất cả thể loại</button>
                    @foreach (var g in genres)
                    {
                        <button type="button" class="lp-genre-pill js-genre-pill" data-genre="@g">@g</button>
                    }
                </div>
            }
        </div>

        <div class="row g-4" id="lpMoviesGrid">
            @* --- Tab 1: Now Showing (up to 8) --- *@
            @foreach (var movie in nowShowing.Take(8))
            {
                var genresPipe = string.Join("|", movie.Genres);
                var genresDisplay = movie.Genres.Any() ? string.Join(" • ", movie.Genres.Take(3)) : "Phim điện ảnh";
                var rating = GetMovieRating(movie.MovieId).ToString("F1");

                <div class="col-6 col-md-4 col-lg-3 js-movie-item"
                     data-tab-group="now"
                     data-genres="@genresPipe"
                     data-title="@movie.Title">
                    <article class="lp-movie-card">
                        <div class="lp-poster-wrap">
                            @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl" class="lp-poster-img" alt="@movie.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-secondary">
                                    <i class="bi bi-film fs-1" aria-hidden="true"></i>
                                </div>
                            }

                            <div class="lp-poster-top">
                                <span class="lp-rating-chip">
                                    <i class="bi bi-star-fill" aria-hidden="true"></i> @rating
                                </span>
                                <span class="lp-age-badge @GetAgeBadgeClass(movie.Title)" title="@GetAgeBadgeDesc(movie.Title)">
                                    @GetAgeBadgeText(movie.Title)
                                </span>
                            </div>

                            <div class="lp-poster-bottom">
                                @if (movie.IsHot)
                                {
                                    <span class="lp-hot-chip">
                                        <i class="bi bi-fire" aria-hidden="true"></i> Hot
                                    </span>
                                }
                                <span class="lp-format-chip">@GetMovieFormat(movie.Title)</span>
                            </div>

                            <div class="lp-poster-scrim">
                                <button type="button"
                                        class="lp-btn-primary w-100 py-2 js-quick-book-movie"
                                        data-movie-id="@movie.MovieId"
                                        data-movie-title="@movie.Title">
                                    <i class="bi bi-ticket-perforated-fill" aria-hidden="true"></i>
                                    <span>Mua Vé Nhanh</span>
                                </button>
                                <a asp-controller="Movies"
                                   asp-action="Details"
                                   asp-route-id="@movie.MovieId"
                                   class="lp-btn-glass w-100 py-2">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                    <span>Chi Tiết Phim</span>
                                </a>
                            </div>
                        </div>

                        <div class="lp-card-body">
                            <div class="lp-card-genres">@genresDisplay</div>
                            <h3 class="lp-card-title" title="@movie.Title">
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId">@movie.Title</a>
                            </h3>
                            <div class="lp-card-meta-foot">
                                <span><i class="bi bi-clock me-1" aria-hidden="true"></i>@movie.Duration phút</span>
                                <button type="button"
                                        class="lp-card-quick-btn js-quick-book-movie"
                                        data-movie-id="@movie.MovieId"
                                        data-movie-title="@movie.Title">
                                    Đặt vé
                                </button>
                            </div>
                        </div>
                    </article>
                </div>
            }

            @* --- Tab 2: Coming Soon (up to 8) --- *@
            @foreach (var movie in comingSoon.Take(8))
            {
                var genresPipe = string.Join("|", movie.Genres);
                var genresDisplay = movie.Genres.Any() ? string.Join(" • ", movie.Genres.Take(3)) : "Phim sắp khởi chiếu";
                var rating = GetMovieRating(movie.MovieId).ToString("F1");

                <div class="col-6 col-md-4 col-lg-3 js-movie-item d-none"
                     data-tab-group="soon"
                     data-genres="@genresPipe"
                     data-title="@movie.Title">
                    <article class="lp-movie-card">
                        <div class="lp-poster-wrap">
                            @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl" class="lp-poster-img" alt="@movie.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-secondary">
                                    <i class="bi bi-film fs-1" aria-hidden="true"></i>
                                </div>
                            }

                            <div class="lp-poster-top">
                                <span class="lp-rating-chip">
                                    <i class="bi bi-star-fill" aria-hidden="true"></i> @rating
                                </span>
                                <span class="lp-age-badge @GetAgeBadgeClass(movie.Title)" title="@GetAgeBadgeDesc(movie.Title)">
                                    @GetAgeBadgeText(movie.Title)
                                </span>
                            </div>

                            <div class="lp-poster-bottom">
                                <span class="lp-format-chip">@GetMovieFormat(movie.Title)</span>
                            </div>

                            <div class="lp-poster-scrim">
                                <a asp-controller="Movies"
                                   asp-action="Details"
                                   asp-route-id="@movie.MovieId"
                                   class="lp-btn-primary w-100 py-2">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                    <span>Xem Thông Tin</span>
                                </a>
                            </div>
                        </div>

                        <div class="lp-card-body">
                            <div class="lp-card-genres">@genresDisplay</div>
                            <h3 class="lp-card-title" title="@movie.Title">
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId">@movie.Title</a>
                            </h3>
                            <div class="lp-card-meta-foot">
                                <span>
                                    <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>
                                    @(movie.ReleaseDate?.ToString("dd/MM/yyyy") ?? "Sắp công bố")
                                </span>
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId" class="lp-card-quick-btn">
                                    Chi tiết
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            }

            @* --- Tab 3: Top Box Office / Trending (up to 6) --- *@
            @for (int r = 0; r < topBoxOffice.Count; r++)
            {
                var movie = topBoxOffice[r];
                var genresPipe = string.Join("|", movie.Genres);
                var genresDisplay = movie.Genres.Any() ? string.Join(" • ", movie.Genres.Take(3)) : "Phim điện ảnh";
                var rating = GetMovieRating(movie.MovieId).ToString("F1");

                <div class="col-6 col-md-4 col-lg-4 col-xl-2 js-movie-item d-none"
                     data-tab-group="hot"
                     data-genres="@genresPipe"
                     data-title="@movie.Title">
                    <article class="lp-movie-card">
                        <div class="lp-poster-wrap">
                            @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl" class="lp-poster-img" alt="@movie.Title" loading="lazy" />
                            }
                            <div class="lp-poster-top">
                                <span class="lp-rating-chip">
                                    <i class="bi bi-star-fill" aria-hidden="true"></i> @rating
                                </span>
                                <span class="lp-age-badge @GetAgeBadgeClass(movie.Title)">@GetAgeBadgeText(movie.Title)</span>
                            </div>
                            <div class="lp-rank-badge" aria-label="Hạng @(r + 1)">@((r + 1).ToString("D2"))</div>

                            <div class="lp-poster-scrim">
                                @if (movie.Status == "Now Showing")
                                {
                                    <button type="button"
                                            class="lp-btn-primary w-100 py-2 px-2 js-quick-book-movie"
                                            style="font-size:0.8rem;"
                                            data-movie-id="@movie.MovieId"
                                            data-movie-title="@movie.Title">
                                        Mua Vé
                                    </button>
                                }
                                <a asp-controller="Movies"
                                   asp-action="Details"
                                   asp-route-id="@movie.MovieId"
                                   class="lp-btn-glass w-100 py-2 px-2"
                                   style="font-size:0.8rem;">
                                    Chi Tiết
                                </a>
                            </div>
                        </div>
                        <div class="lp-card-body p-3">
                            <div class="lp-card-genres">@genresDisplay</div>
                            <h3 class="lp-card-title mb-2" style="font-size:0.94rem;">
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId">@movie.Title</a>
                            </h3>
                            <div class="lp-card-meta-foot pt-2" style="font-size:0.74rem;">
                                <span>@movie.Duration phút</span>
                                <span class="text-warning fw-semibold">Top #@(r + 1)</span>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>

        <div id="lpMovieEmptyState" class="text-center py-5 d-none">
            <i class="bi bi-search text-secondary fs-1" aria-hidden="true"></i>
            <h5 class="text-white fw-bold mt-3 mb-2">Không tìm thấy bộ phim phù hợp</h5>
            <p class="text-muted small mb-3">Hãy thử chọn thể loại khác hoặc xoá từ khoá tìm kiếm.</p>
            <button type="button" id="lpResetMovieFilter" class="lp-btn-glass py-2 px-4">Xoá bộ lọc</button>
        </div>
    </section>

    @* =====================================================================
       5. BENTO ECOSYSTEM GRID — ALIGNED 100% TO BACKEND CAPABILITIES
       ===================================================================== *@
    <section id="lp-ecosystem" class="lp-section container lp-reveal" aria-labelledby="lpEcosystemHeading">
