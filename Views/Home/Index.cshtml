                            <button type="button" class="lp-mini-seat js-demo-seat" data-seat="D4" data-price="75000" aria-pressed="false">D4</button>
                            <button type="button" class="lp-mini-seat js-demo-seat" data-seat="D5" data-price="75000" aria-pressed="false">D5</button>
                            <button type="button" class="lp-mini-seat is-held" disabled title="Đang được giữ chỗ">D6</button>
                            <button type="button" class="lp-mini-seat js-demo-seat" data-seat="D7" data-price="75000" aria-pressed="false">D7</button>
                            <button type="button" class="lp-mini-seat js-demo-seat" data-seat="D8" data-price="75000" aria-pressed="false">D8</button>
                        </div>
