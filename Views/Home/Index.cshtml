@{
    ViewData["Title"] = "Trang Chủ";
    Layout = "_Layout";
    var nowShowing = ViewBag.NowShowing as List<CinemaManagement.Models.Movie> ?? new();
    var comingSoon = ViewBag.ComingSoon as List<CinemaManagement.Models.Movie> ?? new();
    var featuredMovies = nowShowing.Take(3).ToList();
}

<style>
/* Hero Section Styles */
.hero-banner {
    position: relative;
    height: 70vh;
    min-height: 500px;
    background-size: cover;
    background-position: center top;
    display: flex;
    align-items: flex-end;
    margin-top: -100px;
    margin-bottom: 3rem;
    overflow: hidden;
}
.hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--dark) 0%, transparent 60%, rgba(0,0,0,0.4) 100%);
}
.hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: 50px;
    width: 100%;
}
.hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    text-transform: uppercase;
    text-shadow: 2px 2px 10px rgba(0,0,0,0.8);
    margin-bottom: 1rem;
}
.carousel-indicators {
    margin-bottom: 10px;
}
.carousel-indicators [data-bs-target] {
    width: 30px;
    height: 4px;
    background-color: rgba(255,255,255,0.5);
    border: none;
    border-radius: 2px;
}
.carousel-indicators .active {
    background-color: var(--primary);
}

/* Quick Booking Widget */
.quick-booking-panel {
    background: rgba(20, 20, 20, 0.85);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 20px;
    transform: translateY(-50%);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    position: relative;
    z-index: 10;
}
.section-title {
    position: relative;
    display: inline-block;
    padding-bottom: 10px;
    margin-bottom: 30px;
    font-weight: 700;
    font-size: 2rem;
}
.section-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 50px;
    height: 4px;
    background-color: var(--primary);
    border-radius: 2px;
}
</style>

@if (featuredMovies.Any())
{
    <!-- Hero Slider -->
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
        <div class="carousel-indicators">
            @for (int i = 0; i < featuredMovies.Count; i++)
            {
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" class="@(i==0 ? "active" : "")"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (int i = 0; i < featuredMovies.Count; i++)
            {
                var movie = featuredMovies[i];
                <div class="carousel-item @(i==0 ? "active" : "") hero-banner" style="border-bottom: 1px solid #333;">
                    <!-- Background: Use BannerUrl if available, otherwise fallback to blurred PosterUrl -->
                    @if (!string.IsNullOrEmpty(movie.BannerUrl))
                    {
                        <div style="position: absolute; inset: 0; background-image: url('@(movie.BannerUrl)'); background-size: cover; background-position: center; filter: brightness(0.5);"></div>
                    }
                    else
                    {
                        <div style="position: absolute; inset: 0; background-image: url('@(movie.PosterUrl)'); background-size: cover; background-position: center; filter: blur(25px) brightness(0.4); transform: scale(1.1);"></div>
                    }
                    
                    <div class="hero-overlay"></div>
                    <div class="container hero-content">
                        <div class="row align-items-center">
                            <!-- Movie Poster Thumbnail on the Left (Desktop only) -->
                            <div class="col-lg-4 d-none d-lg-flex justify-content-center">
                                @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                {
                                    <img src="@movie.PosterUrl" alt="@movie.Title" class="img-fluid rounded-4 shadow-lg" style="max-height: 400px; border: 1px solid rgba(255,255,255,0.2); transform: perspective(1000px) rotateY(10deg); transition: transform 0.5s;" onmouseover="this.style.transform='perspective(1000px) rotateY(0deg) scale(1.05)'" onmouseout="this.style.transform='perspective(1000px) rotateY(10deg)'" />
                                }
                            </div>
                            
                            <!-- Movie Info on the Right -->
                            <div class="col-lg-8">
                                <span class="badge bg-danger mb-3 fs-6 px-3 py-2 shadow">Khởi chiếu ngay</span>
                                <h1 class="hero-title">@movie.Title</h1>
                                <p class="lead text-light" style="max-width: 600px; text-shadow: 1px 1px 5px #000; line-height: 1.6;">
                                    @movie.Description
                                </p>
                                <div class="d-flex gap-3 mt-4">
                                    <a asp-controller="Showtimes" asp-action="Index" asp-route-movieId="@movie.MovieId" class="btn btn-primary-custom px-4 py-2 fs-5 fw-bold rounded-pill shadow-lg">
                                        <i class="bi bi-ticket-perforated"></i> Đặt Vé Ngay
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true" style="width: 3rem; height: 3rem; filter: drop-shadow(0 0 5px #000);"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true" style="width: 3rem; height: 3rem; filter: drop-shadow(0 0 5px #000);"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}
else
{
    <!-- Default banner if no movies -->
    <div class="hero-banner" style="background: linear-gradient(45deg, #111, #333);">
        <div class="container hero-content text-center">
            <h1 class="hero-title">CINEMAHUB</h1>
            <p class="lead">Trải nghiệm điện ảnh đỉnh cao</p>
        </div>
    </div>
}

<div class="container">
    <!-- Quick Booking -->
    <div class="row justify-content-center" style="margin-top: -80px;">
        <div class="col-lg-10">
            <div class="quick-booking-panel d-flex flex-column flex-md-row gap-3 align-items-center justify-content-between">
                <div><h5 class="mb-0 fw-bold text-nowrap"><i class="bi bi-lightning-charge-fill text-warning"></i> Chọn Phim Nhanh</h5></div>
                <div class="flex-grow-1 w-100">
                    <form asp-controller="Showtimes" asp-action="Index" method="get" class="row g-2">
                        <div class="col-md-9">
                            <select name="movieId" class="form-select form-select-lg">
                                <option value="">-- Chọn phim đang chiếu --</option>
                                @foreach (var m in nowShowing)
                                {
                                    <option value="@m.MovieId">@m.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary-custom btn-lg w-100 fw-bold">Mua vé</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Phim đang chiếu -->
    <div class="mt-5 pt-3">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <h2 class="section-title mb-0">Phim Đang Chiếu</h2>
            <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-light rounded-pill px-4">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        
        <div class="row g-4">
            @foreach (var movie in nowShowing.Take(8))
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="movie-card">
                        <a asp-controller="Showtimes" asp-action="Index" asp-route-movieId="@movie.MovieId" class="text-decoration-none text-light">
                            <div class="movie-poster-wrapper">
                                @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                {
                                    <img src="@movie.PosterUrl" class="movie-poster" alt="@movie.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="background:#222; font-size:3rem;">🎬</div>
                                }
                                <div class="movie-badge-status badge bg-danger">Đang chiếu</div>
                                
                                <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(to top, rgba(0,0,0,0.9), transparent); opacity: 0; transition: opacity 0.3s; /* Hover overlay target */" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0'">
                                    <div class="btn btn-primary-custom w-100">Theo Cầu <i class="bi bi-ticket-fill"></i></div>
                                </div>
                            </div>
                            <div class="p-3">
                                <h6 class="text-truncate fw-bold mb-1" style="font-size: 1.1rem;">@movie.Title</h6>
                                <div class="d-flex justify-content-between text-muted small">
                                    <span><i class="bi bi-clock"></i> @movie.Duration'</span>
                                    <span><i class="bi bi-star-fill text-warning"></i> 9.0</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Phim sắp chiếu -->
    @if (comingSoon.Any())
    {
        <div class="mt-5 pt-5 mb-5">
            <h2 class="section-title">Phim Sắp Chiếu</h2>
            <div class="row g-4">
                @foreach (var movie in comingSoon.Take(4))
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="movie-card" style="opacity: 0.85;">
                            <div class="movie-poster-wrapper">
                                @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                {
                                    <img src="@movie.PosterUrl" class="movie-poster" alt="@movie.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="background:#222; font-size:3rem;">🎬</div>
                                }
                                <div class="movie-badge-status badge text-dark bg-warning">Sắp chiếu</div>
                            </div>
                            <div class="p-3 text-center">
                                <h6 class="text-truncate fw-bold mb-1">@movie.Title</h6>
                                <div class="text-muted small">Khởi chiếu: @movie.ReleaseDate?.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
