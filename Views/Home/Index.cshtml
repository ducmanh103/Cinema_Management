                        <span class="badge bg-warning text-dark align-self-start mb-2">Đặc Quyền Thành Viên</span>
                        <h3 class="h5 fw-bold text-white mb-2">Trải Nghiệm Phòng Chiếu IMAX Laser &amp; Ghế VIP Hạng Thương Gia</h3>
                        <p class="small text-muted mb-3">Đắm chìm trong đại cảnh điện ảnh sắc nét gấp 4 lần cùng hệ thống âm thanh vòm 64 kênh độc lập.</p>
                        <span class="mt-auto small fw-bold" style="color:#ff6b74;">
                            Khám phá công nghệ <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </span>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-controller="Home" asp-action="News" class="lp-promo-card">
                    <div class="lp-promo-thumb">
                        <img src="/img/movies/marvel-phase-6.jpg" alt="Tin tức bom tấn điện ảnh" loading="lazy" />
                    </div>
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <span class="badge bg-info text-dark align-self-start mb-2">Tiêu Điểm Phòng Vé</span>
                        <h3 class="h5 fw-bold text-white mb-2">Loạt Bom Tấn Quốc Tế &amp; Phim Việt Đổ Bộ Mùa Lễ Hội</h3>
                        <p class="small text-muted mb-3">Cập nhật sớm nhất lịch khởi chiếu, đánh giá chuyên sâu và các suất chiếu sớm đặc biệt tại CinemaHub.</p>
                        <span class="mt-auto small fw-bold" style="color:#ff6b74;">
                            Đọc tin điện ảnh <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </span>
                    </div>
                </a>
            </div>
        </div>
    </section>

    @* =====================================================================
       8. FINAL MEMBER CONVERSION BANNER
       ===================================================================== *@
    <section class="lp-section container pb-4 lp-reveal" aria-label="Bắt đầu trải nghiệm CinemaHub">
        <div class="lp-cta-banner">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    @if (isLoggedIn)
                    {
                        <div class="lp-eyebrow">
                            <i class="bi bi-stars" aria-hidden="true"></i> Chào mừng trở lại, @memberName
                        </div>
                        <h2 class="lp-section-heading mb-2">Sẵn Sàng Cho Suất Chiếu Tiếp Theo?</h2>
                        <p class="lp-section-sub mb-0">
                            Chọn bộ phim yêu thích, giữ ghế đẹp nhất trong phòng chiếu hoặc kiểm tra ngay vé điện tử đã đặt của bạn.
                        </p>
                    }
                    else
                    {
                        <div class="lp-eyebrow">
                            <i class="bi bi-ticket-detailed-fill" aria-hidden="true"></i> Thành Viên CinemaHub
                        </div>
                        <h2 class="lp-section-heading mb-2">Đặt Ghế Đẹp Nhất Chỉ Trong 30 Giây</h2>
                        <p class="lp-section-sub mb-0">
                            Tạo tài khoản miễn phí hoặc đăng nhập nhanh bằng Google để giữ chỗ trực tuyến, thanh toán VNPay an toàn và lưu trữ toàn bộ vé điện tử.
                        </p>
                    }
                </div>
                <div class="col-lg-5 d-flex flex-wrap gap-3 justify-content-lg-end">
                    @if (isLoggedIn)
                    {
                        <a asp-controller="Showtimes" asp-action="Index" class="lp-btn-primary">
                            <i class="bi bi-ticket-perforated-fill" aria-hidden="true"></i>
                            <span>Đặt Vé Ngay</span>
                        </a>
                        <a asp-controller="Booking" asp-action="MyTickets" class="lp-btn-glass">
                            <i class="bi bi-journal-bookmark-fill" aria-hidden="true"></i>
                            <span>Vé Đã Đặt</span>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="lp-btn-primary">
                            <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
                            <span>Đăng Ký Miễn Phí</span>
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="lp-btn-glass">
                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                            <span>Đăng Nhập / Google</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@* =========================================================================
   UNIFIED INSTANT SHOWTIMES MODAL (FETCHES /api/ShowtimesApi/...)
   ========================================================================= *@
<div class="modal fade" id="lpQuickShowtimesModal" tabindex="-1" aria-labelledby="lpModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content lp-modal-content shadow-lg">
            <div class="modal-header border-secondary border-opacity-25 px-4 py-3">
                <div>
                    <h4 class="modal-title fw-bold text-white mb-1" id="lpModalTitle">Lịch Chiếu Nhanh</h4>
                    <div class="small text-muted" id="lpModalSub"></div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng hộp thoại"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <div id="lpModalDates" class="lp-modal-dates mb-3"></div>
                <div id="lpModalBody"></div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25 px-4 py-3 justify-content-between">
                <span class="small text-muted">
                    <i class="bi bi-shield-check text-success me-1" aria-hidden="true"></i>Giữ ghế tự động 15 phút khi thanh toán
                </span>
                <a id="lpModalFullLink" href="/Showtimes" class="lp-card-quick-btn">
                    Mở trang lịch chiếu đầy đủ <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/landing.js" asp-append-version="true"></script>
}

@functions {
    public string GetAgeBadgeClass(string title)
    {
        var cls = MovieDisplayHelper.GetAgeBadgeClass(title);
        return cls.Replace("badge-age-", "lp-age-");
    }
    public string GetAgeBadgeText(string title) => MovieDisplayHelper.GetAgeBadgeText(title);
    public string GetAgeBadgeDesc(string title) => MovieDisplayHelper.GetAgeBadgeDesc(title);
    public string GetMovieFormat(string title) => MovieDisplayHelper.GetMovieFormat(title);
    public double GetMovieRating(int id) => MovieDisplayHelper.GetMovieRating(id);
}
