@{
    ViewData["Title"] = "Về CinemaHub";
}

<style>
    .about-header {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        margin-bottom: 3rem;
    }
    .about-header-img {
        width: 100%;
        height: 400px;
        object-fit: cover;
        filter: brightness(0.6);
    }
    .about-header-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, rgba(11,12,16,0.9), transparent);
        display: flex;
        align-items: center;
        padding-left: 5%;
    }
    .feature-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 16px;
        padding: 30px;
        text-align: center;
        transition: transform 0.3s;
    }
    .feature-box:hover {
        transform: translateY(-10px);
        background: rgba(229, 9, 20, 0.05);
        border-color: rgba(229, 9, 20, 0.3);
    }
    .feature-icon {
        font-size: 3rem;
        color: var(--primary);
        margin-bottom: 20px;
    }
</style>

<div class="about-header shadow-lg">
    <img src="https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=1200&auto=format&fit=crop" class="about-header-img" alt="Inside CinemaHub" />
    <div class="about-header-overlay">
        <div>
            <span class="badge bg-danger px-3 py-2 fs-6 mb-3 rounded-pill">Câu chuyện của chúng tôi</span>
            <h1 class="fw-bolder text-white" style="font-size: 3.5rem; text-shadow: 2px 2px 15px rgba(0,0,0,0.8);">CINEMAHUB</h1>
            <p class="fs-4 text-light mt-2" style="max-width: 600px; line-height: 1.5; text-shadow: 1px 1px 10px rgba(0,0,0,0.8);">
                Định chuẩn lại trải nghiệm điện ảnh của người Việt. Nơi cảm xúc thăng hoa cùng âm thanh và hình ảnh tuyệt đỉnh.
            </p>
        </div>
    </div>
</div>

<div class="row align-items-center mb-5 mt-5">
    <div class="col-lg-6">
        <h2 class="fw-bold mb-4"><span style="color:var(--primary)">Tầm nhìn</span> chiến lược</h2>
        <p class="text-muted fs-5" style="line-height: 1.8;">
            Được thành lập vào năm 2024, CinemaHub ra đời với khát vọng mang đến một không gian giải trí sang trọng, khác biệt và đậm chất công nghệ cho khán giả Việt Nam.
        </p>
        <p class="text-muted fs-5" style="line-height: 1.8;">
            Chúng tôi không chỉ chiếu phim. Chúng tôi tạo ra một hệ sinh thái văn hóa thị giác, nơi mà mỗi lần bước chân vào rạp là một lần bạn được đắm mình vào đa vũ trụ của những giấc mơ.
        </p>
    </div>
    <div class="col-lg-6 text-center">
        <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=800&auto=format&fit=crop" alt="Cinema View" class="img-fluid rounded-4 shadow-lg" style="border: 2px solid rgba(255,255,255,0.1);" />
    </div>
</div>

<div class="row g-4 mt-5 mb-5 text-center">
    <div class="col-12 mb-3">
        <h2 class="fw-bold">Tại sao chọn CinemaHub?</h2>
    </div>
    <div class="col-md-4">
        <div class="feature-box h-100">
            <i class="bi bi-display feature-icon"></i>
            <h4 class="fw-bold">Công Nghệ IMAX Laser</h4>
            <p class="text-muted">Trang bị hệ thống máy chiếu kép Laser 4K sắc nét gấp 4 lần tiêu chuẩn thông thường, mang đến hình ảnh rực rỡ nhất.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-box h-100">
            <i class="bi bi-speaker feature-icon"></i>
            <h4 class="fw-bold">Âm thanh Dolby Atmos</h4>
            <p class="text-muted">Hệ thống âm thanh vòm đỉnh cao với 64 kênh độc lập, biến mọi tiếng động trở nên sống động như đang diễn ra quanh bạn.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-box h-100">
            <i class="bi bi-star feature-icon"></i>
            <h4 class="fw-bold">Dịch Vụ Đẳng Cấp</h4>
            <p class="text-muted">Phòng chờ VIP hạng thương gia, ghế ngồi bọc da cao cấp tự động ngả lưng, kèm theo menu ẩm thực riêng biệt.</p>
        </div>
    </div>
</div>

<div class="text-center p-5 mt-5" style="background: rgba(229, 9, 20, 0.1); border-radius: 20px; border: 1px solid rgba(229, 9, 20, 0.2);">
    <h3 class="fw-bold mb-3">Sẵn sàng trải nghiệm?</h3>
    <p class="text-light mb-4 fs-5">Hãy tham gia ngay cộng đồng yêu phim lớn nhất Việt Nam và nhận ưu đãi riêng cho người mới.</p>
    <a asp-controller="Movies" asp-action="Index" class="btn btn-primary-custom rounded-pill px-5 py-3 fs-5 fw-bold shadow"><i class="bi bi-ticket-detailed"></i> Đặt Vé Ngay Hôm Nay</a>
</div>
