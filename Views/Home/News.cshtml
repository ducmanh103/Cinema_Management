@{
    ViewData["Title"] = "Tin Tức Điện Ảnh & Cẩm Nang Đi Rạp";
    ViewBag.FullWidth = true;
}

<style>
    .nw-hero {
        padding: 48px 0 36px;
        background: #0F1117;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .nw-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }
    .nw-article-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
        padding: 36px 0 72px;
    }
    .nw-article-card {
        border-radius: 16px;
        background: #171B26;
        border: 1px solid rgba(255, 255, 255, 0.1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.25s ease, border-color 0.25s ease;
    }
    .nw-article-card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 255, 255, 0.24);
    }
    .nw-article-img {
        width: 100%;
        height: 210px;
        object-fit: cover;
    }
    @@media (max-width: 991.98px) {
        .nw-article-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 767.98px) {
        .nw-hero { padding: 28px 0 22px; }
        .nw-container { padding: 0 16px; }
        .nw-article-grid { grid-template-columns: 1fr; gap: 16px; padding: 24px 0 48px; }
        .nw-article-img { height: 185px; }
    }
</style>

<section class="nw-hero">
    <div class="nw-container" data-animate="fade-up">
        <span class="d-inline-flex align-items-center gap-1 mb-2" style="font-size:0.8rem;font-weight:600;color:#F59E0B;">
            <i class="bi bi-newspaper"></i> Chuyên mục Góc Điện Ảnh
        </span>
        <h1 class="text-white fw-bolder mb-2" style="font-family:var(--font-display);font-size:clamp(1.85rem,3.2vw,2.65rem);">
            Tin Tức Phim Mới &amp; Kinh Nghiệm Đi Rạp
        </h1>
        <p style="color:#A1A1AA;font-size:1rem;margin-bottom:0;max-width:680px;">
            Tổng hợp bài viết giới thiệu phim chiếu rạp đáng chú ý, kinh nghiệm chọn vị trí ghế ngồi và hướng dẫn đặt vé trực tuyến nhanh chóng.
        </p>
    </div>
</section>

<section class="nw-container">
    <!-- Category Filter Pills -->
    <div class="d-flex flex-wrap gap-2 pt-4">
        <button type="button" class="btn rounded-3 px-3 py-2 fw-semibold text-white js-news-filter active" data-cat="all"
                style="background:#E53935;border:1px solid #E53935;font-size:0.86rem;">
            Tất cả bài viết
        </button>
        <button type="button" class="btn rounded-3 px-3 py-2 fw-medium js-news-filter" data-cat="review"
                style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.14);color:#E4E4E7;font-size:0.86rem;">
            Điểm phim cuối tuần
        </button>
        <button type="button" class="btn rounded-3 px-3 py-2 fw-medium js-news-filter" data-cat="guide"
                style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.14);color:#E4E4E7;font-size:0.86rem;">
            Kinh nghiệm đi rạp
        </button>
        <button type="button" class="btn rounded-3 px-3 py-2 fw-medium js-news-filter" data-cat="tech"
                style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.14);color:#E4E4E7;font-size:0.86rem;">
            Định dạng phòng chiếu
        </button>
    </div>

    <!-- Editorial Cards -->
    <div class="nw-article-grid" id="newsArticleGrid">
        <article class="nw-article-card cinema-spotlight" data-cat="review">
            <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800" alt="Điểm phim cuối tuần" class="nw-article-img" />
            <div class="p-4 d-flex flex-column flex-grow-1">
                <span class="small fw-semibold mb-2" style="color:#F59E0B;">ĐIỂM PHIM CUỐI TUẦN</span>
                <h4 class="text-white fw-bold mb-2" style="font-size:1.15rem;line-height:1.35;">Top Phim Giải Trí Gia Đình &amp; Bom Tấn Đáng Xem Nhất Tháng Này</h4>
                <p style="color:#A1A1AA;font-size:0.92rem;line-height:1.6;" class="mb-4">Từ hành động kịch tính đến hoạt hình vui nhộn dành cho cả gia đình, điểm danh những bộ phim đang được khán giả yêu thích nhất tại rạp.</p>
                <a asp-controller="Movies" asp-action="Index" class="mt-auto fw-semibold text-decoration-none small" style="color:#F8FAFC;">
                    Xem danh sách phim đang chiếu <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </article>

        <article class="nw-article-card cinema-spotlight" data-cat="guide">
            <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=800" alt="Chọn vị trí ghế đẹp" class="nw-article-img" />
            <div class="p-4 d-flex flex-column flex-grow-1">
                <span class="small fw-semibold mb-2" style="color:#F59E0B;">KINH NGHIỆM ĐI RẠP</span>
                <h4 class="text-white fw-bold mb-2" style="font-size:1.15rem;line-height:1.35;">Vì Sao Hàng Ghế Trung Tâm Phòng Chiếu Luôn Được Đặt Sớm?</h4>
                <p style="color:#A1A1AA;font-size:0.92rem;line-height:1.6;" class="mb-4">Tìm hiểu góc nhìn ngang tầm mắt và vị trí giao thoa âm thanh vòm giúp các hàng ghế C, D, E mang lại trải nghiệm xem phim thoải mái nhất.</p>
                <a asp-controller="Showtimes" asp-action="Index" class="mt-auto fw-semibold text-decoration-none small" style="color:#F8FAFC;">
                    Chọn suất chiếu &amp; ghế ngồi <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </article>

        <article class="nw-article-card cinema-spotlight" data-cat="tech">
            <img src="https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?w=800" alt="Đặt vé trực tuyến QR" class="nw-article-img" />
            <div class="p-4 d-flex flex-column flex-grow-1">
                <span class="small fw-semibold mb-2" style="color:#F59E0B;">HƯỚNG DẪN ĐẶT VÉ</span>
                <h4 class="text-white fw-bold mb-2" style="font-size:1.15rem;line-height:1.35;">Hướng Dẫn Đặt Vé Online &amp; Quét Mã QR Vào Rạp Không Cần Xếp Hàng</h4>
                <p style="color:#A1A1AA;font-size:0.92rem;line-height:1.6;" class="mb-4">Chỉ với 4 bước chọn phim, chọn rạp, chọn ghế và thanh toán trực tuyến, mã vé điện tử QR sẽ được lưu ngay trong tài khoản của bạn.</p>
                <a asp-controller="Home" asp-action="Index" class="mt-auto fw-semibold text-decoration-none small" style="color:#F8FAFC;">
                    Đặt vé nhanh ngay <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </article>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var filterBtns = document.querySelectorAll('.js-news-filter');
            var cards = document.querySelectorAll('#newsArticleGrid .nw-article-card');
            filterBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var cat = btn.getAttribute('data-cat');
                    filterBtns.forEach(function (b) {
                        var active = b === btn;
                        b.style.background = active ? '#E53935' : 'rgba(255,255,255,0.05)';
                        b.style.borderColor = active ? '#E53935' : 'rgba(255,255,255,0.14)';
                        b.style.color = active ? '#ffffff' : '#E4E4E7';
                    });
                    cards.forEach(function (c) {
                        c.style.display = (cat === 'all' || c.getAttribute('data-cat') === cat) ? '' : 'none';
                    });
                });
            });
        });
    </script>
}
