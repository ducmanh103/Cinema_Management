<!-- Quick View Showtimes Modal -->
<div class="modal fade" id="quickShowtimesModal" tabindex="-1" aria-labelledby="quickShowtimesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal shadow-lg">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold text-white fs-4" id="modal-theater-name">Lịch chiếu rạp</h5>
                    <p class="text-muted small mb-0 mt-1" id="modal-theater-address">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                        <span></span>
                    </p>
                </div>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                <!-- 7 days strip selection -->
                <div class="modal-date-wrap" id="modal-days-strip">
                    <!-- Loaded dynamically via JavaScript -->
                </div>

                <!-- Search Input inside modal -->
                <div class="modal-search-wrap">
                    <input type="text" id="modal-search-movie" class="modal-search-input" placeholder="Tìm kiếm phim đang chiếu..." />
                    <i class="bi bi-search modal-search-icon"></i>
                </div>

                <!-- Content container -->
                <div id="modal-showtimes-content">
                    <!-- Dynamic showtimes grouped by movie -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Global states
            var modalDays = [];
            var activeDateString = '';
            var theaterShowtimes = [];
            var searchQuery = '';

            // Initialize 7 days range
            function generate7Days() {
                var dates = [];
                var today = new Date();
                
                for (var i = 0; i < 7; i++) {
                    var d = new Date();
                    d.setDate(today.getDate() + i);
                    d.setHours(0, 0, 0, 0);
                    
                    var year = d.getFullYear();
                    var month = String(d.getMonth() + 1).padStart(2, '0');
                    var day = String(d.getDate()).padStart(2, '0');
                    var dateString = year + '-' + month + '-' + day;
                    
                    dates.push({
                        dateString: dateString,
                        dayOfMonth: d.getDate(),
                        dayOfWeekName: getDayOfWeekName(d, i)
                    });
                }
                return dates;
            }

            function getDayOfWeekName(d, offset) {
                if (offset === 0) return "H.Nay";
                var shortDays = ["CN", "Th 2", "Th 3", "Th 4", "Th 5", "Th 6", "Th 7"];
                return shortDays[d.getDay()];
            }

            function initModalDays() {
                modalDays = generate7Days();
                activeDateString = modalDays[0].dateString;
                
                var html = '';
                modalDays.forEach(function(day, index) {
                    var activeClass = index === 0 ? 'active' : '';
                    html += `
                        <button type="button" class="modal-date-btn ${activeClass}" data-date="${day.dateString}">
                            <span class="mdb-w">${day.dayOfWeekName}</span>
                            <span class="mdb-d">${day.dayOfMonth}</span>
                        </button>
                    `;
                });
                $('#modal-days-strip').html(html);
            }

            initModalDays();

            // 1. Region Tab Filter Click Event
            $(document).on('click', '.region-tab', function() {
                $('.region-tab').removeClass('active');
                $(this).addClass('active');
                
                var target = $(this).data('target');
                if (target === 'all') {
                    $('.theater-card-item').fadeIn(250);
                } else {
                    $('.theater-card-item').each(function() {
                        if ($(this).data('region') === target) {
                            $(this).fadeIn(250);
                        } else {
                            $(this).fadeOut(150);
                        }
                    });
                }
            });

            // 2. Modal Date Button Click Event
            $(document).on('click', '.modal-date-btn', function() {
                $('.modal-date-btn').removeClass('active');
                $(this).addClass('active');
                activeDateString = $(this).data('date');
                renderShowtimes();
            });

            // 3. Movie Search Input Handler
            $(document).on('input', '#modal-search-movie', function() {
                searchQuery = $(this).val().trim().toLowerCase();
                renderShowtimes();
            });

            // 4. View Showtimes Button Click Event
            $(document).on('click', '.btn-view-showtimes', function() {
                var theaterId = $(this).data('theater-id');
                var theaterName = $(this).data('theater-name');
                var theaterAddress = $(this).data('theater-address');
                
                // Update headers in modal
                $('#modal-theater-name').text(theaterName);
                $('#modal-theater-address span').text(theaterAddress);
                
                // Clear search input
                $('#modal-search-movie').val('');
                searchQuery = '';
                
                // Reset active date tab to Today (index 0)
                $('.modal-date-btn').removeClass('active');
                $(`.modal-date-btn[data-date="${modalDays[0].dateString}"]`).addClass('active');
                activeDateString = modalDays[0].dateString;
                
                // Render loading spinner
                $('#modal-showtimes-content').html(`
                    <div class="modal-loader">
                        <div class="spinner-border text-danger mb-3" role="status"></div>
                        <p class="text-muted small">Đang tải lịch chiếu sắp tới...</p>
                    </div>
                `);
                
                // Show Bootstrap Modal
                var myModal = new bootstrap.Modal(document.getElementById('quickShowtimesModal'));
                myModal.show();
                
                // Fetch future showtimes from API
                $.ajax({
                    url: `/api/ShowtimesApi/bytheater/${theaterId}`,
                    type: 'GET',
                    dataType: 'json',
                    success: function(data) {
                        theaterShowtimes = data;
                        renderShowtimes();
                    },
                    error: function(xhr, status, error) {
                        console.error("Lỗi khi tải suất chiếu:", error);
                        $('#modal-showtimes-content').html(`
                            <div class="modal-empty">
                                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                                <h5 class="text-secondary mt-2">Không thể tải dữ liệu lịch chiếu</h5>
                                <p class="text-muted small">Vui lòng thử lại sau.</p>
                            </div>
                        `);
                    }
                });
            });

            // Render and filter showtimes inside modal
            function renderShowtimes() {
                if (!theaterShowtimes || theaterShowtimes.length === 0) {
                    renderEmptyState("Rạp hiện chưa cập nhật lịch chiếu sắp tới.");
                    return;
                }
                
                // Filter showtimes matching active date and search query
                var filtered = theaterShowtimes.filter(function(st) {
                    var dObj = new Date(st.startTime);
                    var year = dObj.getFullYear();
                    var month = String(dObj.getMonth() + 1).padStart(2, '0');
                    var day = String(dObj.getDate()).padStart(2, '0');
                    var stDate = year + '-' + month + '-' + day;
                    var dateMatch = (stDate === activeDateString);
                    
                    var titleMatch = true;
                    if (searchQuery) {
                        titleMatch = st.movieTitle.toLowerCase().indexOf(searchQuery) !== -1;
                    }
                    
                    return dateMatch && titleMatch;
                });
                
                if (filtered.length === 0) {
                    renderEmptyState("Không có suất chiếu nào phù hợp.");
                    return;
                }
                
                // Group showtimes by movieId
                var groups = {};
                filtered.forEach(function(st) {
                    if (!groups[st.movieId]) {
                        groups[st.movieId] = {
                            movieId: st.movieId,
                            title: st.movieTitle,
                            posterUrl: st.moviePosterUrl || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?q=80&w=200&auto=format&fit=crop',
                            showtimes: []
                        };
                    }
                    groups[st.movieId].showtimes.push(st);
                });
                
                // Generate HTML output
                var html = '';
                Object.keys(groups).forEach(function(key) {
                    var movie = groups[key];
                    
                    // Sort showtimes by starting time
                    movie.showtimes.sort(function(a, b) {
                        return new Date(a.startTime) - new Date(b.startTime);
                    });
                    
                    var showtimesHtml = '';
                    movie.showtimes.forEach(function(st) {
                        var dObj = new Date(st.startTime);
                        var hours = String(dObj.getHours()).padStart(2, '0');
                        var minutes = String(dObj.getMinutes()).padStart(2, '0');
                        var timeString = hours + ':' + minutes;
                        if (st.availableSeats > 0) {
                            showtimesHtml += `
                                <a href="/Booking/SelectSeat/${st.showtimeId}" class="m-st-pill" title="Còn ${st.availableSeats} ghế trống">
                                    <span class="m-st-time">${timeString}</span>
                                    <span class="m-st-room">${st.roomName}</span>
                                    <span class="m-st-price">${st.price.toLocaleString('vi-VN')}₫</span>
                                </a>
                            `;
                        } else {
                            showtimesHtml += `
                                <div class="m-st-pill disabled" title="Đã hết vé">
                                    <span class="m-st-time">${timeString}</span>
                                    <span class="m-st-room">Hết ghế</span>
                                </div>
                            `;
                        }
                    });
                    
                    html += `
                        <div class="modal-movie-card">
                            <div class="mmc-poster-wrap">
                                <img src="${escapeHtml(movie.posterUrl)}" class="mmc-poster" alt="${escapeHtml(movie.title)}" onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?q=80&w=200&auto=format&fit=crop'" />
                            </div>
                            <div class="mmc-info">
                                <h6 class="mmc-title fw-bold text-white mb-2">${escapeHtml(movie.title)}</h6>
                                <div class="mmc-meta">
                                    <span><i class="bi bi-clock"></i> 120 phút</span>
                                    <span><i class="bi bi-tags"></i> 2D Phụ Đề</span>
                                </div>
                                <div class="mmc-showtimes">
                                    ${showtimesHtml}
                                </div>
                            </div>
                        </div>
                    `;
                });
                
                $('#modal-showtimes-content').html(html);
            }

            // Hàm escape HTML để chống XSS
            function escapeHtml(str) {
                if (!str) return '';
                var div = document.createElement('div');
                div.appendChild(document.createTextNode(str));
                return div.innerHTML;
            }

            function renderEmptyState(message) {
                $('#modal-showtimes-content').html(`
                    <div class="modal-empty">
                        <i class="bi bi-calendar-x text-muted" style="font-size:3rem;"></i>
                        <h5 class="text-secondary mt-3">Không có suất chiếu nào</h5>
                        <p class="text-muted small">${message}</p>
                    </div>
                `);
            }
        });
    </script>
}
