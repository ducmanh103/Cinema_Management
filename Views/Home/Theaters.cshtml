    </h1>
    <p class="hero-sub">
        Mạng lưới @totalTheaters rạp chiếu hiện đại — từ màn ảnh rộng IMAX® đến trải nghiệm chân thực 4DX® — sẵn sàng phục vụ bạn mọi lúc.
    </p>

    <!-- Glowing stats bar -->
    <div class="stats-bar">
        <div class="stat-card">
            <div class="stat-value">@totalTheaters</div>
            <div class="stat-label">Rạp Chiếu</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@totalSeats.ToString("N0")</div>
            <div class="stat-label">Tổng Số Ghế</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@totalMovies</div>
            <div class="stat-label">Phim Đang Chiếu</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@totalShowtimesToday</div>
            <div class="stat-label">Suất Chiếu Hôm Nay</div>
        </div>
    </div>
</div>

<!-- Region tab filtering -->
<div class="region-filter-wrap">
    <div class="region-tabs">
        <button type="button" class="region-tab active" data-target="all">
            🌐 Tất cả hệ thống
        </button>
        <button type="button" class="region-tab" data-target="hanoi">
            🏛️ Hà Nội
        </button>
        <button type="button" class="region-tab" data-target="tphcm">
            🏢 TP. Hồ Chí Minh
        </button>
        <button type="button" class="region-tab" data-target="mientrung">
            🌊 Miền Trung
        </button>
        <button type="button" class="region-tab" data-target="miennam">
            🌴 Miền Nam
        </button>
    </div>
</div>

<!-- Theaters list -->
<div class="row g-4 mb-5" id="theaters-grid-container">
    @{ int i = 0; }
    @foreach (var t in Model)
    {
        var img        = theaterImages[i % theaterImages.Length];
        var tech       = techBadges[i % techBadges.Length];
        var techColor  = techColors[i % techColors.Length];
        var icons      = amenitySets[i % amenitySets.Length];
        var labels     = amenityLabels[i % amenityLabels.Length];
        bool hasNext   = t.NextShowtime != null;
        i++;

        string addr = t.Address ?? "";
        string region = "all";
        if (addr.Contains("Hà Nội") || addr.Contains("Hà Đông")) {
            region = "hanoi";
        } else if (addr.Contains("TP.HCM") || addr.Contains("Hồ Chí Minh") || addr.Contains("Nguyễn Huệ")) {
            region = "tphcm";
        } else if (addr.Contains("Đà Nẵng") || addr.Contains("Huế")) {
            region = "mientrung";
        } else if (addr.Contains("Cần Thơ")) {
            region = "miennam";
        }

        <div class="col-md-6 col-xl-4 theater-card-item" data-region="@region">
            <div class="tc">
                <!-- Top image wrapper -->
                <div class="tc-img-wrap">
                    <img src="@img" class="tc-img" alt="@t.TheaterName" loading="lazy" />
                    <div class="tc-img-overlay"></div>

                    <!-- Floating tech tag -->
                    <div class="tc-tech" style="background: rgba(0,0,0,.55); border-color:@(techColor)40; color:@techColor;">
                        @tech
                    </div>

                    @if (hasNext)
                    {
                        <div class="tc-open">
                            <span class="dot"></span> Đang mở cửa
                        </div>
                    }

                    @if (t.ShowtimesToday > 0)
                    {
                        <div class="tc-today-chip">
                            <i class="bi bi-play-circle me-1"></i>@t.ShowtimesToday suất hôm nay
                        </div>
                    }
                </div>

                <!-- Card Body -->
                <div class="tc-body">
                    <div class="tc-name">@t.TheaterName</div>

                    <div class="tc-address">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>@(t.Address ?? "Địa chỉ đang cập nhật")</span>
                    </div>

                    <!-- Specs Chips -->
                    <div class="tc-chips">
                        <span class="chip red">
                            <i class="bi bi-camera-reels-fill"></i>
                            @t.RoomCount phòng chiếu
                        </span>
                        <span class="chip blue">
                            <i class="bi bi-person-fill"></i>
                            @t.SeatCount.ToString("N0") ghế
                        </span>
                        @if (t.MoviesNow > 0)
                        {
                            <span class="chip gold">
                                <i class="bi bi-film"></i>
                                @t.MoviesNow phim
                            </span>
                        }
                        @if (hasNext)
                        {
                            <span class="chip green" title="Suất chiếu tiếp theo">
                                <i class="bi bi-clock-fill"></i>
                                @(((DateTime)t.NextShowtime).ToString("HH:mm"))
                            </span>
                        }
                    </div>

                    <div class="tc-div"></div>

                    <!-- Amenities list -->
                    <div class="tc-amenities">
                        @for (int k = 0; k < icons.Length; k++)
                        {
                            <div class="tc-amenity">
                                <i class="bi @icons[k]"></i>
                                @labels[k]
                            </div>
                        }
                    </div>
                </div>

                <!-- Footer buttons -->
                <div class="tc-footer">
                    <button type="button" class="btn-view-showtimes btn-theater-primary w-100" 
                            data-theater-id="@t.TheaterId" 
                            data-theater-name="@t.TheaterName" 
                            data-theater-address="@t.Address">
                        <i class="bi bi-ticket-perforated-fill"></i> Xem Lịch Chiếu
                    </button>
                    <a href="https://maps.google.com/?q=@Uri.EscapeDataString(t.Address ?? t.TheaterName)"
                       target="_blank" class="btn-theater-secondary">
                        <i class="bi bi-map-fill"></i> Bản đồ
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Why Choose Us -->
