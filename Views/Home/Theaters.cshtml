@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Hệ Thống Cụm Rạp Chuẩn Quốc Tế";
    ViewBag.FullWidth = true;

    var theaters = Model?.ToList() ?? new List<dynamic>();
    int totalTheaters = ViewBag.TotalTheaters ?? theaters.Count;
    int totalSeats = ViewBag.TotalSeats ?? 0;
    int totalMovies = ViewBag.TotalMovies ?? 0;
    int totalShowtimesToday = ViewBag.TotalShowtimesToday ?? 0;
}

<style>
    .th-hero {
        padding: 56px 0 44px;
        background:
            radial-gradient(circle at 80% 20%, rgba(56, 189, 248, 0.16), transparent 48%),
            radial-gradient(circle at 20% 80%, rgba(255, 46, 85, 0.15), transparent 50%),
            #050711;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .th-container {
        max-width: 1380px;
        margin: 0 auto;
        padding: 0 24px;
    }
    .th-kpi-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-top: 32px;
    }
    .th-kpi-box {
        padding: 20px;
        border-radius: 20px;
        background: rgba(15, 22, 41, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.09);
    }
    .th-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
        padding: 44px 0 76px;
    }
    .th-card {
        padding: 28px;
        border-radius: 26px;
        background: rgba(15, 22, 41, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.09);
        display: flex;
        flex-direction: column;
        gap: 16px;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .th-card:hover {
        transform: translateY(-6px);
        border-color: rgba(56, 189, 248, 0.45);
    }
    .th-metrics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        padding: 14px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        text-align: center;
    }
    @@media (max-width: 991.98px) {
        .th-kpi-strip { grid-template-columns: repeat(2, 1fr); }
        .th-grid { grid-template-columns: 1fr; }
    }
    @@media (max-width: 575.98px) {
        .th-hero { padding: 32px 0 24px; }
        .th-container { padding: 0 14px; }
        .th-kpi-strip { gap: 10px; margin-top: 18px; }
        .th-kpi-box { padding: 14px 12px; border-radius: 16px; }
        .th-grid { padding: 24px 0 56px; gap: 14px; }
        .th-card { padding: 18px 14px; border-radius: 20px; }
        .th-metrics { grid-template-columns: repeat(2, 1fr); gap: 8px; padding: 10px; }
    }
</style>

<section class="th-hero">
    <div class="th-container">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3" data-animate="fade-up">
            <div>
                <span class="ch-eyebrow mb-2"><i class="bi bi-buildings-fill"></i> Flagship Cinema Network</span>
                <h1 class="text-white fw-bolder mb-1" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,3.6vw,3rem);">
                    Hệ Thống Cụm Rạp CinemaHub
                </h1>
                <p class="text-white-50 mb-0">Trải nghiệm chuẩn rạp IMAX Laser 4K, phòng chiếu Dolby Atmos 360° và ghế ngả lưng VIP trên toàn quốc.</p>
            </div>
            <div style="min-width:260px;">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 translate-middle-y text-white-50" style="left:14px;"></i>
                    <input type="text" id="theaterSearchInput" class="form-control rounded-pill ps-5 py-2 text-white"
                           style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);"
                           placeholder="Tìm tên rạp hoặc địa chỉ..." />
                </div>
            </div>
        </div>

        <div class="th-kpi-strip" data-animate="fade-up" data-delay="80">
            <div class="th-kpi-box">
                <div class="text-white-50 small">Cụm Rạp Flagship</div>
                <div class="text-white fw-bolder fs-3" data-count-to="@totalTheaters">@totalTheaters</div>
            </div>
            <div class="th-kpi-box">
                <div class="text-white-50 small">Tổng Ghế Công Thái Học</div>
                <div class="text-info fw-bolder fs-3" data-count-to="@totalSeats">@totalSeats</div>
            </div>
            <div class="th-kpi-box">
                <div class="text-white-50 small">Phim Đang Phục Vụ</div>
                <div class="text-warning fw-bolder fs-3" data-count-to="@totalMovies">@totalMovies</div>
            </div>
            <div class="th-kpi-box">
                <div class="text-white-50 small">Suất Chiếu Hôm Nay</div>
                <div class="text-danger fw-bolder fs-3" data-count-to="@totalShowtimesToday">@totalShowtimesToday</div>
            </div>
        </div>
    </div>
</section>

<section class="th-container">
    <div class="th-grid" id="theaterCardsGrid">
        @foreach (var th in theaters)
        {
            <article class="th-card cinema-spotlight"
                     data-name="@(((string)th.TheaterName).ToLowerInvariant()) @(((string)th.Address).ToLowerInvariant())"
                     data-animate="fade-up">
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <span class="badge rounded-pill px-3 py-1 mb-2" style="background:rgba(56,189,248,0.15);color:#38BDF8;border:1px solid rgba(56,189,248,0.35);">
                            <i class="bi bi-badge-4k-fill me-1"></i>IMAX Laser • Dolby Atmos
                        </span>
                        <h3 class="text-white fw-bold mb-1" style="font-family:'Space Grotesk',sans-serif;">@th.TheaterName</h3>
                        <p class="text-white-50 small mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@th.Address</p>
                    </div>
                    <span class="badge rounded-3 px-2 py-1 text-warning" style="background:rgba(245,185,66,0.14);border:1px solid rgba(245,185,66,0.3);">
                        <i class="bi bi-star-fill me-1"></i>4.9
                    </span>
                </div>

                <div class="th-metrics">
                    <div>
                        <div class="text-white fw-bold fs-5">@th.RoomCount</div>
                        <div class="text-white-50" style="font-size:0.72rem;">Phòng chiếu</div>
                    </div>
                    <div>
                        <div class="text-info fw-bold fs-5">@th.SeatCount</div>
                        <div class="text-white-50" style="font-size:0.72rem;">Ghế ngồi</div>
                    </div>
                    <div>
                        <div class="text-warning fw-bold fs-5">@th.MoviesNow</div>
                        <div class="text-white-50" style="font-size:0.72rem;">Phim chiếu</div>
                    </div>
                    <div>
                        <div class="text-success fw-bold fs-5">@th.ShowtimesToday</div>
                        <div class="text-white-50" style="font-size:0.72rem;">Suất hôm nay</div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-auto pt-2">
                    <a asp-controller="Showtimes" asp-action="Index" asp-route-theaterId="@th.TheaterId"
                       class="btn flex-grow-1 rounded-4 py-2 fw-bold text-white"
                       style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                        <i class="bi bi-ticket-perforated-fill me-1"></i> Xem Suất &amp; Đặt Vé
                    </a>
                    <button type="button"
                            class="btn rounded-4 px-3 py-2 fw-semibold text-white js-quick-theater-schedule"
                            style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);"
                            data-theater-id="@th.TheaterId"
                            data-theater-name="@th.TheaterName">
                        <i class="bi bi-clock-history me-1 text-info"></i> Lịch Nhanh
                    </button>
                </div>
            </article>
        }
    </div>
</section>

<!-- Quick Theater Showtimes Modal -->
<div class="modal fade" id="theaterScheduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background:#0a0f1f;border:1px solid rgba(255,255,255,0.15);border-radius:24px;">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title text-white fw-bold" id="theaterModalTitle">Lịch Chiếu Tại Rạp</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="theaterModalBody">
                <div class="text-center py-4 text-white-50">Đang tải lịch chiếu...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('theaterSearchInput');
            var cards = document.querySelectorAll('#theaterCardsGrid .th-card');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    var q = searchInput.value.trim().toLowerCase();
                    cards.forEach(function (c) {
                        var name = c.getAttribute('data-name') || '';
                        c.style.display = (!q || name.indexOf(q) !== -1) ? '' : 'none';
                    });
                });
            }

            var modalEl = document.getElementById('theaterScheduleModal');
            var modalTitle = document.getElementById('theaterModalTitle');
            var modalBody = document.getElementById('theaterModalBody');
            var bsModal = null;

            document.querySelectorAll('.js-quick-theater-schedule').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var id = btn.getAttribute('data-theater-id');
                    var name = btn.getAttribute('data-theater-name');
                    if (modalTitle) modalTitle.textContent = 'Suất chiếu sắp tới: ' + name;
                    if (modalBody) modalBody.innerHTML = '<div class="text-center py-4 text-white-50"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải...</div>';
                    if (!bsModal && window.bootstrap) bsModal = new bootstrap.Modal(modalEl);
                    if (bsModal) bsModal.show();

                    try {
                        var res = await fetch('/api/ShowtimesApi/bytheater/' + id);
                        var list = await res.json();
                        if (!Array.isArray(list) || list.length === 0) {
                            modalBody.innerHTML = '<div class="text-center py-4 text-white-50">Hiện chưa có suất chiếu sắp tới tại cụm rạp này.</div>';
                            return;
                        }
                        modalBody.innerHTML = '<div class="d-flex flex-column gap-2">' + list.slice(0, 12).map(function (s) {
                            var dt = new Date(s.startTime);
                            var timeStr = dt.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + ' • ' + dt.toLocaleDateString('vi-VN');
                            return '<a href="/Booking/SelectSeat?showtimeId=' + s.showtimeId + '" class="d-flex align-items-center justify-content-between p-3 rounded-4 text-decoration-none" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);">' +
                                '<div><div class="text-white fw-bold">' + s.movieTitle + '</div><div class="text-white-50 small">' + s.roomName + '</div></div>' +
                                '<div class="text-end"><div class="text-info fw-bold font-monospace">' + timeStr + '</div><div class="text-warning small fw-bold">' + Number(s.price).toLocaleString('vi-VN') + ' ₫</div></div>' +
                                '</a>';
                        }).join('') + '</div>';
                    } catch (e) {
                        modalBody.innerHTML = '<div class="text-center py-4 text-danger">Không thể tải dữ liệu suất chiếu.</div>';
                    }
                });
            });
        });
    </script>
}
