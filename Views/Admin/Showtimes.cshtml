@using CinemaManagement.Models
@model List<Showtime>
@{
    ViewData["Title"] = "Quản lý suất chiếu";
    Layout = "_AdminLayout";
    bool isAdmin = User.IsInRole("Admin");
    var movies = ViewBag.Movies as List<Movie> ?? new();
    var rooms = ViewBag.Rooms as List<Room> ?? new();
}

<!-- Content Header -->
<section class="content-header">
    <h1>
        Suất chiếu
        <small>Danh sách lịch chiếu phim</small>
    </h1>
    <ol class="breadcrumb">
        <li><a asp-action="Index"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Suất chiếu</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-calendar"></i> Danh sách suất chiếu (@Model.Count)</h3>
                    <div class="box-tools pull-right">
                        <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body">
                    <div class="margin-bottom">
                        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#createShowtimeModal">
                            <i class="fa fa-plus"></i> Thêm suất chiếu mới
                        </button>
                    </div>
                    <table id="showtimes-table" class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Phim</th>
                                <th>Rạp</th>
                                <th>Phòng chiếu</th>
                                <th>Giờ chiếu</th>
                                <th>Giá vé</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var showtime in Model)
                            {
                                <tr>
                                    <td>@showtime.ShowtimeId</td>
                                    <td><strong>@showtime.Movie?.Title</strong></td>
                                    <td>@showtime.Room?.Theater?.TheaterName</td>
                                    <td>@showtime.Room?.RoomName</td>
                                    <td>@showtime.StartTime.ToString("HH:mm dd/MM/yyyy")</td>
                                    <td>@showtime.Price.ToString("N0") ₫</td>
                                    <td>
                                        @if (showtime.StartTime > DateTime.Now)
                                        {
                                            <span class="label label-success">Sắp chiếu</span>
                                        }
                                        else if (showtime.StartTime <= DateTime.Now && showtime.StartTime.AddMinutes(showtime.Movie?.Duration ?? 120) > DateTime.Now)
                                        {
                                            <span class="label label-warning">Đang chiếu</span>
                                        }
                                        else
                                        {
                                            <span class="label label-default">Đã chiếu</span>
                                        }
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-xs btn-info btn-edit-showtime"
                                                data-id="@showtime.ShowtimeId"
                                                data-movie="@showtime.MovieId"
                                                data-room="@showtime.RoomId"
                                                data-time="@showtime.StartTime.ToString("yyyy-MM-ddTHH:mm")"
                                                data-price="@showtime.Price">
                                            <i class="fa fa-edit"></i> Sửa
                                        </button>
                                        @if (isAdmin)
                                        {
                                            <form asp-action="DeleteShowtime" asp-route-id="@showtime.ShowtimeId" method="post" class="inline-form" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-xs btn-danger"
                                                        onclick="return confirm('Xoá suất chiếu #@showtime.ShowtimeId (@showtime.Movie?.Title)?\nThao tác không thể hoàn tác!')">
                                                    <i class="fa fa-trash"></i> Xoá
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== MODAL: Thêm suất chiếu ===================== -->
<div class="modal fade" id="createShowtimeModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="CreateShowtime" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="background:#3c8dbc; color:#fff">
                    <button type="button" class="close" data-dismiss="modal" style="color:#fff"><span>&times;</span></button>
                    <h4 class="modal-title"><i class="fa fa-plus-circle"></i> Thêm suất chiếu mới</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Phim <span class="text-danger">*</span></label>
                        <select name="movieId" class="form-control" required>
                            <option value="">-- Chọn phim --</option>
                            @foreach (var m in movies)
                            {
                                <option value="@m.MovieId">@m.Title (@m.Duration phút)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Phòng chiếu <span class="text-danger">*</span></label>
                        <select name="roomId" class="form-control" required>
                            <option value="">-- Chọn phòng --</option>
                            @foreach (var r in rooms)
                            {
                                <option value="@r.RoomId">@r.Theater?.TheaterName – @r.RoomName (@r.SeatCount ghế)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Giờ chiếu <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="startTime" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>Giá vé (₫) <span class="text-danger">*</span></label>
                        <input type="number" name="price" class="form-control" min="0" step="1000" placeholder="Ví dụ: 85000" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Huỷ</button>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Lưu suất chiếu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===================== MODAL: Sửa suất chiếu ===================== -->
<div class="modal fade" id="editShowtimeModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="EditShowtime" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="showtimeId" id="edit-showtime-id" />
                <div class="modal-header" style="background:#00a65a; color:#fff">
                    <button type="button" class="close" data-dismiss="modal" style="color:#fff"><span>&times;</span></button>
                    <h4 class="modal-title"><i class="fa fa-edit"></i> Sửa suất chiếu <span id="edit-showtime-label"></span></h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Phim <span class="text-danger">*</span></label>
                        <select name="movieId" id="edit-movie-id" class="form-control" required>
                            <option value="">-- Chọn phim --</option>
                            @foreach (var m in movies)
                            {
                                <option value="@m.MovieId">@m.Title (@m.Duration phút)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Phòng chiếu <span class="text-danger">*</span></label>
                        <select name="roomId" id="edit-room-id" class="form-control" required>
                            <option value="">-- Chọn phòng --</option>
                            @foreach (var r in rooms)
                            {
                                <option value="@r.RoomId">@r.Theater?.TheaterName – @r.RoomName (@r.SeatCount ghế)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Giờ chiếu <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="startTime" id="edit-start-time" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>Giá vé (₫) <span class="text-danger">*</span></label>
                        <input type="number" name="price" id="edit-price" class="form-control" min="0" step="1000" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Huỷ</button>
                    <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // DataTable
            $('#showtimes-table').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.21/i18n/Vietnamese.json"
                },
                "order": [[4, "desc"]],
                "pageLength": 25,
                "responsive": true,
                "columnDefs": [
                    { "orderable": false, "targets": [7] }
                ]
            });

            // Mở modal Sửa và điền dữ liệu
            $(document).on('click', '.btn-edit-showtime', function () {
                var id = $(this).data('id');
                var movieId = $(this).data('movie');
                var roomId = $(this).data('room');
                var time = $(this).data('time');
                var price = $(this).data('price');

                $('#edit-showtime-id').val(id);
                $('#edit-showtime-label').text('#' + id);
                $('#edit-movie-id').val(movieId);
                $('#edit-room-id').val(roomId);
                $('#edit-start-time').val(time);
                $('#edit-price').val(price);

                $('#editShowtimeModal').modal('show');
            });
        });
    </script>
}
