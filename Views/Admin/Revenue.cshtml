@using CinemaManagement.Models.ViewModels
@{
    ViewData["Title"] = "Thống kê doanh thu";
    Layout = "_AdminLayout";
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Now.Year;
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    decimal yearRevenue = ViewBag.YearRevenue ?? 0m;
    int yearTickets = ViewBag.YearTickets ?? 0;
    int totalPaidTickets = ViewBag.TotalPaidTickets ?? 0;

    var topMovies = ViewBag.TopMovies as List<MovieRevenueDto> ?? new();
    var paymentMethods = ViewBag.PaymentMethods as IEnumerable<dynamic> ?? new List<dynamic>();
    var availableYears = ViewBag.AvailableYears as List<int> ?? new List<int> { DateTime.Now.Year };

    string[] chartLabels = ViewBag.ChartLabels as string[] ?? new string[12];
    decimal[] chartRevenue = ViewBag.ChartRevenue as decimal[] ?? new decimal[12];
    int[] chartTickets = ViewBag.ChartTickets as int[] ?? new int[12];
}

<!-- Content Header -->
<section class="content-header">
    <h1>
        Thống kê doanh thu
        <small>Báo cáo tài chính hệ thống</small>
    </h1>
    <ol class="breadcrumb">
        <li><a asp-action="Index"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Doanh thu</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">

    <!-- Bộ lọc năm -->
    <div class="row">
        <div class="col-md-12">
            <div class="box box-default box-solid">
                <div class="box-body" style="padding:12px 15px">
                    <form method="get" class="form-inline">
                        <label class="control-label" style="margin-right:10px"><i class="fa fa-calendar"></i> Xem năm:</label>
                        <select name="year" class="form-control" onchange="this.form.submit()">
                            @foreach (var y in availableYears)
                            {
                                if (y == selectedYear)
                                {
                                    <option value="@y" selected>@y</option>
                                }
                                else
                                {
                                    <option value="@y">@y</option>
                                }
                            }
                        </select>
                        &nbsp;
                        <a asp-action="Revenue" class="btn btn-default btn-sm"><i class="fa fa-refresh"></i> Năm hiện tại</a>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat boxes -->
    <div class="row">
        <div class="col-lg-3 col-xs-6">
            <div class="small-box bg-green">
                <div class="inner">
                    <h3 style="font-size:22px">@totalRevenue.ToString("N0") ₫</h3>
                    <p>Tổng doanh thu (tất cả)</p>
                </div>
                <div class="icon"><i class="fa fa-money"></i></div>
            </div>
        </div>
        <div class="col-lg-3 col-xs-6">
            <div class="small-box bg-aqua">
                <div class="inner">
                    <h3 style="font-size:22px">@yearRevenue.ToString("N0") ₫</h3>
                    <p>Doanh thu năm @selectedYear</p>
                </div>
                <div class="icon"><i class="fa fa-bar-chart"></i></div>
            </div>
        </div>
        <div class="col-lg-3 col-xs-6">
            <div class="small-box bg-yellow">
                <div class="inner">
                    <h3>@yearTickets.ToString("N0")</h3>
                    <p>Vé bán năm @selectedYear</p>
                </div>
                <div class="icon"><i class="fa fa-ticket"></i></div>
            </div>
        </div>
        <div class="col-lg-3 col-xs-6">
            <div class="small-box bg-red">
                <div class="inner">
                    <h3>@totalPaidTickets.ToString("N0")</h3>
                    <p>Tổng giao dịch thành công</p>
                </div>
                <div class="icon"><i class="fa fa-check-circle"></i></div>
            </div>
        </div>
    </div>

    <!-- Chart -->
    <div class="row">
        <div class="col-md-8">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-line-chart"></i> Doanh thu theo tháng – @selectedYear</h3>
                    <div class="box-tools pull-right">
                        <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body">
                    <canvas id="revenueChart" height="120"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="box box-warning">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-pie-chart"></i> Phương thức thanh toán</h3>
                    <div class="box-tools pull-right">
                        <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body">
                    <canvas id="methodChart" height="200"></canvas>
                    <div class="margin-top" id="method-legend" style="margin-top:15px"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vé bán theo tháng -->
    <div class="row">
        <div class="col-md-12">
            <div class="box box-success">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-ticket"></i> Số vé bán theo tháng – @selectedYear</h3>
                    <div class="box-tools pull-right">
                        <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body">
                    <canvas id="ticketsChart" height="70"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Top phim doanh thu -->
    <div class="row">
        <div class="col-md-12">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-trophy"></i> Top phim doanh thu cao nhất</h3>
                    <div class="box-tools pull-right">
                        <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body" style="padding:0">
                    @if (topMovies.Any())
                    {
                        <table class="table table-striped table-hover" style="margin-bottom:0">
                            <thead>
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th style="width:55px">Poster</th>
                                    <th>Tên phim</th>
                                    <th>Số vé</th>
                                    <th>Doanh thu</th>
                                    <th>% Tổng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rank = 1; }
                                @foreach (var m in topMovies)
                                {
                                    var pct = totalRevenue > 0 ? (m.TotalRevenue / totalRevenue * 100) : 0;
                                    string rankBadge = rank == 1 ? "bg-yellow" : rank == 2 ? "bg-gray" : rank == 3 ? "bg-red" : "bg-aqua";
                                    <tr>
                                        <td><span class="badge @rankBadge">@rank</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(m.PosterUrl))
                                            {
                                                <img src="@m.PosterUrl" style="width:36px;height:52px;object-fit:cover;border-radius:3px"
                                                     onerror="this.src='/images/default-movie.jpg'" />
                                            }
                                            else
                                            {
                                                <div style="width:36px;height:52px;background:#ddd;border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:9px;color:#999">N/A</div>
                                            }
                                        </td>
                                        <td style="vertical-align:middle"><strong>@m.MovieTitle</strong></td>
                                        <td style="vertical-align:middle">@m.TicketCount.ToString("N0")</td>
                                        <td style="vertical-align:middle"><strong>@m.TotalRevenue.ToString("N0") ₫</strong></td>
                                        <td style="vertical-align:middle">
                                            <div class="progress progress-xs" style="margin:0">
                                                <div class="progress-bar progress-bar-aqua" style="width:@pct.ToString("F0")%"></div>
                                            </div>
                                            <small>@pct.ToString("F1")%</small>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center" style="padding:40px">
                            <i class="fa fa-database fa-3x text-muted"></i>
                            <p class="text-muted" style="margin-top:10px">Chưa có dữ liệu doanh thu.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Chi tiết thanh toán theo phương thức -->
    <div class="row">
        <div class="col-md-12">
            <div class="box box-warning">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-credit-card"></i> Thống kê theo phương thức thanh toán (tất cả)</h3>
                </div>
                <div class="box-body">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Phương thức</th>
                                <th>Số giao dịch</th>
                                <th>Tổng thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pm in paymentMethods)
                            {
                                <tr>
                                    <td>
                                        @if (pm.Method == "Cash")
                                        {
                                            <span><i class="fa fa-money text-green"></i> Tiền mặt</span>
                                        }
                                        else if (pm.Method == "Card")
                                        {
                                            <span><i class="fa fa-credit-card text-blue"></i> Thẻ ngân hàng</span>
                                        }
                                        else if (pm.Method == "Momo")
                                        {
                                            <span><i class="fa fa-mobile text-red"></i> MoMo</span>
                                        }
                                        else
                                        {
                                            <span>@pm.Method</span>
                                        }
                                    </td>
                                    <td>@pm.Count.ToString("N0")</td>
                                    <td><strong>@pm.Total.ToString("N0") ₫</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // ── Dữ liệu từ server ──
        var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartLabels));
        var revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartRevenue));
        var ticketsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartTickets));

        // ── Chart cột: Doanh thu theo tháng ──
        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (₫)',
                    data: revenueData,
                    backgroundColor: 'rgba(60,141,188,0.7)',
                    borderColor: '#3c8dbc',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ctx.parsed.y.toLocaleString('vi-VN') + ' ₫';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        ticks: {
                            callback: function(val) {
                                if (val >= 1000000) return (val / 1000000).toFixed(1) + 'M';
                                if (val >= 1000) return (val / 1000).toFixed(0) + 'K';
                                return val;
                            }
                        }
                    }
                }
            }
        });

        // ── Chart đường: Số vé bán theo tháng ──
        new Chart(document.getElementById('ticketsChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Số vé bán',
                    data: ticketsData,
                    fill: true,
                    backgroundColor: 'rgba(0,166,90,0.15)',
                    borderColor: '#00a65a',
                    tension: 0.4,
                    pointBackgroundColor: '#00a65a'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // ── Pie: Phương thức thanh toán ──
        @{
            var pmList = ViewBag.PaymentMethods as System.Collections.IEnumerable;
            var pmLabels = new System.Collections.Generic.List<string>();
            var pmTotals = new System.Collections.Generic.List<decimal>();
            if (pmList != null)
            {
                foreach (var pm in pmList)
                {
                    var t = pm.GetType();
                    pmLabels.Add(t.GetProperty("Method")?.GetValue(pm)?.ToString() ?? "");
                    pmTotals.Add((decimal)(t.GetProperty("Total")?.GetValue(pm) ?? 0m));
                }
            }
        }
        var pmLabelsJs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pmLabels));
        var pmDataJs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pmTotals));

        if (pmDataJs.length > 0) {
            new Chart(document.getElementById('methodChart'), {
                type: 'doughnut',
                data: {
                    labels: pmLabelsJs,
                    datasets: [{
                        data: pmDataJs,
                        backgroundColor: ['#3c8dbc', '#00a65a', '#f39c12', '#dd4b39', '#605ca8']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    return ctx.label + ': ' + ctx.parsed.toLocaleString('vi-VN') + ' ₫';
                                }
                            }
                        }
                    }
                }
            });
        } else {
            document.getElementById('methodChart').parentElement.innerHTML =
                '<div class="text-center text-muted" style="padding:40px"><i class="fa fa-pie-chart fa-3x"></i><p style="margin-top:10px">Chưa có dữ liệu</p></div>';
        }
    </script>
}
