@model CinemaManagement.Models.Movie
@using CinemaManagement.Helpers
@{
    ViewData["Title"] = Model.Title;
    ViewBag.FullWidth = true;

    bool isAdmin = (User.IsInRole("Admin") || User.IsInRole("Staff")) &&
                   (Context.Request.Headers["Referer"].ToString().Contains("/Admin") || Context.Request.Query["admin"] == "true");

    var genres = ViewBag.Genres as IEnumerable<string> ?? Enumerable.Empty<string>();
    var ageClass = MovieDisplayHelper.GetAgeBadgeClass(Model.Title);
    var ageText = MovieDisplayHelper.GetAgeBadgeText(Model.Title);
    var ageDesc = MovieDisplayHelper.GetAgeBadgeDesc(Model.Title);
    var format = MovieDisplayHelper.GetMovieFormat(Model.Title);
    var rating = MovieDisplayHelper.GetMovieRating(Model.MovieId).ToString("0.0");
    var trailerUrl = MovieDisplayHelper.GetTrailerEmbedUrl(Model.Title);
    var poster = string.IsNullOrWhiteSpace(Model.PosterUrl)
        ? "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800"
        : Model.PosterUrl;
}

<style>
    .md-stage {
        position: relative;
        padding: 56px 0 80px;
        overflow: hidden;
        background: #050711;
    }
    .md-backdrop {
        position: absolute;
        inset: -8%;
        background-image: url('@poster');
        background-size: cover;
        background-position: center 25%;
        filter: blur(36px) saturate(1.4) brightness(0.28);
        z-index: 0;
    }
    .md-vignette {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 75% 25%, rgba(255, 46, 85, 0.2), transparent 50%),
            linear-gradient(180deg, rgba(5, 7, 17, 0.45) 0%, #050711 92%);
        z-index: 1;
    }
    .md-container {
        position: relative;
        z-index: 2;
        max-width: 1340px;
        margin: 0 auto;
        padding: 0 24px;
    }
    .md-grid {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 48px;
        align-items: start;
    }
    .md-poster-frame {
        border-radius: 26px;
        padding: 10px;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.03));
        border: 1px solid rgba(255, 255, 255, 0.16);
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.75);
    }
    .md-poster-frame img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 18px;
        display: block;
    }
    .md-spec-bento {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin: 28px 0;
    }
    .md-spec-card {
        padding: 16px;
        border-radius: 18px;
        background: rgba(15, 22, 41, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(14px);
    }
    @@media (max-width: 991.98px) {
        .md-grid { grid-template-columns: 1fr; gap: 32px; }
        .md-poster-frame { max-width: 300px; margin: 0 auto; }
        .md-spec-bento { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<section class="md-stage">
    <div class="md-backdrop"></div>
    <div class="md-vignette"></div>

    <div class="md-container">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4" data-animate="fade-up">
            <ol class="breadcrumb mb-0" style="font-size:0.86rem;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Movies" asp-action="Index" class="text-white-50 text-decoration-none">Kho phim</a></li>
                <li class="breadcrumb-item active text-white fw-semibold" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <div class="md-grid">
            <!-- Left: 3D Poster Frame -->
            <div class="md-poster-frame cinema-tilt" data-animate="scale-in">
                <img src="@poster"
                     alt="@Model.Title"
                     onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800'" />
            </div>

            <!-- Right: Blockbuster Microsite Info -->
            <div data-animate="fade-up" data-delay="100">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="badge @ageClass px-3 py-2 rounded-pill fw-bold">@ageText</span>
                    <span class="badge rounded-pill px-3 py-2 fw-bold" style="background:rgba(56,189,248,0.15);border:1px solid rgba(56,189,248,0.35);color:#38BDF8;">
                        <i class="bi bi-badge-4k-fill me-1"></i>@format
                    </span>
                    <span class="badge rounded-pill px-3 py-2 fw-bold" style="background:rgba(245,185,66,0.15);border:1px solid rgba(245,185,66,0.35);color:#F5B942;">
                        <i class="bi bi-star-fill me-1"></i>@rating / 10 IMDb
                    </span>
                </div>

                <h1 class="text-white fw-bolder mb-3" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2.1rem,4vw,3.4rem);line-height:1.08;">
                    @Model.Title
                </h1>

                @if (genres.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        @foreach (var g in genres)
                        {
                            <span class="px-3 py-1 rounded-pill text-white" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);font-size:0.82rem;font-weight:600;">
                                @g
                            </span>
                        }
                    </div>
                }

                <!-- Bento Technical Specs -->
                <div class="md-spec-bento">
                    <div class="md-spec-card">
                        <div class="text-white-50 small mb-1"><i class="bi bi-clock-history text-info me-1"></i>Thời lượng</div>
                        <div class="text-white fw-bold fs-5">@Model.Duration phút</div>
                    </div>
                    <div class="md-spec-card">
                        <div class="text-white-50 small mb-1"><i class="bi bi-calendar2-check text-warning me-1"></i>Khởi chiếu</div>
                        <div class="text-white fw-bold fs-5">@(Model.ReleaseDate?.ToString("dd/MM/yyyy") ?? "Đang cập nhật")</div>
                    </div>
                    <div class="md-spec-card">
                        <div class="text-white-50 small mb-1"><i class="bi bi-soundwave text-danger me-1"></i>Âm thanh</div>
                        <div class="text-white fw-bold fs-5">Dolby Atmos</div>
                    </div>
                    <div class="md-spec-card">
                        <div class="text-white-50 small mb-1"><i class="bi bi-translate text-success me-1"></i>Phụ đề</div>
                        <div class="text-white fw-bold fs-5">Vietsub / Lồng tiếng</div>
                    </div>
                </div>

                <!-- Age restriction notice -->
                <div class="p-3 rounded-4 mb-4 d-flex align-items-center gap-3"
                     style="background:rgba(245,185,66,0.08);border:1px solid rgba(245,185,66,0.25);">
                    <i class="bi bi-shield-exclamation text-warning fs-4"></i>
                    <div class="small text-white-50">
                        <strong class="text-white">Phân loại độ tuổi (@ageText):</strong> @ageDesc
                    </div>
                </div>

                <!-- Synopsis -->
                <div class="p-4 rounded-4 mb-4" style="background:rgba(15,22,41,0.65);border:1px solid rgba(255,255,255,0.08);">
                    <h5 class="text-white fw-bold mb-2 d-flex align-items-center gap-2">
                        <i class="bi bi-journal-richtext text-danger"></i> Nội Dung Phim
                    </h5>
                    <p class="text-white-50 mb-0" style="line-height:1.75;font-size:0.98rem;">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "Bộ phim mang đến hành trình điện ảnh mãn nhãn với kỹ xảo hình ảnh IMAX thế hệ mới và chiều sâu cảm xúc khó quên."
                            : Model.Description)
                    </p>
                </div>

                @if (isAdmin)
                {
                    <!-- Admin Box Office & Quick Controls -->
                    <div class="p-4 rounded-4 mb-4" style="background:rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.35);">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div>
                                <div class="text-info fw-bold small text-uppercase mb-1"><i class="bi bi-speedometer2 me-1"></i>Số Liệu Quản Trị Phòng Vé</div>
                                <div class="d-flex gap-4">
                                    <div>
                                        <span class="text-white-50 small">Vé đã bán:</span>
                                        <strong class="text-white ms-1">@((ViewBag.TotalTickets ?? 0).ToString("N0")) vé</strong>
                                    </div>
                                    <div>
                                        <span class="text-white-50 small">Doanh thu:</span>
                                        <strong class="text-warning ms-1">@(((decimal)(ViewBag.TotalRevenue ?? 0m)).ToString("N0")) ₫</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-area="Admin" asp-controller="Movies" asp-action="Edit" asp-route-id="@Model.MovieId"
                                   class="btn btn-warning btn-sm rounded-pill px-3 fw-bold">
                                    <i class="bi bi-pencil-square me-1"></i> Sửa Phim
                                </a>
                                <a asp-area="Admin" asp-controller="Movies" asp-action="Index"
                                   class="btn btn-outline-light btn-sm rounded-pill px-3">
                                    <i class="bi bi-arrow-left me-1"></i> Quản Trị Phim
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <!-- Action CTA Bar -->
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Showtimes" asp-action="Index" asp-route-movieId="@Model.MovieId"
                       class="btn btn-lg rounded-4 px-4 py-3 fw-bold text-white d-inline-flex align-items-center gap-2 cinema-magnetic"
                       style="background:linear-gradient(135deg,#FF2E55,#FF6B35);box-shadow:0 16px 36px rgba(255,46,85,0.4);">
                        <i class="bi bi-ticket-perforated-fill"></i>
                        <span>Chọn Suất Chiếu &amp; Đặt Vé</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <button type="button"
                            class="btn btn-lg rounded-4 px-4 py-3 fw-bold text-white d-inline-flex align-items-center gap-2"
                            style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.16);"
                            data-bs-toggle="modal"
                            data-bs-target="#detailTrailerModal">
                        <i class="bi bi-play-circle-fill text-danger fs-5"></i>
                        <span>Xem Trailer Chính Thức</span>
                    </button>

                    <a asp-controller="Movies" asp-action="Index"
                       class="btn btn-lg rounded-4 px-4 py-3 fw-semibold text-white-50 d-inline-flex align-items-center gap-2"
                       style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);">
                        <i class="bi bi-grid"></i>
                        <span>Kho Phim</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Official Trailer Modal -->
<div class="modal fade" id="detailTrailerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content" style="background:#080c18;border:1px solid rgba(255,255,255,0.16);border-radius:24px;overflow:hidden;">
            <div class="modal-header border-0 px-4 pt-3 pb-2">
                <h5 class="modal-title text-white fw-bold"><i class="bi bi-play-btn-fill text-danger me-2"></i>Trailer: @Model.Title</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9 bg-black">
                    <iframe id="detailTrailerIframe" data-src="@trailerUrl" src="" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = document.getElementById('detailTrailerModal');
            var iframe = document.getElementById('detailTrailerIframe');
            if (modal && iframe) {
                modal.addEventListener('show.bs.modal', function () {
                    var url = iframe.getAttribute('data-src');
                    if (url) {
                        var sep = url.indexOf('?') === -1 ? '?' : '&';
                        iframe.src = url + sep + 'autoplay=1';
                    }
                });
                modal.addEventListener('hidden.bs.modal', function () {
                    iframe.src = '';
                });
            }
        });
    </script>
}
