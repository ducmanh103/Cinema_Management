@model IEnumerable<MovieDto>
@using CinemaManagement.Helpers
@{
    ViewData["Title"] = "Kho Phim Điện Ảnh";
    ViewBag.FullWidth = true;

    var movies = Model?.ToList() ?? new List<MovieDto>();
    var nowShowingCount = movies.Count(m => m.Status == "Now Showing");
    var comingSoonCount = movies.Count(m => m.Status == "Coming Soon");
    var endedCount = movies.Count(m => m.Status == "Ended");
    var allGenres = movies
        .Where(m => m.Genres != null)
        .SelectMany(m => m.Genres)
        .Distinct()
        .OrderBy(g => g)
        .ToList();
    var initialQuery = Context.Request.Query["searchString"].ToString();
}

<style>
    .mv-hero {
        position: relative;
        padding: 56px 0 42px;
        background:
            radial-gradient(circle at 80% 20%, rgba(255, 46, 85, 0.18), transparent 45%),
            radial-gradient(circle at 15% 75%, rgba(99, 102, 241, 0.16), transparent 50%),
            #050711;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }
    .mv-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
    }
    .mv-filter-dock {
        margin-top: 28px;
        padding: 20px 22px;
        border-radius: 24px;
        background: rgba(13, 19, 36, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    }
    .mv-search-box {
        position: relative;
        flex: 1;
        min-width: 240px;
    }
    .mv-search-box i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #94A3B8;
    }
    .mv-search-input {
        width: 100%;
        min-height: 48px;
        padding: 10px 42px 10px 44px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #F8FAFC;
        font-size: 0.92rem;
        outline: none;
        transition: all 0.25s ease;
    }
    .mv-search-input:focus {
        border-color: #FF2E55;
        background: rgba(255, 46, 85, 0.06);
        box-shadow: 0 0 0 3px rgba(255, 46, 85, 0.15);
    }
    .mv-status-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .mv-status-btn {
        min-height: 46px;
        padding: 8px 18px;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.04);
        color: #CBD5E1;
        font-size: 0.85rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.25s ease;
    }
    .mv-status-btn.active {
        background: linear-gradient(135deg, #FF2E55, #FF6B35);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 10px 24px rgba(255, 46, 85, 0.35);
    }
    .mv-genre-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        overflow-x: auto;
        padding-top: 16px;
        margin-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
        scrollbar-width: none;
    }
    .mv-genre-bar::-webkit-scrollbar { display: none; }
    .mv-genre-chip {
        min-height: 38px;
        padding: 6px 15px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.09);
        color: #94A3B8;
        font-size: 0.8rem;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .mv-genre-chip.active {
        background: rgba(245, 185, 66, 0.16);
        border-color: #F5B942;
        color: #F5B942;
    }
    .mv-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 24px;
        padding: 40px 0 72px;
    }
    .mv-card {
        border-radius: 22px;
        background: rgba(15, 22, 41, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transform: translate3d(0, 0, 0);
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
        will-change: transform, box-shadow, border-color;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mv-card:hover {
        transform: translate3d(0, -10px, 0) scale(1.012);
        border-color: rgba(255, 46, 85, 0.45);
        box-shadow: 0 24px 55px rgba(0, 0, 0, 0.72), 0 0 35px rgba(255, 46, 85, 0.18);
    }
    .mv-poster-wrap {
        position: relative;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        background: #090d1a;
        transform: translate3d(0, 0, 0);
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
    }
    .mv-poster-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: translate3d(0, 0, 0) scale(1);
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
        will-change: transform, filter;
        transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), filter 0.65s ease;
    }
    .mv-card:hover .mv-poster-wrap img {
        transform: translate3d(0, 0, 0) scale(1.08);
        filter: brightness(1.06) contrast(1.03);
    }
    .mv-poster-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(5, 7, 17, 0.1) 0%, rgba(5, 7, 17, 0.92) 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        opacity: 0;
        transition: opacity 0.28s ease;
    }
    .mv-card:hover .mv-poster-overlay {
        opacity: 1;
    }
    .mv-play-btn {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(135deg, #FF2E55, #FF6B35);
        color: #fff;
        font-size: 1.35rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 12px 28px rgba(255, 46, 85, 0.5);
        cursor: pointer;
    }
    .mv-card-body {
        padding: 18px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .mv-card-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.06rem;
        font-weight: 800;
        color: #F8FAFC;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 6px;
    }
    .mv-card-title:hover { color: #FF2E55; }
    .mv-book-btn {
        min-height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, #FF2E55, #FF6B35);
        color: #fff !important;
        font-weight: 800;
        font-size: 0.83rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        flex: 1;
    }
    @@media (max-width: 1199.98px) {
        .mv-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @@media (max-width: 767.98px) {
        .mv-hero { padding: 28px 0 24px; }
        .mv-container { padding: 0 14px; }
        .mv-filter-dock { padding: 14px; border-radius: 18px; margin-top: 18px; }
        .mv-status-tabs {
            display: flex;
            flex-wrap: nowrap;
            overflow-x: auto;
            width: 100%;
            padding-bottom: 4px;
            scrollbar-width: none;
        }
        .mv-status-tabs::-webkit-scrollbar { display: none; }
        .mv-status-btn {
            white-space: nowrap;
            min-height: 40px;
            padding: 6px 14px;
            font-size: 0.78rem;
            flex-shrink: 0;
        }
        .mv-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 24px 0 56px; }
        .mv-card { border-radius: 16px; }
        .mv-card-body { padding: 10px 12px 12px; }
        .mv-card-title { font-size: 0.92rem; }
        .mv-book-btn { min-height: 38px; font-size: 0.78rem; border-radius: 10px; }
    }
</style>

<section class="mv-hero">
    <div class="mv-container">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3" data-animate="fade-up">
            <div>
                <span class="ch-eyebrow mb-2"><i class="bi bi-collection-play-fill"></i> Thư Viện Điện Ảnh Chuẩn IMAX</span>
                <h1 class="text-white fw-bolder mb-1" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,3.6vw,3rem);">
                    Khám Phá Kho Phim CinemaHub
                </h1>
                <p class="text-white-50 mb-0">Tìm kiếm tức thì theo tên phim, trạng thái khởi chiếu và thể loại yêu thích.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="px-3 py-2 rounded-4" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);">
                    <span class="text-white-50 small">Hiển thị:</span>
                    <strong class="text-white ms-1" id="visibleMovieCount">@movies.Count</strong>
                    <span class="text-white-50 small">phim</span>
                </div>
            </div>
        </div>

        <!-- Interactive Filter Dock -->
        <div class="mv-filter-dock cinema-spotlight" data-animate="fade-up" data-delay="80">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="mv-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           id="movieSearch"
                           value="@initialQuery"
                           class="mv-search-input"
                           placeholder="Nhập tên phim, thể loại hoặc từ khóa..." />
                </div>

                <div class="mv-status-tabs" role="tablist">
                    <button type="button" class="mv-status-btn active" data-status="all">
                        <i class="bi bi-grid-fill"></i> Tất Cả (@movies.Count)
                    </button>
                    <button type="button" class="mv-status-btn" data-status="Now Showing">
                        <i class="bi bi-play-circle-fill text-success"></i> Đang Chiếu (@nowShowingCount)
                    </button>
                    <button type="button" class="mv-status-btn" data-status="Coming Soon">
                        <i class="bi bi-calendar2-plus-fill text-warning"></i> Sắp Chiếu (@comingSoonCount)
                    </button>
                    @if (endedCount > 0)
                    {
                        <button type="button" class="mv-status-btn" data-status="Ended">
                            <i class="bi bi-archive-fill text-secondary"></i> Đã Chiếu (@endedCount)
                        </button>
                    }
                </div>
            </div>

            @if (allGenres.Any())
            {
                <div class="mv-genre-bar">
                    <button type="button" class="mv-genre-chip active" data-genre="all">Tất cả thể loại</button>
                    @foreach (var g in allGenres)
                    {
                        <button type="button" class="mv-genre-chip" data-genre="@g">@g</button>
                    }
                </div>
            }
        </div>
    </div>
</section>

<section class="mv-container">
    <div class="mv-grid" id="moviesCatalogGrid">
        @foreach (var m in movies)
        {
            var ageClass = MovieDisplayHelper.GetAgeBadgeClass(m.Title);
            var ageText = MovieDisplayHelper.GetAgeBadgeText(m.Title);
            var format = MovieDisplayHelper.GetMovieFormat(m.Title);
            var rating = MovieDisplayHelper.GetMovieRating(m.MovieId).ToString("0.0");
            var trailer = MovieDisplayHelper.GetTrailerEmbedUrl(m.Title, m.TrailerUrl);
            var genrePipe = m.Genres != null ? string.Join("|", m.Genres) : "";
            var genreDisplay = m.Genres != null && m.Genres.Any() ? string.Join(", ", m.Genres.Take(2)) : "Điện ảnh";

            <article class="mv-card cinema-spotlight"
                     data-title="@m.Title.ToLowerInvariant()"
                     data-status="@m.Status"
                     data-genres="@genrePipe">
                <div class="mv-poster-wrap">
                    <div class="position-absolute top-0 start-0 end-0 p-2 d-flex justify-content-between z-2">
                        <span class="badge @ageClass rounded-2 px-2 py-1 fw-bold">@ageText</span>
                        <span class="badge rounded-2 px-2 py-1" style="background:rgba(5,7,17,0.82);border:1px solid rgba(56,189,248,0.4);color:#38BDF8;">@format</span>
                    </div>
                    <img src="@m.PosterUrl"
                         alt="@m.Title"
                         loading="lazy"
                         onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=600'" />
                    <div class="position-absolute bottom-0 start-0 end-0 p-2 d-flex justify-content-between align-items-center z-2"
                         style="background:linear-gradient(transparent,rgba(5,7,17,0.9));">
                        <span class="badge rounded-pill px-2 py-1"
                              style="background:@(m.Status == "Now Showing" ? "rgba(16,185,129,0.2)" : "rgba(245,185,66,0.2)");color:@(m.Status == "Now Showing" ? "#34D399" : "#F5B942");font-size:0.7rem;">
                            @(m.Status == "Now Showing" ? "Đang chiếu" : m.Status == "Coming Soon" ? "Sắp chiếu" : "Đã kết thúc")
                        </span>
                        <span class="text-warning fw-bold" style="font-size:0.8rem;">
                            <i class="bi bi-star-fill"></i> @rating
                        </span>
                    </div>
                    <div class="mv-poster-overlay z-3">
                        <button type="button"
                                class="mv-play-btn js-movie-trailer"
                                data-trailer="@trailer"
                                data-title="@m.Title">
                            <i class="bi bi-play-fill"></i>
                        </button>
                        <span class="text-white fw-bold small">Xem Trailer</span>
                    </div>
                </div>

                <div class="mv-card-body">
                    <a asp-action="Details" asp-route-id="@m.MovieId" class="mv-card-title" title="@m.Title">@m.Title</a>
                    <div class="text-white-50 d-flex align-items-center gap-2 mb-3" style="font-size:0.78rem;">
                        <span><i class="bi bi-clock text-info me-1"></i>@m.Duration phút</span>
                        <span>•</span>
                        <span class="text-truncate">@genreDisplay</span>
                    </div>
                    <div class="mt-auto d-flex gap-2">
                        @if (m.Status != "Ended")
                        {
                            <a asp-controller="Showtimes" asp-action="Index" asp-route-movieId="@m.MovieId" class="mv-book-btn">
                                <i class="bi bi-ticket-perforated-fill"></i> Đặt Vé
                            </a>
                        }
                        <a asp-action="Details" asp-route-id="@m.MovieId"
                           class="btn btn-sm d-inline-flex align-items-center justify-content-center px-3 rounded-3"
                           style="min-height:42px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:#F8FAFC;">
                            <i class="bi bi-info-circle"></i>
                        </a>
                    </div>
                </div>
            </article>
        }
    </div>

    <!-- Empty State -->
    <div id="moviesEmptyState" class="text-center py-5 d-none">
        <div class="p-5 rounded-4 mx-auto" style="max-width:520px;background:rgba(15,22,41,0.7);border:1px solid rgba(255,255,255,0.08);">
            <i class="bi bi-search fs-1 text-danger d-block mb-3"></i>
            <h4 class="text-white fw-bold">Không tìm thấy phim phù hợp</h4>
            <p class="text-white-50 mb-4">Hãy thử đổi từ khóa tìm kiếm hoặc chọn lại bộ lọc thể loại khác.</p>
            <button type="button" id="resetMovieFiltersBtn" class="btn rounded-pill px-4 py-2 fw-bold text-white"
                    style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt Lại Bộ Lọc
            </button>
        </div>
    </div>
</section>

<!-- Trailer Modal -->
<div class="modal fade" id="catalogTrailerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content" style="background:#080c18;border:1px solid rgba(255,255,255,0.15);border-radius:24px;overflow:hidden;">
            <div class="modal-header border-0 px-4 pt-3 pb-2">
                <h5 class="modal-title text-white fw-bold" id="catalogTrailerTitle">Trailer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9 bg-black">
                    <iframe id="catalogTrailerIframe" src="" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('movieSearch');
            var statusBtns = document.querySelectorAll('.mv-status-btn');
            var genreBtns = document.querySelectorAll('.mv-genre-chip');
            var cards = document.querySelectorAll('#moviesCatalogGrid .mv-card');
            var countEl = document.getElementById('visibleMovieCount');
            var emptyEl = document.getElementById('moviesEmptyState');
            var resetBtn = document.getElementById('resetMovieFiltersBtn');

            var activeStatus = 'all';
            var activeGenre = 'all';

            function applyMovieFilter() {
                var q = (searchInput ? searchInput.value : '').trim().toLowerCase();
                var visible = 0;

                cards.forEach(function (card) {
                    var title = card.getAttribute('data-title') || '';
                    var status = card.getAttribute('data-status') || '';
                    var genres = (card.getAttribute('data-genres') || '').split('|').filter(Boolean);

                    var matchSearch = !q || title.indexOf(q) !== -1 || genres.join(' ').toLowerCase().indexOf(q) !== -1;
                    var matchStatus = activeStatus === 'all' || status === activeStatus;
                    var matchGenre = activeGenre === 'all' || genres.indexOf(activeGenre) !== -1;

                    var show = matchSearch && matchStatus && matchGenre;
                    card.style.display = show ? '' : 'none';
                    if (show) visible++;
                });

                if (countEl) countEl.textContent = visible;
                if (emptyEl) emptyEl.classList.toggle('d-none', visible > 0);
            }

            if (searchInput) {
                searchInput.addEventListener('input', applyMovieFilter);
                if (searchInput.value.trim() !== '') applyMovieFilter();
            }

            statusBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    activeStatus = btn.getAttribute('data-status');
                    statusBtns.forEach(function (b) { b.classList.toggle('active', b === btn); });
                    applyMovieFilter();
                });
            });

            genreBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    activeGenre = btn.getAttribute('data-genre');
                    genreBtns.forEach(function (b) { b.classList.toggle('active', b === btn); });
                    applyMovieFilter();
                });
            });

            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    if (searchInput) searchInput.value = '';
                    activeStatus = 'all';
                    activeGenre = 'all';
                    statusBtns.forEach(function (b, i) { b.classList.toggle('active', i === 0); });
                    genreBtns.forEach(function (b, i) { b.classList.toggle('active', i === 0); });
                    applyMovieFilter();
                });
            }

            // Trailer modal
            var modalEl = document.getElementById('catalogTrailerModal');
            var iframe = document.getElementById('catalogTrailerIframe');
            var titleEl = document.getElementById('catalogTrailerTitle');
            if (modalEl && iframe) {
                var bsModal = null;
                document.querySelectorAll('.js-movie-trailer').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var url = btn.getAttribute('data-trailer');
                        var title = btn.getAttribute('data-title');
                        if (!url) return;
                        var sep = url.indexOf('?') === -1 ? '?' : '&';
                        iframe.src = url + sep + 'autoplay=1';
                        if (titleEl) titleEl.textContent = 'Trailer: ' + title;
                        if (!bsModal && window.bootstrap) bsModal = new bootstrap.Modal(modalEl);
                        if (bsModal) bsModal.show();
                    });
                });
                modalEl.addEventListener('hidden.bs.modal', function () { iframe.src = ''; });
            }
        });
    </script>
}
