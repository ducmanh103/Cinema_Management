@model ProfileViewModel
@{
    ViewData["Title"] = "Thông tin tài khoản thành viên";
    var initial = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName.Trim()[0].ToString().ToUpper() : "U";
}

<section class="py-4 my-2">
    @if (TempData["Success"] != null)
    {
        <div class="p-3 mb-4" style="background:rgba(16,185,129,0.14);border:1px solid rgba(16,185,129,0.45);border-radius:10px;color:#6ee7b7;font-size:0.86rem;">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-3 mb-4" style="background:rgba(229,57,53,0.14);border:1px solid rgba(229,57,53,0.5);border-radius:10px;color:#fca5a5;font-size:0.86rem;">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
        </div>
    }

    <div class="row g-4">
        <!-- Left Member Card -->
        <div class="col-lg-4">
            <div class="ch-auth-dossier h-100 d-flex flex-column justify-content-between cinema-spotlight">
                <div>
                    <div class="ch-auth-plate-bar">
                        <span><i class="bi bi-stars me-1"></i> Thẻ thành viên CinemaHub</span>
                        <span>Mã TV #@Model.UserId.ToString("D4")</span>
                    </div>

                    <div class="p-4">
                        <div class="d-flex align-items-center gap-3 mb-4 pb-3" style="border-bottom:1px solid var(--border-glass);">
                            <div class="d-flex align-items-center justify-content-center fw-bolder"
                                 style="width:64px;height:64px;border-radius:14px;font-size:1.6rem;background:var(--primary);color:var(--text-main);">
                                @initial
                            </div>
                            <div>
                                <h4 class="fw-bold mb-1" style="color:var(--text-main);font-size:1.2rem;">@Model.FullName</h4>
                                <div style="font-size:0.82rem;color:var(--gold);font-weight:600;">
                                    @@@Model.Username &bull; @Model.RoleName
                                </div>
                            </div>
                        </div>

                        <div class="row g-0 mb-4" style="border:1px solid var(--border-glass-strong);background:#0f1117;border-radius:12px;overflow:hidden;">
                            <div class="col-6 p-3" style="border-right:1px solid var(--border-glass);">
                                <div style="font-size:0.75rem;color:var(--text-muted);font-weight:600;">Số vé đã đặt</div>
                                <div class="fw-bold mt-1" style="font-size:1.45rem;color:var(--text-main);">@Model.TotalTickets</div>
                            </div>
                            <div class="col-6 p-3">
                                <div style="font-size:0.75rem;color:var(--text-muted);font-weight:600;">Tổng chi tiêu</div>
                                <div class="fw-bold mt-1" style="font-size:1.15rem;color:var(--gold);">@Model.TotalSpent.ToString("N0")đ</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-4 pt-0">
                    <a asp-controller="Booking" asp-action="MyTickets" class="ch-auth-btn-primary">
                        <i class="bi bi-qr-code-scan"></i>
                        <span>Xem vé đã đặt</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Settings Forms -->
        <div class="col-lg-8">
            <div class="ch-auth-dossier mb-4 cinema-spotlight">
                <div class="ch-auth-plate-bar">
                    <span><i class="bi bi-person-lines-fill me-1"></i> Thông tin cá nhân</span>
                    <span>Cập nhật hồ sơ</span>
                </div>
                <div class="p-4">
                    <form asp-action="UpdateProfile" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="ch-auth-label">Họ và tên</label>
                                <input type="text" name="FullName" value="@Model.FullName" required class="ch-auth-input-standalone" />
                            </div>
                            <div class="col-md-6">
                                <label class="ch-auth-label">Địa chỉ Email</label>
                                @if (Model.IsGoogleAccount)
                                {
                                    <input type="email" name="Email" value="@Model.Email" readonly class="ch-auth-input-standalone opacity-75" />
                                    <div class="small mt-1" style="color:var(--text-muted);font-size:0.76rem;">
                                        Tài khoản liên kết Google — không thể thay đổi Email tại đây.
                                    </div>
                                }
                                else
                                {
                                    <input type="email" name="Email" value="@Model.Email" required class="ch-auth-input-standalone" />
                                }
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="ch-auth-btn-primary" style="width:auto;">
                                <i class="bi bi-check2"></i>
                                <span>Lưu thay đổi</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="ch-auth-dossier cinema-spotlight">
                <div class="ch-auth-plate-bar">
                    <span><i class="bi bi-shield-lock-fill me-1"></i> Đổi mật khẩu bảo mật</span>
                    <span>Bảo vệ tài khoản</span>
                </div>
                <div class="p-4">
                    @if (Model.HasPassword)
                    {
                        <form asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="ch-auth-label">Mật khẩu hiện tại</label>
                                    <input type="password" name="CurrentPassword" required class="ch-auth-input-standalone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="ch-auth-label">Mật khẩu mới</label>
                                    <input type="password" name="NewPassword" required minlength="8" class="ch-auth-input-standalone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="ch-auth-label">Xác nhận mật khẩu</label>
                                    <input type="password" name="ConfirmPassword" required minlength="8" class="ch-auth-input-standalone" />
                                </div>
                            </div>
                            <div class="mt-3">
                                <button type="submit" class="ch-auth-btn-secondary" style="width:auto;">
                                    <i class="bi bi-key"></i>
                                    <span>Cập nhật mật khẩu</span>
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="p-3 rounded-3 small" style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);color:var(--text-secondary);">
                            <i class="bi bi-google me-2 text-warning"></i>
                            Tài khoản này đang đăng nhập thông qua Google (không sử dụng mật khẩu riêng). Mọi thao tác bảo mật mật khẩu được quản lý trực tiếp bởi Google.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
