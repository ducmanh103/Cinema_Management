@model ProfileViewModel
@{
    ViewData["Title"] = "Hồ Sơ Thành Viên VIP";
    var initial = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName.Trim()[0].ToString().ToUpper() : "U";
}

<div class="py-4 my-2">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 py-2 px-3 small mb-4">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 py-2 px-3 small mb-4">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
        </div>
    }

    <div class="row g-4">
        <!-- Left VIP Member Card -->
        <div class="col-lg-4">
            <div class="p-4 rounded-5 cinema-spotlight h-100 d-flex flex-column justify-content-between"
                 style="background:radial-gradient(circle at 80% 15%,rgba(245,185,66,0.22),transparent 55%),rgba(15,22,41,0.88);border:1px solid rgba(245,185,66,0.35);">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <span class="badge rounded-pill px-3 py-1" style="background:rgba(245,185,66,0.2);color:#F5B942;">
                            <i class="bi bi-stars me-1"></i>CINEMAHUB PASS
                        </span>
                        <span class="text-white-50 small font-monospace">ID #@Model.UserId.ToString("D4")</span>
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bolder text-white"
                             style="width:68px;height:68px;font-size:1.7rem;background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                            @initial
                        </div>
                        <div>
                            <h4 class="text-white fw-bold mb-0">@Model.FullName</h4>
                            <div class="text-white-50 small">@@@Model.Username • @Model.RoleName</div>
                        </div>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <div class="p-3 rounded-4" style="background:rgba(255,255,255,0.04);">
                                <div class="text-white-50 small">Vé đã đặt</div>
                                <div class="text-white fw-bolder fs-4">@Model.TotalTickets</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-4" style="background:rgba(255,255,255,0.04);">
                                <div class="text-white-50 small">Chi tiêu</div>
                                <div class="text-warning fw-bolder fs-5">@Model.TotalSpent.ToString("N0") ₫</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Booking" asp-action="MyTickets"
                       class="btn rounded-4 py-2 fw-bold text-white"
                       style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.14);">
                        <i class="bi bi-qr-code-scan me-1 text-info"></i> Mở Ví Vé Điện Tử
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Settings Forms -->
        <div class="col-lg-8">
            <div class="p-4 rounded-5 cinema-spotlight mb-4"
                 style="background:rgba(15,22,41,0.82);border:1px solid rgba(255,255,255,0.09);">
                <h5 class="text-white fw-bold mb-3"><i class="bi bi-person-lines-fill text-info me-2"></i>Cập Nhật Thông Tin Cá Nhân</h5>
                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small fw-bold text-uppercase">Họ và tên</label>
                            <input type="text" name="FullName" value="@Model.FullName" required class="form-control bg-transparent border-secondary border-opacity-25 text-white" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small fw-bold text-uppercase">Địa chỉ Email</label>
                            <input type="email" name="Email" value="@Model.Email" required class="form-control bg-transparent border-secondary border-opacity-25 text-white" />
                        </div>
                    </div>
                    <button type="submit" class="btn rounded-pill px-4 py-2 fw-bold text-white mt-3"
                            style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                        <i class="bi bi-check2 me-1"></i> Lưu Thay Đổi
                    </button>
                </form>
            </div>

            <div class="p-4 rounded-5 cinema-spotlight"
                 style="background:rgba(15,22,41,0.82);border:1px solid rgba(255,255,255,0.09);">
                <h5 class="text-white fw-bold mb-3"><i class="bi bi-shield-lock-fill text-warning me-2"></i>Đổi Mật Khẩu Bảo Mật</h5>
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        @if (Model.HasPassword)
                        {
                            <div class="col-md-4">
                                <label class="form-label text-white-50 small fw-bold text-uppercase">Mật khẩu hiện tại</label>
                                <input type="password" name="CurrentPassword" required class="form-control bg-transparent border-secondary border-opacity-25 text-white" />
                            </div>
                        }
                        <div class="col-md-4">
                            <label class="form-label text-white-50 small fw-bold text-uppercase">Mật khẩu mới</label>
                            <input type="password" name="NewPassword" required minlength="6" class="form-control bg-transparent border-secondary border-opacity-25 text-white" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-white-50 small fw-bold text-uppercase">Xác nhận mật khẩu</label>
                            <input type="password" name="ConfirmPassword" required minlength="6" class="form-control bg-transparent border-secondary border-opacity-25 text-white" />
                        </div>
                    </div>
                    <button type="submit" class="btn rounded-pill px-4 py-2 fw-bold text-white mt-3"
                            style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.18);">
                        <i class="bi bi-key me-1"></i> Cập Nhật Mật Khẩu
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
