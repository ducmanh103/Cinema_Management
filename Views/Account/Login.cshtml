@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập thành viên";
}

<section class="ch-auth-stage">
    <div class="ch-auth-dossier cinema-spotlight">
        <!-- Top Header Bar -->
        <div class="ch-auth-plate-bar">
            <span><i class="bi bi-ticket-perforated-fill me-1"></i> Thành viên CinemaHub</span>
            <span>Đặt vé trực tuyến • Quản lý vé QR</span>
        </div>

        <div class="row g-0">
            <!-- Left Member Benefits Column -->
            <div class="col-lg-5 d-none d-lg-flex ch-auth-poster-wing">
                <div class="position-relative" style="z-index: 1;">
                    <div class="ch-auth-kicker">
                        <span class="ch-auth-kicker-dot"></span>
                        <span>Tài khoản thành viên</span>
                    </div>

                    <h2 class="ch-auth-editorial-title">
                        Đặt Vé Xem Phim <em>Nhanh Chóng &amp; Tiện Lợi</em>
                    </h2>

                    <p class="ch-auth-editorial-lead">
                        Đăng nhập tài khoản CinemaHub để chọn ghế trực quan theo thời gian thực, nhận vé điện tử QR tức thì trên điện thoại và quản lý lịch sử đặt vé của bạn.
                    </p>
                </div>

                <div class="ch-auth-spec-list">
                    <div class="ch-auth-spec-item">
                        <div class="ch-auth-spec-icon">
                            <i class="bi bi-qr-code"></i>
                        </div>
                        <div>
                            <div class="fw-bold" style="font-size:0.88rem;color:var(--text-main);">
                                Vé điện tử QR tiện lợi
                            </div>
                            <div style="font-size:0.8rem;color:var(--text-muted);">
                                Quét mã trực tiếp tại lối vào phòng chiếu, không cần xếp hàng in vé giấy
                            </div>
                        </div>
                    </div>

                    <div class="ch-auth-spec-item">
                        <div class="ch-auth-spec-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div>
                            <div class="fw-bold" style="font-size:0.88rem;color:var(--text-main);">
                                Quản lý lịch sử đặt vé tập trung
                            </div>
                            <div style="font-size:0.8rem;color:var(--text-muted);">
                                Tra cứu lại thông tin phòng chiếu, số ghế và giờ chiếu mọi lúc mọi nơi
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Form Column -->
            <div class="col-lg-7 ch-auth-form-wing">
                <h1 class="ch-auth-form-title">Đăng Nhập Tài Khoản</h1>
                <p class="ch-auth-form-sub">Nhập tên đăng nhập và mật khẩu của bạn để tiếp tục đặt vé.</p>

                @if (TempData["Success"] != null)
                {
                    <div class="p-3 mb-3" style="background:rgba(16,185,129,0.14);border:1px solid rgba(16,185,129,0.45);border-radius:10px;color:#6ee7b7;font-size:0.86rem;">
                        <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="p-3 mb-3" style="background:rgba(229,57,53,0.14);border:1px solid rgba(229,57,53,0.5);border-radius:10px;color:#fca5a5;font-size:0.86rem;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                    </div>
                }

                <form asp-action="Login" method="post" class="mb-3">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="ch-auth-label">Tên đăng nhập</label>
                        <div class="ch-auth-input-group">
                            <span class="ch-auth-input-prefix">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="Username"
                                   class="ch-auth-input"
                                   placeholder="Nhập tên đăng nhập của bạn"
                                   autocomplete="username" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="ch-auth-label mb-0">Mật khẩu</label>
                            <a asp-action="ForgotPassword" class="ch-auth-link" style="font-size:0.82rem;">
                                Quên mật khẩu?
                            </a>
                        </div>
                        <div class="ch-auth-input-group">
                            <span class="ch-auth-input-prefix">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password"
                                   type="password"
                                   id="loginPasswordInput"
                                   class="ch-auth-input"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="current-password" />
                            <button type="button"
                                    class="ch-auth-eye-btn"
                                    aria-label="Hiện hoặc ẩn mật khẩu"
                                    onclick="var i=document.getElementById('loginPasswordInput');i.type=i.type==='password'?'text':'password';">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberCheck" style="background-color:#0f1117;border-color:rgba(248,250,252,0.3);border-radius:4px;" />
                            <label asp-for="RememberMe" class="form-check-label small" for="rememberCheck" style="color:var(--text-secondary);">
                                Ghi nhớ đăng nhập trên thiết bị này
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="ch-auth-btn-primary">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Đăng nhập</span>
                    </button>
                </form>

                <div class="ch-auth-divider">
                    <div class="ch-auth-divider-line"></div>
                    <span class="ch-auth-divider-text">Hoặc đăng nhập nhanh với</span>
                    <div class="ch-auth-divider-line"></div>
                </div>

                <form asp-action="GoogleLogin" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <button type="submit" class="ch-auth-btn-secondary">
                        <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                        </svg>
                        <span>Tiếp tục với tài khoản Google</span>
                    </button>
                </form>

                <p class="text-center small mt-4 mb-0" style="color:var(--text-muted);">
                    Chưa có tài khoản thành viên?
                    <a asp-action="Register" class="ch-auth-link ms-1">Đăng ký ngay &rarr;</a>
                </p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
