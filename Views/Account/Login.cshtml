@model CinemaManagement.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card" style="background:#1e1e1e; border:1px solid #333">
            <div class="card-body p-4">
                <h3 class="text-center mb-4" style="color:#e50914"><i class="bi bi-film"></i> Đăng nhập</h3>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                        <input asp-for="Username" class="form-control" style="background:#2a2a2a; border-color:#444; color:#fff"
                               placeholder="Nhập tên đăng nhập" id="username-input" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu</label>
                        <input asp-for="Password" class="form-control" style="background:#2a2a2a; border-color:#444; color:#fff"
                               placeholder="Nhập mật khẩu" id="password-input" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" id="remember-me" />
                        <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger" id="login-btn">
                            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                        </button>
                    </div>

                    <hr style="border-color:#444" />
                    <p class="text-center text-muted small">
                        Chưa có tài khoản?
                        <a asp-controller="Account" asp-action="Register" class="text-danger">Đăng ký ngay</a>
                    </p>
                    <p class="text-center text-muted small">
                        @* Demo credentials đã được ẩn để bảo mật *@
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Hiển thị validation summary nếu có lỗi
        document.addEventListener('DOMContentLoaded', function() {
            const vs = document.querySelector('[data-valmsg-summary]');
            if (vs && vs.querySelector('li')) vs.style.display = 'block';
        });
    </script>
}
