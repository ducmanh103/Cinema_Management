@model LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Thành Viên";
}

<div class="py-5 my-2">
    <div class="row g-0 mx-auto rounded-5 overflow-hidden cinema-spotlight"
         style="max-width:980px;background:rgba(13,19,36,0.92);border:1px solid rgba(255,255,255,0.1);box-shadow:0 30px 80px rgba(0,0,0,0.65);backdrop-filter:blur(24px);">
        
        <!-- Left Brand Banner (Clean & Modern) -->
        <div class="col-lg-5 d-none d-lg-flex flex-column justify-content-between p-5 position-relative"
             style="background:linear-gradient(165deg, rgba(255,46,85,0.12) 0%, rgba(9,13,26,0.95) 60%, #050711 100%);border-right:1px solid rgba(255,255,255,0.08);">
            <div>
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4"
                     style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);font-size:0.75rem;font-weight:700;letter-spacing:0.06em;color:#f8fafc;text-transform:uppercase;">
                    <span style="width:6px;height:6px;border-radius:50%;background:#FF2E55;"></span>
                    CinemaHub Member
                </div>
                <h2 class="text-white fw-bold mb-3" style="font-family:'Space Grotesk',sans-serif;font-size:1.85rem;line-height:1.2;">
                    Chào Mừng Đến Với Trải Nghiệm Điện Ảnh Mới
                </h2>
                <p class="text-white-50" style="font-size:0.9rem;line-height:1.7;">
                    Đăng nhập để nhận vé điện tử QR tức thì, tích lũy điểm thành viên và đặt trước những suất chiếu sớm nhất.
                </p>
            </div>

            <div class="d-flex flex-column gap-3 pt-4 border-top border-white border-opacity-10">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:40px;height:40px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:#ffffff;">
                        <i class="bi bi-qr-code fs-5"></i>
                    </div>
                    <div>
                        <div class="text-white fw-semibold small">Vé Điện Tử Tức Thì</div>
                        <div class="text-white-50" style="font-size:0.78rem;">Vào rạp không cần xếp hàng đổi vé</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:40px;height:40px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:#ffffff;">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                    <div>
                        <div class="text-white fw-semibold small">Bảo Mật Tiêu Chuẩn</div>
                        <div class="text-white-50" style="font-size:0.78rem;">Mã hóa dữ liệu & xác thực an toàn</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Form Panel -->
        <div class="col-lg-7 p-4 p-md-5">
            <div class="mb-4">
                <h3 class="text-white fw-bold mb-1" style="font-family:'Space Grotesk',sans-serif;font-size:1.6rem;">Đăng Nhập Tài Khoản</h3>
                <p class="text-white-50 small mb-0">Nhập thông tin tài khoản thành viên của bạn để tiếp tục.</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success rounded-4 py-2 px-3 small mb-3 border-0" style="background:rgba(16,185,129,0.15);color:#34d399;">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rounded-4 py-2 px-3 small mb-3 border-0" style="background:rgba(239,68,68,0.15);color:#f87171;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                </div>
            }

            <form asp-action="Login" method="post" class="mb-3">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label text-white-50 small fw-bold text-uppercase" style="letter-spacing:0.04em;">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-white-50">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="Username" class="form-control bg-transparent border-secondary border-opacity-25 text-white py-2" placeholder="Nhập username của bạn" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label text-white-50 small fw-bold text-uppercase mb-0" style="letter-spacing:0.04em;">Mật khẩu</label>
                        <a asp-action="ForgotPassword" class="text-white-50 text-decoration-none small hover-white">Quên mật khẩu?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-white-50">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="Password" type="password" id="loginPasswordInput" class="form-control bg-transparent border-secondary border-opacity-25 text-white py-2" placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary border-secondary border-opacity-25 text-white-50"
                                onclick="var i=document.getElementById('loginPasswordInput');i.type=i.type==='password'?'text':'password';">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input bg-transparent border-secondary" id="rememberCheck" />
                        <label asp-for="RememberMe" class="form-check-label text-white-50 small" for="rememberCheck">
                            Duy trì đăng nhập
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn w-100 py-3 fw-bold text-white text-nowrap d-flex align-items-center justify-content-center"
                        style="background:linear-gradient(135deg,#FF2E55 0%,#FF6B35 100%);border-radius:14px;box-shadow:0 8px 22px rgba(255,46,85,0.35);border:none;min-height:48px;font-size:0.98rem;letter-spacing:0.02em;">
                    <span>Đăng Nhập</span>
                </button>
            </form>

            <!-- Divider with guaranteed single-line text -->
            <div class="d-flex align-items-center gap-3 my-4">
                <div class="flex-grow-1" style="height:1px;background:rgba(255,255,255,0.12);"></div>
                <span class="text-white-50 text-uppercase fw-semibold text-nowrap" style="font-size:0.75rem;letter-spacing:0.06em;flex-shrink:0;white-space:nowrap !important;">
                    Hoặc đăng nhập với
                </span>
                <div class="flex-grow-1" style="height:1px;background:rgba(255,255,255,0.12);"></div>
            </div>

            <form asp-action="GoogleLogin" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <button type="submit" class="btn w-100 py-2 fw-semibold text-white text-nowrap d-flex align-items-center justify-content-center gap-2"
                        style="min-height:46px;border-radius:14px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);transition:all 0.2s ease;">
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Tiếp tục với Google</span>
                </button>
            </form>

            <p class="text-center text-white-50 small mt-4 mb-0">
                Chưa có tài khoản CinemaHub?
                <a asp-action="Register" class="text-white fw-semibold text-decoration-none ms-1 text-decoration-underline">Đăng ký thành viên</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
