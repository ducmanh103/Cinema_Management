@model CinemaManagement.Models.ViewModels.VerifyRegistrationEmailViewModel
@{
    ViewData["Title"] = "Xác thực Gmail";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card" style="background:#1e1e1e; border:1px solid #333; border-radius:14px;">
            <div class="card-body p-4">
                <h3 class="text-center mb-3" style="color:#e50914">
                    <i class="bi bi-envelope-check-fill"></i> Xác thực Gmail
                </h3>
                <p class="text-muted small text-center mb-4">
                    Mã xác thực gồm <strong>6 chữ số</strong> đã được gửi tới hộp thư Gmail:<br />
                    <span class="text-light fw-semibold">@Model.Email</span><br />
                    <span class="text-secondary">(Tài khoản sẽ được tạo ngay sau khi bạn xác thực thành công)</span>
                </p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

                <form asp-action="VerifyRegistrationEmail" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label asp-for="OtpCode" class="form-label">Mã xác thực (OTP) *</label>
                        <input asp-for="OtpCode"
                               class="form-control text-center fw-bold fs-4"
                               style="background:#2a2a2a; border-color:#444; color:#fff; letter-spacing:8px;"
                               placeholder="000000"
                               maxlength="6"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               id="otp-input" />
                        <span asp-validation-for="OtpCode" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-danger fw-bold py-2" id="verify-otp-btn">
                            <i class="bi bi-check2-circle me-1"></i> Xác thực &amp; Tạo tài khoản
                        </button>
                    </div>
                </form>

                <form asp-action="ResendRegistrationOtp" method="post" class="text-center mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@Model.Email" />
                    <button type="submit" class="btn btn-link text-danger small text-decoration-none p-0">
                        <i class="bi bi-arrow-clockwise"></i> Không nhận được mã? Gửi lại mã xác thực
                    </button>
                </form>

                <hr style="border-color:#444" />
                <div class="text-center">
                    <a asp-controller="Account" asp-action="Register" class="text-muted small text-decoration-none">
                        <i class="bi bi-arrow-left"></i> Đổi địa chỉ Gmail / Quay lại trang đăng ký
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const vs = document.querySelector('[data-valmsg-summary]');
            if (vs && vs.querySelector('li') && vs.querySelector('li').textContent.trim() !== '') {
                vs.style.display = 'block';
            }
            const otpInput = document.getElementById('otp-input');
            if (otpInput) {
                otpInput.focus();
                otpInput.addEventListener('input', function () {
                    this.value = this.value.replace(/\D/g, '').slice(0, 6);
                });
            }
        });
    </script>
}

