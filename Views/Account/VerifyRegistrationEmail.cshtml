@model VerifyRegistrationEmailViewModel
@{
    ViewData["Title"] = "Xác thực Email đăng ký";
}

<section class="ch-auth-stage">
    <div class="ch-auth-dossier ch-auth-dossier-narrow cinema-spotlight">
        <div class="ch-auth-plate-bar">
            <span><i class="bi bi-envelope-check me-1"></i> Xác thực Email</span>
            <span>Bước 2 / 2</span>
        </div>

        <div class="ch-auth-form-wing">
            <div class="text-center mb-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:56px;height:56px;border-radius:14px;background:rgba(245,158,11,0.14);border:1px solid var(--gold);color:var(--gold);font-size:1.5rem;">
                    <i class="bi bi-envelope-check-fill"></i>
                </div>
                <h1 class="ch-auth-form-title">Xác Thực Mã OTP</h1>
                <p class="ch-auth-form-sub mb-0">
                    Mã xác thực 6 chữ số đã được gửi tới <strong style="color:var(--text-main);">@Model.Email</strong>
                </p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="p-3 mb-3" style="background:rgba(16,185,129,0.14);border:1px solid rgba(16,185,129,0.45);border-radius:10px;color:#6ee7b7;font-size:0.86rem;">
                    @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="p-3 mb-3" style="background:rgba(229,57,53,0.14);border:1px solid rgba(229,57,53,0.5);border-radius:10px;color:#fca5a5;font-size:0.86rem;">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="VerifyRegistrationEmail" method="post" class="mb-3">
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-4">
                    <label asp-for="OtpCode" class="ch-auth-label text-center">Mã xác thực OTP (6 chữ số)</label>
                    <input asp-for="OtpCode"
                           maxlength="6"
                           class="ch-auth-input-standalone text-center fw-bolder"
                           style="font-size:1.65rem;letter-spacing:0.35em;color:var(--gold) !important;"
                           placeholder="000000" />
                    <span asp-validation-for="OtpCode" class="text-danger small"></span>
                </div>

                <button type="submit" class="ch-auth-btn-primary">
                    <i class="bi bi-shield-check"></i>
                    <span>Xác nhận &amp; kích hoạt tài khoản</span>
                </button>
            </form>

            <form asp-action="ResendRegistrationOtp" method="post" class="text-center pt-3" style="border-top:1px solid var(--border-glass);">
                <input type="hidden" name="email" value="@Model.Email" />
                <button type="submit" class="btn btn-link p-0 ch-auth-link" style="font-size:0.85rem;">
                    <i class="bi bi-arrow-repeat me-1"></i> Chưa nhận được mã? Gửi lại mã OTP mới
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) window.location.reload();
        });
        document.addEventListener('DOMContentLoaded', function () {
            var anySubmitting = false;
            document.querySelectorAll('section.ch-auth-stage form[method="post"]').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    if (anySubmitting) {
                        e.preventDefault();
                        return;
                    }
                    if (e.defaultPrevented) return;
                    if (form.checkValidity && !form.checkValidity()) return;
                    if (typeof jQuery !== 'undefined' && jQuery.fn.valid && jQuery(form).data('validator') && !jQuery(form).valid()) {
                        return;
                    }
                    anySubmitting = true;
                    document.querySelectorAll('section.ch-auth-stage form[method="post"] button[type="submit"]').forEach(function (b) {
                        b.disabled = true;
                    });
                    var btn = form.querySelector('button[type="submit"]');
                    if (btn) {
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Đang xử lý...</span>';
                    }
                });
            });
        });
    </script>
}
