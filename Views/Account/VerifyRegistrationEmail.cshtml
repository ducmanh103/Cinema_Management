@model VerifyRegistrationEmailViewModel
@{
    ViewData["Title"] = "Xác Thực Email Đăng Ký";
}

<div class="py-5 my-4">
    <div class="mx-auto p-4 p-md-5 rounded-5 cinema-spotlight"
         style="max-width:540px;background:rgba(13,19,36,0.9);border:1px solid rgba(255,255,255,0.12);box-shadow:0 30px 70px rgba(0,0,0,0.65);">
        <div class="text-center mb-4">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                 style="width:68px;height:68px;background:rgba(56,189,248,0.15);border:1px solid rgba(56,189,248,0.4);color:#38BDF8;font-size:2rem;">
                <i class="bi bi-envelope-check-fill"></i>
            </div>
            <h3 class="text-white fw-bolder mb-1" style="font-family:'Space Grotesk',sans-serif;">Xác Thực Mã OTP</h3>
            <p class="text-white-50 small mb-0">
                Chúng tôi đã gửi mã OTP 6 chữ số tới email <strong class="text-white">@Model.Email</strong>
            </p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 py-2 px-3 small mb-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 py-2 px-3 small mb-3">@TempData["Error"]</div>
        }

        <form asp-action="VerifyRegistrationEmail" method="post" class="mb-3">
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label asp-for="OtpCode" class="form-label text-white-50 small fw-bold text-uppercase">Mã xác thực OTP (6 chữ số)</label>
                <input asp-for="OtpCode"
                       maxlength="6"
                       class="form-control bg-transparent border-secondary border-opacity-25 text-white text-center fw-bolder py-3 font-monospace"
                       style="font-size:1.5rem;letter-spacing:0.35em;"
                       placeholder="000000" />
                <span asp-validation-for="OtpCode" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn w-100 rounded-4 py-3 fw-bold text-white"
                    style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                <i class="bi bi-shield-check me-1"></i> Xác Nhận &amp; Kích Hoạt Tài Khoản
            </button>
        </form>

        <form asp-action="ResendRegistrationOtp" method="post" class="text-center">
            <input type="hidden" name="email" value="@Model.Email" />
            <button type="submit" class="btn btn-link text-info text-decoration-none small fw-semibold">
                <i class="bi bi-arrow-repeat me-1"></i> Chưa nhận được mã? Gửi lại mã OTP mới
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
