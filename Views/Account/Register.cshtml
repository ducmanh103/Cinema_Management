@model CinemaManagement.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card" style="background:#1e1e1e; border:1px solid #333">
            <div class="card-body p-4">
                <h3 class="text-center mb-4" style="color:#e50914"><i class="bi bi-person-plus"></i> Tạo tài khoản</h3>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Tên đăng nhập *</label>
                        <input asp-for="Username" class="form-control" style="background:#2a2a2a; border-color:#444; color:#fff"
                               placeholder="Tối thiểu 3 ký tự" id="reg-username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Họ và tên</label>
                        <input asp-for="FullName" class="form-control" style="background:#2a2a2a; border-color:#444; color:#fff"
                               placeholder="Họ tên đầy đủ" id="reg-fullname" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" type="email" style="background:#2a2a2a; border-color:#444; color:#fff"
                               placeholder="example@email.com" id="reg-email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu *</label>
                        <input asp-for="Password" class="form-control" type="password" style="background:#2a2a2a; border-color:#444; color:#fff"
                               placeholder="Tối thiểu 6 ký tự" id="reg-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu *</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" style="background:#2a2a2a; border-color:#444; color:#fff"
                               placeholder="Nhập lại mật khẩu" id="reg-confirm" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger" id="register-btn">
                            <i class="bi bi-check-circle"></i> Đăng ký
                        </button>
                    </div>

                    <hr style="border-color:#444" />
                    <p class="text-center text-muted small">
                        Đã có tài khoản? <a asp-controller="Account" asp-action="Login" class="text-danger">Đăng nhập</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
