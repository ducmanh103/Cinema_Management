@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu Mới";
}

<div class="py-5 my-4">
    <div class="mx-auto p-4 p-md-5 rounded-5 cinema-spotlight"
         style="max-width:520px;background:rgba(13,19,36,0.9);border:1px solid rgba(255,255,255,0.12);box-shadow:0 30px 70px rgba(0,0,0,0.65);">
        <div class="text-center mb-4">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                 style="width:68px;height:68px;background:rgba(16,185,129,0.16);border:1px solid rgba(16,185,129,0.4);color:#34D399;font-size:2rem;">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h3 class="text-white fw-bolder mb-1" style="font-family:'Space Grotesk',sans-serif;">Tạo Mật Khẩu Mới</h3>
            <p class="text-white-50 small mb-0">Thiết lập mật khẩu mới cho tài khoản <strong class="text-white">@Model.Email</strong></p>
        </div>

        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label text-white-50 small fw-bold text-uppercase">Mật khẩu mới</label>
                <input asp-for="NewPassword" type="password" class="form-control bg-transparent border-secondary border-opacity-25 text-white py-2" placeholder="Nhập mật khẩu mới" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label text-white-50 small fw-bold text-uppercase">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control bg-transparent border-secondary border-opacity-25 text-white py-2" placeholder="Nhập lại mật khẩu mới" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn w-100 rounded-4 py-3 fw-bold text-white mt-2"
                    style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                <i class="bi bi-check2-circle me-1"></i> Lưu Mật Khẩu Mới
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
