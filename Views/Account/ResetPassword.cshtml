@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu mới";
}

<section class="ch-auth-stage">
    <div class="ch-auth-dossier ch-auth-dossier-narrow cinema-spotlight">
        <div class="ch-auth-plate-bar">
            <span><i class="bi bi-shield-lock me-1"></i> Đặt lại mật khẩu</span>
            <span>Bảo mật tài khoản</span>
        </div>

        <div class="ch-auth-form-wing">
            <div class="text-center mb-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:56px;height:56px;border-radius:14px;background:rgba(16,185,129,0.14);border:1px solid #10b981;color:#6ee7b7;font-size:1.5rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h1 class="ch-auth-form-title">Thiết Lập Mật Khẩu Mới</h1>
                <p class="ch-auth-form-sub mb-0">Cập nhật mật khẩu mới cho tài khoản <strong style="color:var(--text-main);">@Model.Email</strong></p>
            </div>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="ch-auth-label">Mật khẩu mới</label>
                    <input asp-for="NewPassword" type="password" class="ch-auth-input-standalone" placeholder="Nhập mật khẩu mới" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="ch-auth-label">Xác nhận mật khẩu mới</label>
                    <input asp-for="ConfirmPassword" type="password" class="ch-auth-input-standalone" placeholder="Nhập lại mật khẩu mới" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="ch-auth-btn-primary">
                    <i class="bi bi-check2-circle"></i>
                    <span>Lưu mật khẩu mới</span>
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) window.location.reload();
        });
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('section.ch-auth-stage form[method="post"]').forEach(function (form) {
                var isSubmitting = false;
                form.addEventListener('submit', function (e) {
                    if (isSubmitting) {
                        e.preventDefault();
                        return;
                    }
                    if (e.defaultPrevented) return;
                    if (form.checkValidity && !form.checkValidity()) return;
                    if (typeof jQuery !== 'undefined' && jQuery.fn.valid && jQuery(form).data('validator') && !jQuery(form).valid()) {
                        return;
                    }
                    isSubmitting = true;
                    var btn = form.querySelector('button[type="submit"]');
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Đang lưu...</span>';
                    }
                });
            });
        });
    </script>
}
