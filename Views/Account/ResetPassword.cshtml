@model CinemaManagement.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card" style="background:#1e1e1e; border:1px solid #333; border-radius:14px;">
            <div class="card-body p-4">
                <h3 class="text-center mb-3" style="color:#e50914">
                    <i class="bi bi-key-fill"></i> Đặt lại mật khẩu mới
                </h3>
                <p class="text-muted small text-center mb-4">
                    Mật khẩu mới cần tối thiểu 8 ký tự, bao gồm chữ hoa, chữ thường và chữ số.
                </p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />

                    <div class="mb-3">
                        <label class="form-label text-muted small">Tài khoản Email</label>
                        <input value="@Model.Email" class="form-control" style="background:#222; border-color:#333; color:#aaa" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                        <input asp-for="NewPassword" class="form-control" style="background:#2a2a2a; border-color:#444; color:#fff"
                               placeholder="Nhập mật khẩu mới (>= 8 ký tự)" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                        <input asp-for="ConfirmPassword" class="form-control" style="background:#2a2a2a; border-color:#444; color:#fff"
                               placeholder="Nhập lại mật khẩu mới" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" id="reset-submit-btn" class="btn btn-danger fw-bold py-2">
                            <i class="bi bi-check2-circle me-1"></i> Lưu mật khẩu mới
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const vs = document.querySelector('[data-valmsg-summary]');
            if (vs && vs.querySelector('li') && vs.querySelector('li').textContent.trim() !== '') {
                vs.style.display = 'block';
            }
            const form = document.querySelector('form');
            const btn = document.getElementById('reset-submit-btn');
            if (form && btn) {
                form.addEventListener('submit', function () {
                    if ($(form).valid()) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
                    }
                });
            }
        });
    </script>
}

