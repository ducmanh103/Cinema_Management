@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<section class="ch-auth-stage">
    <div class="ch-auth-dossier ch-auth-dossier-narrow cinema-spotlight text-center">
        <div class="ch-auth-plate-bar">
            <span><i class="bi bi-shield-slash me-1"></i> Giới hạn quyền truy cập</span>
            <span>Mã lỗi 403</span>
        </div>

        <div class="ch-auth-form-wing">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                 style="width:64px;height:64px;border-radius:16px;background:rgba(229,57,53,0.16);border:1px solid var(--primary);color:var(--primary);font-size:1.85rem;">
                <i class="bi bi-shield-slash-fill"></i>
            </div>
            <h1 class="ch-auth-form-title">Khu Vực Dành Cho Quản Trị Viên</h1>
            <p class="ch-auth-form-sub">
                Tài khoản hiện tại của bạn không có quyền truy cập vào khu vực quản trị này.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                <a asp-controller="Home" asp-action="Index" class="ch-auth-btn-primary" style="width:auto;">
                    <i class="bi bi-house-door"></i>
                    <span>Về trang chủ</span>
                </a>
                <a asp-controller="Account" asp-action="Login" class="ch-auth-btn-secondary" style="width:auto;">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Đổi tài khoản</span>
                </a>
            </div>
        </div>
    </div>
</section>
