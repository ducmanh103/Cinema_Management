@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Khôi Phục Mật Khẩu";
}

<div class="py-5 my-4">
    <div class="mx-auto p-4 p-md-5 rounded-5 cinema-spotlight"
         style="max-width:520px;background:rgba(13,19,36,0.9);border:1px solid rgba(255,255,255,0.12);box-shadow:0 30px 70px rgba(0,0,0,0.65);">
        <div class="text-center mb-4">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                 style="width:68px;height:68px;background:rgba(245,185,66,0.16);border:1px solid rgba(245,185,66,0.4);color:#F5B942;font-size:2rem;">
                <i class="bi bi-key-fill"></i>
            </div>
            <h3 class="text-white fw-bolder mb-1" style="font-family:'Space Grotesk',sans-serif;">Quên Mật Khẩu?</h3>
            <p class="text-white-50 small mb-0">Nhập địa chỉ email đã đăng ký để nhận liên kết đặt lại mật khẩu mới.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 py-2 px-3 small mb-3">@TempData["Success"]</div>
        }

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-white-50 small fw-bold text-uppercase">Email tài khoản</label>
                <input asp-for="Email" type="email" class="form-control bg-transparent border-secondary border-opacity-25 text-white py-2" placeholder="email@domain.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn w-100 rounded-4 py-3 fw-bold text-white"
                    style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                <i class="bi bi-send-fill me-1"></i> Gửi Liên Kết Khôi Phục
            </button>
        </form>

        <div class="text-center mt-4">
            <a asp-action="Login" class="text-white-50 text-decoration-none small">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang Đăng nhập
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
