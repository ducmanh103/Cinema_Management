@model CinemaManagement.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card" style="background:#1e1e1e; border:1px solid #333; border-radius:14px;">
            <div class="card-body p-4">
                <h3 class="text-center mb-3" style="color:#e50914">
                    <i class="bi bi-shield-lock"></i> Khôi phục mật khẩu
                </h3>
                <p class="text-muted small text-center mb-4">
                    Nhập địa chỉ email đã đăng ký tài khoản CinemaHub. Hệ thống sẽ gửi liên kết đặt lại mật khẩu có hiệu lực trong 15 phút.
                </p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Địa chỉ Email</label>
                        <input asp-for="Email" class="form-control" style="background:#2a2a2a; border-color:#444; color:#fff"
                               placeholder="example@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-danger fw-bold py-2">
                            <i class="bi bi-envelope-paper me-1"></i> Gửi liên kết đặt lại mật khẩu
                        </button>
                    </div>

                    <div class="text-center">
                        <a asp-controller="Account" asp-action="Login" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Quay lại trang đăng nhập
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

