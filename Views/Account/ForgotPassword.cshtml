@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="ch-auth-stage">
    <div class="ch-auth-dossier ch-auth-dossier-narrow cinema-spotlight">
        <div class="ch-auth-plate-bar">
            <span><i class="bi bi-key me-1"></i> Khôi phục mật khẩu</span>
            <span>Hỗ trợ thành viên CinemaHub</span>
        </div>

        <div class="ch-auth-form-wing">
            <div class="text-center mb-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:56px;height:56px;border-radius:14px;background:rgba(245,158,11,0.14);border:1px solid var(--gold);color:var(--gold);font-size:1.5rem;">
                    <i class="bi bi-key-fill"></i>
                </div>
                <h1 class="ch-auth-form-title">Khôi Phục Mật Khẩu</h1>
                <p class="ch-auth-form-sub mb-0">Nhập địa chỉ Email đã đăng ký để nhận liên kết đặt lại mật khẩu mới.</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="p-3 mb-3" style="background:rgba(16,185,129,0.14);border:1px solid rgba(16,185,129,0.45);border-radius:10px;color:#6ee7b7;font-size:0.86rem;">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="ch-auth-label">Email tài khoản</label>
                    <input asp-for="Email" type="email" class="ch-auth-input-standalone" placeholder="email@domain.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="ch-auth-btn-primary">
                    <i class="bi bi-send-fill"></i>
                    <span>Gửi liên kết khôi phục</span>
                </button>
            </form>

            <div class="text-center mt-4 pt-3" style="border-top:1px solid var(--border-glass);">
                <a asp-action="Login" class="ch-auth-link" style="font-size:0.85rem;">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại trang Đăng nhập
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
