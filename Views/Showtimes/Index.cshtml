@using CinemaManagement.Models.ViewModels
@model List<ShowtimeDto>
@{
    ViewData["Title"] = "Lịch Chiếu";
    Layout = "_Layout";
    var movieTitle = ViewBag.MovieTitle as string;
    
    // Group showtimes by Theater, then by Date
    var groupedShowtimes = Model
        .GroupBy(s => s.TheaterName)
        .OrderBy(g => g.Key)
        .ToDictionary(
            g => g.Key, 
            g => g.GroupBy(s => s.StartTime.Date).OrderBy(d => d.Key).ToList()
        );
}

<style>
.theater-block {
    background: rgba(30, 30, 30, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
}
.theater-name {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-main);
    border-left: 4px solid var(--primary);
    padding-left: 12px;
    margin-bottom: 16px;
}
.date-header {
    font-size: 1.1rem;
    font-weight: 600;
    color: #bbb;
    margin-bottom: 12px;
    margin-top: 20px;
    border-bottom: 1px solid #333;
    padding-bottom: 8px;
}
.showtime-pill {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #2a2a2a;
    border: 1px solid #444;
    border-radius: 8px;
    min-width: 90px;
    padding: 10px 15px;
    color: #fff;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.showtime-pill:hover {
    background: var(--primary);
    border-color: var(--primary-hover);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(229, 9, 20, 0.3);
}
.showtime-pill.disabled {
    background: #1a1a1a;
    border-color: #333;
    color: #666;
    pointer-events: none;
    text-decoration: line-through;
}
.time-text {
    font-size: 1.25rem;
    font-weight: 700;
}
.room-text {
    font-size: 0.75rem;
    color: #aaa;
    margin-top: 4px;
}
.showtime-pill:hover .room-text {
    color: #ddd;
}
</style>

<div class="mb-5 text-center mt-3">
    <h2 class="display-6 fw-bold text-uppercase" style="text-shadow: 0 2px 10px rgba(229,9,20,0.5);">
        @if (movieTitle != null)
        {
            <span class="text-light">Lịch Chiếu Phim</span><br/>
            <span style="color: var(--primary);">@movieTitle</span>
        }
        else
        {
            <span style="color: var(--primary);">Tất cả Lịch Chiếu</span>
        }
    </h2>
    <p class="text-muted">Chọn thời gian và rạp chiếu phù hợp với bạn</p>
</div>

@if (!Model.Any())
{
    <div class="text-center mt-5 p-5 glass rounded-4">
        <i class="bi bi-calendar-x" style="font-size:4rem; color: #555;"></i>
        <h4 class="mt-3">Chưa có lịch chiếu</h4>
        <p class="text-muted">Hiện tại phim chưa có lịch chiếu cụ thể. Vui lòng quay lại sau.</p>
        <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-light mt-3 rounded-pill px-4">
            <i class="bi bi-arrow-left"></i> Khám phá phim khác
        </a>
    </div>
}
else
{
    foreach (var theater in groupedShowtimes)
    {
        <div class="theater-block">
            <h3 class="theater-name">@theater.Key</h3>
            
            @foreach (var dateGroup in theater.Value)
            {
                <div class="date-header">
                    <i class="bi bi-calendar-check me-2 text-primary-custom"></i> 
                    @dateGroup.Key.ToString("dd/MM/yyyy") - @(dateGroup.Key.Date == DateTime.Today ? "Hôm nay" : dateGroup.Key.ToString("dddd"))
                </div>
                
                <!-- Group by Movie if viewing all showtimes -->
                @if (movieTitle == null)
                {
                    var showtimesByMovie = dateGroup.GroupBy(s => s.MovieTitle).OrderBy(g => g.Key);
                    foreach (var movieGroup in showtimesByMovie)
                    {
                        <h6 class="mt-3 text-light fw-bold ms-2">@movieGroup.Key</h6>
                        <div class="d-flex flex-wrap gap-3 mb-3 ms-3">
                            @foreach (var st in movieGroup)
                            {
                                if (st.AvailableSeats > 0)
                                {
                                    <a asp-controller="Booking" asp-action="SelectSeat" asp-route-id="@st.ShowtimeId" 
                                       class="showtime-pill" title="Còn @st.AvailableSeats ghế trống | Giá: @st.Price.ToString("N0") VNĐ">
                                        <span class="time-text">@st.StartTime.ToString("HH:mm")</span>
                                        <span class="room-text">@st.RoomName</span>
                                    </a>
                                }
                                else
                                {
                                    <div class="showtime-pill disabled" title="Đã hết vé">
                                        <span class="time-text">@st.StartTime.ToString("HH:mm")</span>
                                        <span class="room-text">Hết ghế</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var st in dateGroup)
                        {
                            if (st.AvailableSeats > 0)
                            {
                                <a asp-controller="Booking" asp-action="SelectSeat" asp-route-id="@st.ShowtimeId" 
                                   class="showtime-pill" title="Còn @st.AvailableSeats ghế trống | Giá: @st.Price.ToString("N0") VNĐ">
                                    <span class="time-text">@st.StartTime.ToString("HH:mm")</span>
                                    <span class="room-text">@st.RoomName</span>
                                </a>
                            }
                            else
                            {
                                <div class="showtime-pill disabled" title="Đã hết vé">
                                    <span class="time-text">@st.StartTime.ToString("HH:mm")</span>
                                    <span class="room-text">Hết ghế</span>
                                </div>
                            }
                        }
                    </div>
                }
            }
        </div>
    }
}
