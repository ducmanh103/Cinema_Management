@model List<ShowtimeDto>
@using CinemaManagement.Helpers
@{
    ViewData["Title"] = "Lịch Chiếu & Đặt Vé";
    ViewBag.FullWidth = true;

    int? selectedMovieId = ViewBag.MovieId as int?;
    int? selectedTheaterId = ViewBag.SelectedTheaterId as int?;
    DateTime? selectedDate = ViewBag.SelectedDate as DateTime?;
    var activeMovie = ViewBag.ActiveMovie as CinemaManagement.Models.Movie;
    var movieInfoDict = ViewBag.MovieInfoDict as Dictionary<string, CinemaManagement.Models.Movie> ?? new Dictionary<string, CinemaManagement.Models.Movie>();
    var theaters = ViewBag.Theaters as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    var today = VietnamTime.Today;
    var dateList = Enumerable.Range(0, 14).Select(offset => today.AddDays(offset)).ToList();
    string[] dayNames = { "CN", "Th 2", "Th 3", "Th 4", "Th 5", "Th 6", "Th 7" };
}

<style>
    .st-hero {
        padding: 48px 0 36px;
        background:
            radial-gradient(circle at 80% 15%, rgba(255, 46, 85, 0.16), transparent 45%),
            radial-gradient(circle at 20% 80%, rgba(56, 189, 248, 0.12), transparent 50%),
            #050711;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .st-container {
        max-width: 1380px;
        margin: 0 auto;
        padding: 0 24px;
    }
    /* 14-day Capsule Scroller */
    .st-date-scroller {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 8px 2px 14px;
        scrollbar-width: thin;
    }
    .st-date-pill {
        min-width: 82px;
        padding: 12px 14px;
        border-radius: 18px;
        background: rgba(15, 22, 41, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #CBD5E1;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        flex-shrink: 0;
        transition: all 0.25s ease;
    }
    .st-date-pill:hover {
        border-color: rgba(255, 46, 85, 0.45);
        transform: translateY(-3px);
        color: #fff;
    }
    .st-date-pill.active {
        background: linear-gradient(135deg, #FF2E55, #FF6B35);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 12px 26px rgba(255, 46, 85, 0.38);
    }
    .st-date-dow { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; opacity: 0.85; }
    .st-date-num { font-family: 'Space Grotesk', sans-serif; font-size: 1.35rem; font-weight: 800; line-height: 1.1; }
    .st-date-mon { font-size: 0.7rem; opacity: 0.75; }

    /* Theater Filter Bar */
    .st-theater-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 16px;
    }
    .st-theater-pill {
        min-height: 42px;
        padding: 8px 18px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #CBD5E1;
        font-size: 0.84rem;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.22s ease;
    }
    .st-theater-pill:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }
    .st-theater-pill.active {
        background: rgba(56, 189, 248, 0.16);
        border-color: #38BDF8;
        color: #38BDF8;
    }

    /* Movie Showtime Card */
    .st-movie-block {
        margin-bottom: 28px;
        padding: 26px;
        border-radius: 26px;
        background: rgba(15, 22, 41, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(18px);
    }
    .st-movie-layout {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 28px;
    }
    .st-movie-poster {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 18px;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55);
    }
    /* Perforated Mini-Ticket Slot */
    .st-slot-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 12px;
    }
    .st-slot-ticket {
        position: relative;
        min-width: 138px;
        padding: 12px 16px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .st-slot-ticket:hover {
        transform: translateY(-4px);
        background: linear-gradient(135deg, rgba(255, 46, 85, 0.2), rgba(255, 107, 53, 0.16));
        border-color: #FF2E55;
        box-shadow: 0 12px 26px rgba(255, 46, 85, 0.28);
    }
    .st-slot-time {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.15rem;
        font-weight: 800;
        color: #F8FAFC;
    }
    .st-slot-room {
        font-size: 0.72rem;
        color: #38BDF8;
        font-weight: 700;
        margin-top: 2px;
    }
    .st-slot-price {
        font-size: 0.74rem;
        color: #F5B942;
        font-weight: 700;
        margin-top: 4px;
        padding-top: 4px;
        border-top: 1px dashed rgba(255, 255, 255, 0.14);
        width: 100%;
        text-align: center;
    }
    @@media (max-width: 767.98px) {
        .st-hero { padding: 28px 0 24px; }
        .st-container { padding: 0 14px; }
        .st-date-pill { min-width: 70px; padding: 10px; border-radius: 14px; }
        .st-date-num { font-size: 1.15rem; }
        .st-theater-bar {
            flex-wrap: nowrap;
            overflow-x: auto;
            padding-bottom: 6px;
            scrollbar-width: none;
        }
        .st-theater-bar::-webkit-scrollbar { display: none; }
        .st-theater-pill {
            white-space: nowrap;
            flex-shrink: 0;
            min-height: 38px;
            padding: 6px 14px;
            font-size: 0.78rem;
        }
        .st-movie-block { padding: 16px 14px; border-radius: 20px; margin-bottom: 18px; }
        .st-movie-layout { grid-template-columns: 1fr; gap: 16px; }
        .st-movie-poster { max-width: 130px; border-radius: 14px; }
        .st-slot-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(105px, 1fr));
            gap: 8px;
        }
        .st-slot-ticket {
            min-width: 0;
            width: 100%;
            padding: 10px 8px;
            border-radius: 12px;
        }
        .st-slot-time { font-size: 1rem; }
    }
</style>

<section class="st-hero">
    <div class="st-container">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4" data-animate="fade-up">
            <div>
                <span class="ch-eyebrow mb-2"><i class="bi bi-calendar2-week-fill"></i> Lịch Chiếu Thời Gian Thực</span>
                <h1 class="text-white fw-bolder mb-1" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(1.9rem,3.4vw,2.8rem);">
                    @(activeMovie != null ? $"Lịch Chiếu: {activeMovie.Title}" : "Lịch Chiếu & Chọn Suất")
                </h1>
                <p class="text-white-50 mb-0">Chọn ngày chiếu, cụm rạp và khung giờ thuận tiện nhất để giữ ghế đẹp ngay lập tức.</p>
            </div>
            @if (selectedMovieId.HasValue || selectedDate.HasValue || selectedTheaterId.HasValue)
            {
                <a asp-action="Index" class="btn rounded-pill px-4 py-2 fw-bold text-white"
                   style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Xem Tất Cả Lịch Chiếu
                </a>
            }
        </div>

        <!-- 14-Day Capsule Calendar -->
        <div class="st-date-scroller" data-animate="fade-up" data-delay="60">
            <a asp-action="Index"
               asp-route-movieId="@selectedMovieId"
               asp-route-theaterId="@selectedTheaterId"
               class="st-date-pill @(!selectedDate.HasValue ? "active" : "")">
                <span class="st-date-dow">Tất cả</span>
                <span class="st-date-num"><i class="bi bi-calendar3"></i></span>
                <span class="st-date-mon">Mọi ngày</span>
            </a>

            @foreach (var d in dateList)
            {
                bool isActive = selectedDate.HasValue && selectedDate.Value.Date == d.Date;
                string dow = d.Date == today ? "Hôm nay" : dayNames[(int)d.DayOfWeek];
                <a asp-action="Index"
                   asp-route-movieId="@selectedMovieId"
                   asp-route-theaterId="@selectedTheaterId"
                   asp-route-date="@d.ToString("yyyy-MM-dd")"
                   class="st-date-pill @(isActive ? "active" : "")">
                    <span class="st-date-dow">@dow</span>
                    <span class="st-date-num">@d.ToString("dd")</span>
                    <span class="st-date-mon">Tháng @d.ToString("MM")</span>
                </a>
            }
        </div>

        <!-- Theater Pills (No Emojis - Clean Bootstrap Icons) -->
        <div class="st-theater-bar" data-animate="fade-up" data-delay="100">
            <a asp-action="Index"
               asp-route-movieId="@selectedMovieId"
               asp-route-date="@(selectedDate?.ToString("yyyy-MM-dd"))"
               class="st-theater-pill @(!selectedTheaterId.HasValue ? "active" : "")">
                <i class="bi bi-buildings-fill"></i> Tất Cả Cụm Rạp
            </a>
            @foreach (var th in theaters)
            {
                bool isThActive = selectedTheaterId.HasValue && selectedTheaterId.Value == (int)th.TheaterId;
                <a asp-action="Index"
                   asp-route-movieId="@selectedMovieId"
                   asp-route-date="@(selectedDate?.ToString("yyyy-MM-dd"))"
                   asp-route-theaterId="@th.TheaterId"
                   class="st-theater-pill @(isThActive ? "active" : "")">
                    <i class="bi bi-geo-alt-fill"></i> @th.TheaterName
                </a>
            }
        </div>
    </div>
</section>

<section class="st-container py-5">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <div class="p-5 rounded-4 mx-auto" style="max-width:540px;background:rgba(15,22,41,0.75);border:1px solid rgba(255,255,255,0.08);">
                <i class="bi bi-calendar-x fs-1 text-danger d-block mb-3"></i>
                <h4 class="text-white fw-bold">Chưa có suất chiếu trong khung lọc này</h4>
                <p class="text-white-50 mb-4">Vui lòng chọn ngày chiếu khác hoặc xem toàn bộ lịch chiếu của các cụm rạp CinemaHub.</p>
                <a asp-action="Index" class="btn rounded-pill px-4 py-2 fw-bold text-white"
                   style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                    <i class="bi bi-calendar2-week me-1"></i> Xem Toàn Bộ Suất Chiếu
                </a>
            </div>
        </div>
    }
    else
    {
        var groupedByMovie = Model.GroupBy(s => s.MovieTitle).ToList();
        foreach (var movieGroup in groupedByMovie)
        {
            var mTitle = movieGroup.Key;
            movieInfoDict.TryGetValue(mTitle, out var mObj);
            var posterUrl = mObj?.PosterUrl ?? "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=600";
            var ageClass = MovieDisplayHelper.GetAgeBadgeClass(mTitle);
            var ageText = MovieDisplayHelper.GetAgeBadgeText(mTitle);
            var format = MovieDisplayHelper.GetMovieFormat(mTitle);

            <div class="st-movie-block cinema-spotlight" data-animate="fade-up">
                <div class="st-movie-layout">
                    <div>
                        <img src="@posterUrl"
                             alt="@mTitle"
                             class="st-movie-poster"
                             onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=600'" />
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="badge @ageClass rounded-pill px-3 py-1 fw-bold">@ageText</span>
                            <span class="badge rounded-pill px-3 py-1" style="background:rgba(56,189,248,0.14);color:#38BDF8;border:1px solid rgba(56,189,248,0.3);">@format</span>
                            @if (mObj != null)
                            {
                                <span class="text-white-50 small"><i class="bi bi-clock me-1 text-info"></i>@mObj.Duration phút</span>
                            }
                        </div>

                        <h3 class="text-white fw-bold mb-3" style="font-family:'Space Grotesk',sans-serif;">
                            @if (mObj != null)
                            {
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@mObj.MovieId" class="text-white text-decoration-none">@mTitle</a>
                            }
                            else
                            {
                                @mTitle
                            }
                        </h3>

                        @foreach (var theaterGroup in movieGroup.GroupBy(s => s.TheaterName))
                        {
                            <div class="mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                                <div class="d-flex align-items-center gap-2 text-white fw-bold mb-2">
                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                    <span>@theaterGroup.Key</span>
                                </div>
                                <div class="st-slot-grid">
                                    @foreach (var st in theaterGroup.OrderBy(x => x.StartTime))
                                    {
                                        <a asp-controller="Booking"
                                           asp-action="SelectSeat"
                                           asp-route-id="@st.ShowtimeId"
                                           asp-route-showtimeId="@st.ShowtimeId"
                                           class="st-slot-ticket">
                                            <span class="st-slot-time">@st.StartTime.ToString("HH:mm")</span>
                                            <span class="st-slot-room">@st.RoomName • @st.StartTime.ToString("dd/MM")</span>
                                            <span class="st-slot-price">@st.Price.ToString("N0") ₫</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</section>
