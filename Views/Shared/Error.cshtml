@model ErrorViewModel
@{
    ViewData["Title"] = "Đã Xảy Ra Sự Cố";
}

<div class="py-5 my-5 text-center">
    <div class="mx-auto p-5 rounded-5 cinema-spotlight"
         style="max-width:560px;background:rgba(15,22,41,0.88);border:1px solid rgba(255,255,255,0.12);">
        <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
             style="width:76px;height:76px;background:rgba(255,46,85,0.16);color:#FF8FA3;font-size:2.2rem;">
            <i class="bi bi-exclamation-octagon-fill"></i>
        </div>
        <h2 class="text-white fw-bolder mb-2" style="font-family:'Space Grotesk',sans-serif;">Đã Xảy Ra Sự Cố Ngoài Ý Muốn</h2>
        <p class="text-white-50 small mb-4">
            Hệ thống đang xử lý yêu cầu của bạn. Vui lòng thử lại hoặc quay về trang chủ CinemaHub.
        </p>
        @if (Model?.ShowRequestId == true)
        {
            <div class="p-2 rounded-3 mb-4 small text-white-50 font-monospace" style="background:rgba(255,255,255,0.04);">
                Request ID: <strong class="text-white">@Model.RequestId</strong>
            </div>
        }
        <a asp-controller="Home" asp-action="Index" class="btn rounded-pill px-4 py-2 fw-bold text-white"
           style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
            <i class="bi bi-house-door-fill me-1"></i> Về Trang Chủ CinemaHub
        </a>
    </div>
</div>
