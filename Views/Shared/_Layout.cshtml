<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 🎬 CinemaHub</title>
    <!-- Google Fonts already imported in site.css -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .navbar-custom {
            background: rgba(15, 15, 15, 0.85) !important;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            transition: all 0.3s ease;
        }
        .navbar-brand {
            color: var(--primary) !important;
            font-weight: 900;
            font-size: 1.6rem;
            letter-spacing: 1.5px;
            text-shadow: 0 0 10px rgba(229, 9, 20, 0.5);
        }
        .nav-link {
            color: #ccc !important;
            font-weight: 500;
            letter-spacing: 0.5px;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .nav-link:hover {
            color: #fff !important;
            background: rgba(255,255,255,0.08);
        }
        .nav-link.active {
            color: var(--primary) !important;
            font-weight: 600;
            background: rgba(229, 9, 20, 0.1);
        }
        .nav-item { margin-right: 0.2rem; }
        
        .footer-custom {
            background: linear-gradient(to top, #000, #0a0a0a);
            border-top: 1px solid #222;
        }
        .footer-heading {
            color: #fff;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        .footer-link {
            color: #888;
            text-decoration: none;
            display: block;
            margin-bottom: 0.5rem;
            transition: color 0.2s;
        }
        .footer-link:hover { color: var(--primary); }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand me-5" asp-controller="Home" asp-action="Index">CINEMAHUB</a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navCollapse">
                    <ul class="navbar-nav me-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Movies" ? "active" : "")" 
                               asp-controller="Movies" asp-action="Index"><i class="bi bi-film me-1"></i> Phim đang chiếu</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Booking" ? "active" : "")" 
                                   asp-controller="Booking" asp-action="MyTickets"><i class="bi bi-ticket-perforated me-1"></i> Vé của tôi</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="nav-link text-warning" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i> Admin Dashboard
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center mt-3 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown" style="background: rgba(255,255,255,0.05); border-radius: 50px; padding-left: 1rem !important; padding-right: 1.2rem !important;">
                                    <div style="width: 28px; height: 28px; background: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 0.9rem;">
                                        @((User.FindFirst("FullName")?.Value ?? User.Identity.Name?[0].ToString() ?? "U").Substring(0,1).ToUpper())
                                    </div>
                                    <span>@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg" style="background:#1a1a1a; border: 1px solid #333; border-radius: 12px; margin-top: 10px;">
                                    <li><h6 class="dropdown-header text-muted">Tài khoản</h6></li>
                                    <li><a class="dropdown-item text-light" href="#"><i class="bi bi-person me-2"></i> Hồ sơ</a></li>
                                    <li><a class="dropdown-item text-light" asp-controller="Booking" asp-action="MyTickets"><i class="bi bi-ticket me-2"></i> Lịch sử đặt vé</a></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button class="dropdown-item text-danger fw-bold" type="submit"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-primary-custom px-4 rounded-pill fw-bold" asp-controller="Account" asp-action="Register">
                                    Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050; margin-top: 70px;">
            <div class="alert alert-success alert-dismissible fade show shadow-lg" role="alert" style="background: rgba(26, 58, 26, 0.95); border-color: #28a745; color: #a5d6a7; border-radius: 10px; backdrop-filter: blur(10px);">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                    <div>
                        <strong>Thành công!</strong><br />
                        @TempData["Success"]
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050; margin-top: 70px;">
            <div class="alert alert-danger alert-dismissible fade show shadow-lg" role="alert" style="background: rgba(58, 26, 26, 0.95); border-color: var(--primary); color: #ef9a9a; border-radius: 10px; backdrop-filter: blur(10px);">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                    <div>
                        <strong>Thông báo!</strong><br />
                        @TempData["Error"]
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    }

    <!-- Nội dung chính -->
    <main role="main" class="flex-grow-1">
        <!-- RenderBody cho các trang có container tự định nghĩa (như trang chủ) -->
        @if (ViewData["Title"]?.ToString() == "Trang Chủ")
        {
            @RenderBody()
        }
        else
        {
            <div class="container py-5">
                @RenderBody()
            </div>
        }
    </main>

    <!-- Footer hiện đại -->
    <footer class="footer-custom pt-5 pb-3 mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h4 class="navbar-brand mb-3 d-inline-block">CINEMAHUB</h4>
                    <p class="text-muted pe-lg-4">Hệ thống đặt vé xem phim trực tuyến hàng đầu, mang đến trải nghiệm điện ảnh tuyệt vời nhất với giao diện thân thiện và quy trình nhanh chóng.</p>
                    <div class="d-flex gap-3">
                        <a href="#" class="btn btn-outline-light rounded-circle" style="width: 40px; height: 40px; padding: 0.4rem;"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-light rounded-circle" style="width: 40px; height: 40px; padding: 0.4rem;"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="btn btn-outline-light rounded-circle" style="width: 40px; height: 40px; padding: 0.4rem;"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Khám Phá</h5>
                    <a href="#" class="footer-link">Phim Đang Chiếu</a>
                    <a href="#" class="footer-link">Phim Sắp Chiếu</a>
                    <a href="#" class="footer-link">Lịch Chiếu</a>
                    <a href="#" class="footer-link">Khuyến Mãi</a>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">Hỗ Trợ</h5>
                    <a href="#" class="footer-link">Điều Khoản Sử Dụng</a>
                    <a href="#" class="footer-link">Chính Sách Bảo Mật</a>
                    <a href="#" class="footer-link">Câu Hỏi Thường Gặp</a>
                    <a href="#" class="footer-link">Trung Tâm Trợ Giúp</a>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">Liên Hệ</h5>
                    <p class="text-muted mb-2"><i class="bi bi-geo-alt me-2 text-primary-custom"></i> 123 Nguyễn Huệ, Quận 1, TP.HCM</p>
                    <p class="text-muted mb-2"><i class="bi bi-telephone me-2 text-primary-custom"></i> Hotline: 1900 1234</p>
                    <p class="text-muted mb-2"><i class="bi bi-envelope me-2 text-primary-custom"></i> support@cinemahub.vn</p>
                </div>
            </div>
            <hr class="border-secondary mb-3 mt-4" />
            <div class="row">
                <div class="col-md-6 text-center text-md-start">
                    <small class="text-muted">&copy; 2026 CinemaHub — Đẳng cấp điện ảnh</small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <small class="text-muted">Desinged with <i class="bi bi-heart-fill text-danger"></i> for you</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Script cho Navbar Shadow khi scroll -->
    <script>
        $(window).scroll(function() {
            if ($(document).scrollTop() > 50) {
                $('.navbar-custom').css('box-shadow', '0 4px 20px rgba(0,0,0,0.5)');
            } else {
                $('.navbar-custom').css('box-shadow', 'none');
            }
        });
        
        // Auto-hide alert after 5s
        setTimeout(function() {
            $('.alert-success, .alert-danger').fadeOut('slow');
        }, 5000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
