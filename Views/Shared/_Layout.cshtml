<!DOCTYPE html>
<html lang="vi" class="dark scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] — CinemaHub | Trải Nghiệm Điện Ảnh Thế Hệ Mới</title>
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        .ch-navbar-wrapper {
            position: sticky;
            top: 0;
            z-index: 1040;
            padding: 0.65rem 0;
            transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            background: linear-gradient(180deg, rgba(5, 7, 17, 0.92) 0%, rgba(5, 7, 17, 0.65) 100%);
            backdrop-filter: blur(22px) saturate(180%);
            -webkit-backdrop-filter: blur(22px) saturate(180%);
            border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        }
        .ch-navbar-wrapper.is-scrolled {
            padding: 0.45rem 0;
            background: rgba(5, 7, 17, 0.94);
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.65);
            border-bottom-color: rgba(255, 255, 255, 0.12);
        }
        .ch-brand {
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
            text-decoration: none;
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 1.45rem;
            letter-spacing: -0.02em;
            color: #ffffff !important;
        }
        .ch-brand-emblem {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #FF2E55 0%, #FF6B35 100%);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 22px rgba(255, 46, 85, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.35);
            position: relative;
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .ch-brand:hover .ch-brand-emblem {
            transform: rotate(-6deg) scale(1.06);
        }
        .ch-nav-capsule {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 999px;
            padding: 0.3rem;
        }
        .ch-nav-link {
            color: #cbd5e1 !important;
            font-weight: 600;
            font-size: 0.86rem;
            padding: 0.48rem 0.95rem;
            border-radius: 999px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.42rem;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            white-space: nowrap;
        }
        .ch-nav-link:hover {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.07);
        }
        .ch-nav-link.active {
            color: #ffffff !important;
            background: linear-gradient(135deg, rgba(255, 46, 85, 0.24) 0%, rgba(255, 107, 53, 0.18) 100%);
            border: 1px solid rgba(255, 46, 85, 0.45);
            box-shadow: 0 4px 16px rgba(255, 46, 85, 0.22);
        }
        .ch-search-pill {
            position: relative;
            width: 215px;
            transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @@media (min-width: 1400px) {
            .ch-search-pill:focus-within {
                width: 275px;
            }
        }
        .ch-search-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 999px;
            padding: 0.48rem 0.95rem 0.48rem 2.25rem;
            color: #f8fafc;
            font-size: 0.84rem;
            transition: all 0.25s ease;
        }
        .ch-search-input::placeholder {
            color: #94a3b8;
        }
        .ch-search-input:focus {
            outline: none;
            background: rgba(17, 24, 44, 0.95);
            border-color: #FF2E55;
            box-shadow: 0 0 0 3px rgba(255, 46, 85, 0.2);
        }
        /* Mobile Offcanvas Drawer */
        .ch-offcanvas {
            background: rgba(7, 10, 22, 0.98) !important;
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border-left: 1px solid rgba(255, 255, 255, 0.1);
            color: #f8fafc;
            width: min(86vw, 340px) !important;
            max-width: 340px;
            z-index: 1065;
        }
        .ch-drawer-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 50px;
            padding: 0.75rem 1rem;
            border-radius: 14px;
            color: #e2e8f0;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.94rem;
            border: 1px solid transparent;
            transition: all 0.22s ease;
        }
        .ch-drawer-link:hover,
        .ch-drawer-link.active {
            background: rgba(255, 46, 85, 0.14);
            border-color: rgba(255, 46, 85, 0.35);
            color: #ffffff;
        }
        /* Footer */
        .ch-footer {
            position: relative;
            background: linear-gradient(180deg, rgba(9, 13, 26, 0.6) 0%, #03040a 100%);
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            color: #94a3b8;
            overflow: hidden;
        }
        .ch-footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 65%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 46, 85, 0.6), rgba(245, 185, 66, 0.6), transparent);
        }
        .ch-footer-title {
            color: #f8fafc;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.92rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            margin-bottom: 1.15rem;
        }
        .ch-footer-link {
            color: #94a3b8;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            margin-bottom: 0.62rem;
            font-size: 0.88rem;
            transition: color 0.2s ease, transform 0.2s ease;
        }
        .ch-footer-link:hover {
            color: #F5B942;
            transform: translateX(4px);
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
        bool isHome = currentController == "Home" && currentAction == "Index";
        bool isMovies = currentController == "Movies";
        bool isShowtimes = currentController == "Showtimes";
        bool isTheaters = currentController == "Home" && currentAction == "Theaters";
        bool isNews = currentController == "Home" && currentAction == "News";
        bool isAbout = currentController == "Home" && currentAction == "About";
        bool isMyTickets = currentController == "Booking" && currentAction == "MyTickets";
        bool isAccount = currentController == "Account";
    }

    <!-- A. FLOATING CAPSULE GLASS HEADER -->
    <header class="ch-navbar-wrapper" id="mainHeaderBar">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between gap-2">
                <!-- Brand Emblem -->
                <a class="ch-brand" asp-controller="Home" asp-action="Index" aria-label="Trang chủ CinemaHub">
                    <span class="ch-brand-emblem">
                        <i class="bi bi-film text-white fs-5" aria-hidden="true"></i>
                    </span>
                    <span>CINEMA<span class="text-gradient-gold">HUB</span></span>
                </a>

                <!-- Desktop Capsule Navigation (Clean & Modern Without Icon Clutter) -->
                <nav class="d-none d-lg-flex align-items-center" aria-label="Điều hướng chính">
                    <div class="ch-nav-capsule">
                        <a class="ch-nav-link @(isHome ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <span>Khám phá</span>
                        </a>
                        <a class="ch-nav-link @(isMovies ? "active" : "")" asp-controller="Movies" asp-action="Index">
                            <span>Phim</span>
                        </a>
                        <a class="ch-nav-link @(isShowtimes ? "active" : "")" asp-controller="Showtimes" asp-action="Index">
                            <span>Lịch chiếu</span>
                        </a>
                        <a class="ch-nav-link @(isTheaters ? "active" : "")" asp-controller="Home" asp-action="Theaters">
                            <span>Cụm rạp</span>
                        </a>
                        <a class="ch-nav-link @(isNews ? "active" : "")" asp-controller="Home" asp-action="News">
                            <span>Tin tức &amp; Ưu đãi</span>
                        </a>
                        <a class="ch-nav-link @(isAbout ? "active" : "")" asp-controller="Home" asp-action="About">
                            <span>Công nghệ</span>
                        </a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                        {
                            <a class="ch-nav-link" style="color:#F5B942 !important;" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <span>Quản trị</span>
                            </a>
                        }
                    </div>
                </nav>

                <!-- Desktop Right Tools: Smart Search + Member Pill -->
                <div class="d-none d-lg-flex align-items-center gap-2">
                    <form asp-controller="Movies" asp-action="Index" method="get" class="ch-search-pill" role="search" id="headerMovieSearchForm">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary" style="font-size:0.8rem;" aria-hidden="true"></i>
                        <input type="search"
                               name="searchString"
                               id="headerMovieSearchInput"
                               class="ch-search-input"
                               placeholder="Tìm phim, rạp..."
                               aria-label="Tìm kiếm phim"
                               autocomplete="off" />
                    </form>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="d-inline-flex align-items-center gap-2 text-white text-decoration-none dropdown-toggle text-nowrap"
                               href="#"
                               data-bs-toggle="dropdown"
                               aria-expanded="false"
                               style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); border-radius: 999px; padding: 0.32rem 0.9rem 0.32rem 0.38rem; min-height: 40px; white-space: nowrap;">
                                <span style="width: 28px; height: 28px; background: var(--brand-gradient); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 0.8rem;">
                                    @((User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "U").Substring(0, 1).ToUpper())
                                </span>
                                <span class="small fw-semibold text-truncate" style="max-width: 120px;">@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg p-2" style="background: rgba(11, 16, 32, 0.96); backdrop-filter: blur(24px); border: 1px solid rgba(255,255,255,0.12); border-radius: 18px; margin-top: 10px; min-width: 230px;">
                                <li class="px-3 py-2 border-bottom border-secondary border-opacity-25 mb-1">
                                    <div class="text-white fw-bold small">@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</div>
                                    <div class="text-muted" style="font-size:0.72rem;">Thành viên CinemaHub</div>
                                </li>
                                <li><a class="dropdown-item text-light rounded-3 py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2" aria-hidden="true"></i> Hồ sơ tài khoản</a></li>
                                <li><a class="dropdown-item text-light rounded-3 py-2" asp-controller="Booking" asp-action="MyTickets"><i class="bi bi-ticket-perforated me-2" aria-hidden="true"></i> Vé của tôi</a></li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                                {
                                    <li><a class="dropdown-item text-warning rounded-3 py-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2" aria-hidden="true"></i> Trung tâm Quản trị</a></li>
                                }
                                <li><hr class="dropdown-divider border-secondary opacity-25 my-1"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="dropdown-item text-danger fw-bold rounded-3 py-2" type="submit"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i> Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="ch-btn-primary py-2 px-3 text-nowrap" style="font-size: 0.88rem; min-height: 40px; white-space: nowrap; flex-shrink: 0;" asp-controller="Account" asp-action="Login">
                            <span>Đăng nhập</span>
                        </a>
                    }
                </div>

                <!-- Mobile Quick Action & Drawer Button -->
                <div class="d-flex d-lg-none align-items-center gap-2">
                    <a asp-controller="Showtimes" asp-action="Index"
                       class="d-inline-flex align-items-center justify-content-center rounded-circle text-white text-decoration-none"
                       style="width:42px;height:42px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);"
                       aria-label="Lịch chiếu hôm nay">
                        <i class="bi bi-calendar2-week text-warning" aria-hidden="true"></i>
                    </a>
                    <button class="d-inline-flex align-items-center justify-content-center rounded-3 text-white border-0"
                            type="button"
                            style="width:44px;height:44px;background:linear-gradient(135deg,rgba(255,46,85,0.22),rgba(255,107,53,0.18));border:1px solid rgba(255,46,85,0.45) !important;"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#cinemaMobileDrawer"
                            aria-controls="cinemaMobileDrawer"
                            aria-label="Mở menu điều hướng">
                        <i class="bi bi-grid-fill fs-5" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Toast Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1060; margin-top: 82px;">
            <div class="alert alert-dismissible fade show shadow-lg border-0" role="alert" style="background: rgba(6, 78, 59, 0.94); border: 1px solid rgba(16, 185, 129, 0.45) !important; color: #d1fae5; border-radius: 16px; backdrop-filter: blur(16px);">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-check-circle-fill fs-4 text-success" aria-hidden="true"></i>
                    <div>
                        <div class="fw-bold">Thành công!</div>
                        <div class="small">@TempData["Success"]</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1060; margin-top: 82px;">
            <div class="alert alert-dismissible fade show shadow-lg border-0" role="alert" style="background: rgba(76, 5, 25, 0.94); border: 1px solid rgba(255, 46, 85, 0.5) !important; color: #ffe4e6; border-radius: 16px; backdrop-filter: blur(16px);">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-danger" aria-hidden="true"></i>
                    <div>
                        <div class="fw-bold">Thông báo</div>
                        <div class="small">@TempData["Error"]</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            </div>
        </div>
    }

    <!-- Mobile Offcanvas Drawer (Placed outside header so backdrop-filter does not trap position:fixed on mobile) -->
    <div class="offcanvas offcanvas-end ch-offcanvas" tabindex="-1" id="cinemaMobileDrawer" aria-labelledby="cinemaMobileDrawerLabel">
        <div class="offcanvas-header border-bottom border-secondary border-opacity-25 px-4 py-3">
            <a class="ch-brand" asp-controller="Home" asp-action="Index" id="cinemaMobileDrawerLabel">
                <span class="ch-brand-emblem" style="width:34px;height:34px;">
                    <i class="bi bi-film text-white" aria-hidden="true"></i>
                </span>
                <span>CINEMA<span class="text-gradient-gold">HUB</span></span>
            </a>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Đóng menu"></button>
        </div>
        <div class="offcanvas-body px-4 py-3 d-flex flex-column justify-content-between">
            <div>
                <form asp-controller="Movies" asp-action="Index" method="get" class="mb-3" role="search">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary" aria-hidden="true"></i>
                        <input type="search"
                               name="searchString"
                               class="form-control text-white rounded-pill ps-5 py-2"
                               style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);min-height:48px;"
                               placeholder="Tìm kiếm phim, định dạng IMAX..." />
                    </div>
                </form>

                <nav class="d-flex flex-column gap-1" aria-label="Menu di động">
                    <a class="ch-drawer-link @(isHome ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <span><i class="bi bi-compass me-3" aria-hidden="true"></i>Trang chủ Khám phá</span>
                        <i class="bi bi-chevron-right small text-secondary" aria-hidden="true"></i>
                    </a>
                    <a class="ch-drawer-link @(isMovies ? "active" : "")" asp-controller="Movies" asp-action="Index">
                        <span><i class="bi bi-film me-3" aria-hidden="true"></i>Kho Phim Đang &amp; Sắp Chiếu</span>
                        <span class="badge rounded-pill bg-danger" style="font-size:0.68rem;">HOT</span>
                    </a>
                    <a class="ch-drawer-link @(isShowtimes ? "active" : "")" asp-controller="Showtimes" asp-action="Index">
                        <span><i class="bi bi-calendar2-week me-3" aria-hidden="true"></i>Lịch Chiếu Toàn Quốc</span>
                        <i class="bi bi-chevron-right small text-secondary" aria-hidden="true"></i>
                    </a>
                    <a class="ch-drawer-link @(isTheaters ? "active" : "")" asp-controller="Home" asp-action="Theaters">
                        <span><i class="bi bi-building me-3" aria-hidden="true"></i>Hệ Thống Cụm Rạp</span>
                        <i class="bi bi-chevron-right small text-secondary" aria-hidden="true"></i>
                    </a>
                    <a class="ch-drawer-link @(isNews ? "active" : "")" asp-controller="Home" asp-action="News">
                        <span><i class="bi bi-stars me-3" aria-hidden="true"></i>Tin Điện Ảnh &amp; Ưu Đãi</span>
                        <i class="bi bi-chevron-right small text-secondary" aria-hidden="true"></i>
                    </a>
                    <a class="ch-drawer-link @(isAbout ? "active" : "")" asp-controller="Home" asp-action="About">
                        <span><i class="bi bi-award me-3" aria-hidden="true"></i>Về Công Nghệ CinemaHub</span>
                        <i class="bi bi-chevron-right small text-secondary" aria-hidden="true"></i>
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                    {
                        <a class="ch-drawer-link text-warning" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <span><i class="bi bi-speedometer2 me-3" aria-hidden="true"></i>Trung Tâm Quản Trị</span>
                            <i class="bi bi-chevron-right small" aria-hidden="true"></i>
                        </a>
                    }
                </nav>
            </div>

            <div class="pt-3 border-top border-secondary border-opacity-25">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <a asp-controller="Account" asp-action="Profile" class="d-flex align-items-center gap-2 text-decoration-none">
                            <span style="width: 40px; height: 40px; background: var(--brand-gradient); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800;">
                                @((User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "U").Substring(0, 1).ToUpper())
                            </span>
                            <div>
                                <div class="fw-bold text-white small">@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</div>
                                <div class="text-secondary" style="font-size:0.74rem;">Xem hồ sơ cá nhân</div>
                            </div>
                        </a>
                        <a asp-controller="Booking" asp-action="MyTickets" class="btn btn-sm btn-outline-warning rounded-pill px-3">Vé của tôi</a>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100 rounded-pill py-2 fw-bold" style="min-height:48px;">
                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Đăng xuất
                        </button>
                    </form>
                }
                else
                {
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" class="ch-btn-primary w-100" style="min-height:48px;">
                            <i class="bi bi-person-fill" aria-hidden="true"></i>
                            <span>Đăng nhập tài khoản</span>
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="ch-btn-glass w-100" style="min-height:48px;">
                            <span>Đăng ký thành viên mới</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Main Content Stage -->
    <main role="main" class="flex-grow-1">
        @if (ViewData["Title"]?.ToString() == "Trang Chủ" || ViewBag.FullWidth == true)
        {
            @RenderBody()
        }
        else
        {
            <div class="container py-4 py-lg-5">
                @RenderBody()
            </div>
        }
    </main>

    <!-- Footer -->
    <footer class="ch-footer pt-5 pb-4 mt-auto" aria-label="Thông tin chân trang CinemaHub">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <a class="ch-brand mb-3" asp-controller="Home" asp-action="Index">
                        <span class="ch-brand-emblem" style="width:34px;height:34px;">
                            <i class="bi bi-film text-white" aria-hidden="true"></i>
                        </span>
                        <span>CINEMA<span class="text-gradient-gold">HUB</span></span>
                    </a>
                    <p class="small text-secondary mb-3 pe-lg-4" style="line-height:1.7;">
                        Tổ hợp điện ảnh công nghệ cao chuẩn IMAX Laser 4K, Dolby Atmos 64 kênh &amp; phòng chờ hạng thương gia. Đặt vé 30 giây.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="https://www.facebook.com/people/Nguy%E1%BB%85n-M%E1%BA%A1nh/pfbid0vjQvuoG87KCXZBA8h7E3yDrpT33HQcdHZh4U66qAz2Q5GNsBxDYGAmAy3ugrMLWEl/" target="_blank" rel="noopener noreferrer" class="ch-btn-glass p-0 rounded-circle" style="width:40px;height:40px;" aria-label="Facebook">
                            <i class="bi bi-facebook" aria-hidden="true"></i>
                        </a>
                        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="ch-btn-glass p-0 rounded-circle" style="width:40px;height:40px;" aria-label="YouTube">
                            <i class="bi bi-youtube" aria-hidden="true"></i>
                        </a>
                        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="ch-btn-glass p-0 rounded-circle" style="width:40px;height:40px;" aria-label="Instagram">
                            <i class="bi bi-instagram" aria-hidden="true"></i>
                        </a>
                        <a href="https://www.tiktok.com/@@thorn111.4" target="_blank" rel="noopener noreferrer" class="ch-btn-glass p-0 rounded-circle" style="width:40px;height:40px;" aria-label="TikTok">
                            <i class="bi bi-tiktok" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h5 class="ch-footer-title">Khám Phá</h5>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="Movies" asp-action="Index" class="ch-footer-link"><i class="bi bi-play-circle"></i> Phim đang chiếu</a></li>
                        <li><a asp-controller="Showtimes" asp-action="Index" class="ch-footer-link"><i class="bi bi-calendar2-week"></i> Lịch chiếu toàn quốc</a></li>
                        <li><a asp-controller="Home" asp-action="Theaters" class="ch-footer-link"><i class="bi bi-building"></i> Cụm rạp IMAX</a></li>
                        <li><a asp-controller="Home" asp-action="News" class="ch-footer-link"><i class="bi bi-stars"></i> Ưu đãi thành viên</a></li>
                        <li><a asp-controller="Home" asp-action="About" class="ch-footer-link"><i class="bi bi-info-circle"></i> Về CinemaHub</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h5 class="ch-footer-title">Phân Loại Độ Tuổi</h5>
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        <span class="badge rounded-pill badge-age-p px-2 py-1">P • Mọi lứa tuổi</span>
                        <span class="badge rounded-pill badge-age-t13 px-2 py-1">T13 • 13+</span>
                        <span class="badge rounded-pill badge-age-t16 px-2 py-1">T16 • 16+</span>
                        <span class="badge rounded-pill badge-age-t18 px-2 py-1">T18 • 18+</span>
                    </div>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="Booking" asp-action="MyTickets" class="ch-footer-link"><i class="bi bi-ticket-perforated"></i> Quản lý &amp; hoàn vé online</a></li>
                        <li><a asp-controller="Account" asp-action="Profile" class="ch-footer-link"><i class="bi bi-shield-check"></i> Bảo mật tài khoản</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="ch-footer-title">Thanh Toán &amp; Hỗ Trợ</h5>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge rounded-pill px-3 py-2" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#e2e8f0;">
                            <i class="bi bi-qr-code-scan me-1"></i> VNPAY QR
                        </span>
                        <span class="badge rounded-pill px-3 py-2" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#e2e8f0;">
                            <i class="bi bi-wallet2 me-1"></i> MoMo
                        </span>
                        <span class="badge rounded-pill px-3 py-2" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#e2e8f0;">
                            <i class="bi bi-credit-card me-1"></i> Visa / Master
                        </span>
                    </div>
                    <p class="small mb-1 text-secondary"><i class="bi bi-geo-alt-fill me-2"></i> 235 Hoàng Quốc Việt, Hà Nội</p>
