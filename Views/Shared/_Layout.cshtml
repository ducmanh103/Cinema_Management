    </footer>

    @if (ViewBag.HideMobileDock != true)
    {
        <!-- Native-Like Mobile Bottom Navigation Bar (< 992px) -->
        <nav class="ch-mobile-dock d-lg-none" aria-label="Điều hướng di động nhanh">
            <a asp-controller="Home" asp-action="Index" class="ch-dock-item @(isHome ? "active" : "")">
                <i class="bi @(isHome ? "bi-compass-fill" : "bi-compass")" aria-hidden="true"></i>
                <span>Khám phá</span>
            </a>
            <a asp-controller="Movies" asp-action="Index" class="ch-dock-item @(isMovies ? "active" : "")">
                <i class="bi @(isMovies ? "bi-film" : "bi-film")" aria-hidden="true"></i>
                <span>Phim</span>
            </a>
            <a asp-controller="Showtimes" asp-action="Index" class="ch-dock-item @(isShowtimes ? "active" : "")">
                <i class="bi @(isShowtimes ? "bi-calendar2-week-fill" : "bi-calendar2-week")" aria-hidden="true"></i>
                <span>Lịch chiếu</span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Booking" asp-action="MyTickets" class="ch-dock-item @(isMyTickets || isAccount ? "active" : "")">
                    <i class="bi @(isMyTickets ? "bi-ticket-perforated-fill" : "bi-ticket-perforated")" aria-hidden="true"></i>
                    <span>Vé của tôi</span>
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="ch-dock-item @(isAccount ? "active" : "")">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                    <span>Tài khoản</span>
                </a>
            }
            <button type="button" id="mobileDockChatBtn" class="ch-dock-item" onclick="document.getElementById('chatbot-trigger')?.click()" aria-label="Mở Trợ lý AI CinemaHub">
                <i class="bi bi-stars" style="color:#F5B942;" aria-hidden="true"></i>
                <span>Trợ lý AI</span>
            </button>
        </nav>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        window.addEventListener('scroll', function () {
            var hdr = document.getElementById('mainHeaderBar');
            if (hdr) hdr.classList.toggle('is-scrolled', window.scrollY > 30);
        }, { passive: true });

        setTimeout(function () {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- AI Concierge Widget -->
    <button id="chatbot-trigger" title="Trợ lý AI CinemaHub">Trợ lý AI</button>

    <div id="chatbot-panel" role="dialog" aria-label="Trợ lý ảo CinemaHub">
        <div class="chatbot-header">
            <div class="chatbot-header-info">
                <div class="chatbot-online-dot"></div>
                <div class="chatbot-status-container">
                    <h5 class="chatbot-name">CinemaHub AI Concierge</h5>
                    <span class="chatbot-status">Trực tuyến 24/7</span>
                </div>
            </div>
            <div class="chatbot-header-actions">
                <button id="chatbot-clear-btn" class="chatbot-action-btn" title="Làm mới hội thoại">Làm mới</button>
                <button id="chatbot-close-btn" class="chatbot-action-btn" title="Đóng">Đóng</button>
            </div>
        </div>

        <div id="chatbot-body" class="chatbot-body"></div>

        <div class="chatbot-footer">
            <div class="chatbot-input-container">
                <input type="text" id="chatbot-input" class="chatbot-input" placeholder="Hỏi phim đang hot, lịch chiếu, giá vé..." autocomplete="off" />
                <button id="chatbot-send-btn" class="chatbot-send-btn" title="Gửi">Gửi</button>
            </div>
            <div class="chatbot-branding">Trí tuệ nhân tạo CinemaHub Aurora</div>
        </div>
    </div>

    <script src="~/js/chatbot.js" asp-append-version="true"></script>
</body>
</html>
