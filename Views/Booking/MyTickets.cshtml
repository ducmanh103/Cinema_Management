@model List<TicketDto>
@using CinemaManagement.Helpers
@{
    ViewData["Title"] = "Ví Vé Điện Tử Của Tôi";
    ViewBag.FullWidth = true;

    var tickets = Model ?? new List<TicketDto>();
    var now = VietnamTime.Now;
    var activeCount = tickets.Count(t => t.Status == "Booked" && t.StartTime > now);
    var completedCount = tickets.Count(t => t.Status == "Booked" && t.StartTime <= now);
    var cancelledCount = tickets.Count(t => t.Status == "Cancelled");
    var totalSpent = tickets.Where(t => t.Status == "Booked").Sum(t => t.Price);
}

<style>
    .wt-hero {
        padding: 48px 0 36px;
        background:
            radial-gradient(circle at 80% 20%, rgba(255, 46, 85, 0.16), transparent 45%),
            radial-gradient(circle at 20% 80%, rgba(245, 185, 66, 0.12), transparent 50%),
            #050711;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .wt-container {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 24px;
    }
    .wt-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-top: 28px;
    }
    .wt-kpi-card {
        padding: 18px 20px;
        border-radius: 20px;
        background: rgba(15, 22, 41, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    /* Perforated Boarding Pass Card */
    .wt-pass-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
        padding: 36px 0 72px;
    }
    .wt-pass-card {
        display: grid;
        grid-template-columns: 1fr 165px;
        border-radius: 24px;
        background: rgba(15, 22, 41, 0.82);
        border: 1px solid rgba(255, 255, 255, 0.1);
        overflow: hidden;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .wt-pass-card:hover {
        transform: translateY(-5px);
        border-color: rgba(255, 46, 85, 0.4);
    }
    .wt-pass-main {
        padding: 22px 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .wt-pass-stub {
        position: relative;
        padding: 20px 16px;
        background: rgba(255, 255, 255, 0.03);
        border-left: 2px dashed rgba(255, 255, 255, 0.14);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }
    .wt-qr-box {
        width: 86px;
        height: 86px;
        border-radius: 14px;
        background: #fff;
        color: #050711;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.8rem;
        margin-bottom: 10px;
    }
    @@media (max-width: 991.98px) {
        .wt-kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .wt-pass-grid { grid-template-columns: 1fr; }
    }
    @@media (max-width: 575.98px) {
        .wt-pass-card { grid-template-columns: 1fr; }
        .wt-pass-stub { border-left: none; border-top: 2px dashed rgba(255, 255, 255, 0.14); }
    }
</style>

<section class="wt-hero">
    <div class="wt-container">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3">
            <div>
                <span class="ch-eyebrow mb-2"><i class="bi bi-wallet2"></i> Digital Cinema Wallet</span>
                <h1 class="text-white fw-bolder mb-1" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(1.9rem,3.2vw,2.7rem);">
                    Ví Vé Điện Tử Của Tôi
                </h1>
                <p class="text-white-50 mb-0">Đưa mã QR trên thẻ vé tại cổng soát vé tự động để vào thẳng phòng chiếu.</p>
            </div>
            <a asp-controller="Showtimes" asp-action="Index" class="btn rounded-pill px-4 py-2 fw-bold text-white"
               style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                <i class="bi bi-plus-lg me-1"></i> Đặt Thêm Vé Mới
            </a>
        </div>

        <div class="wt-kpi-grid">
            <div class="wt-kpi-card">
                <div class="text-white-50 small">Vé Sắp Chiếu</div>
                <div class="text-success fw-bolder fs-3">@activeCount</div>
            </div>
            <div class="wt-kpi-card">
                <div class="text-white-50 small">Đã Xem</div>
                <div class="text-info fw-bolder fs-3">@completedCount</div>
            </div>
            <div class="wt-kpi-card">
                <div class="text-white-50 small">Đã Hủy</div>
                <div class="text-secondary fw-bolder fs-3">@cancelledCount</div>
            </div>
            <div class="wt-kpi-card">
                <div class="text-white-50 small">Tổng Chi Tiêu</div>
                <div class="text-warning fw-bolder fs-3">@totalSpent.ToString("N0") ₫</div>
            </div>
        </div>
    </div>
</section>

<section class="wt-container">
    @if (!tickets.Any())
    {
        <div class="text-center py-5">
            <div class="p-5 rounded-4 mx-auto" style="max-width:520px;background:rgba(15,22,41,0.75);border:1px solid rgba(255,255,255,0.08);">
                <i class="bi bi-ticket-perforated fs-1 text-danger d-block mb-3"></i>
                <h4 class="text-white fw-bold">Ví vé của bạn đang trống</h4>
                <p class="text-white-50 mb-4">Hãy chọn ngay một bộ phim bom tấn đang khởi chiếu để trải nghiệm thẻ vé điện tử QR.</p>
                <a asp-controller="Movies" asp-action="Index" class="btn rounded-pill px-4 py-2 fw-bold text-white"
                   style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                    Khám Phá Phim Ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="wt-pass-grid">
            @foreach (var ticket in tickets)
            {
                bool isUpcoming = ticket.Status == "Booked" && ticket.StartTime > now;
                bool isCancelled = ticket.Status == "Cancelled";

                <div class="wt-pass-card cinema-spotlight">
                    <div class="wt-pass-main">
                        <div>
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                <span class="badge rounded-pill px-3 py-1"
                                      style="background:@(isCancelled ? "rgba(239,68,68,0.16)" : isUpcoming ? "rgba(16,185,129,0.18)" : "rgba(56,189,248,0.16)");color:@(isCancelled ? "#F87171" : isUpcoming ? "#34D399" : "#38BDF8");">
                                    @(isCancelled ? "Đã Hủy" : isUpcoming ? "Sắp Chiếu • Hợp Lệ" : "Đã Hoàn Thành")
                                </span>
                                <span class="text-white-50 small font-monospace">#CH-@ticket.TicketId.ToString("D5")</span>
                            </div>

                            <h4 class="text-white fw-bold mb-2" style="font-family:'Space Grotesk',sans-serif;">@ticket.MovieTitle</h4>

                            <div class="row g-2 small text-white-50 mb-3">
                                <div class="col-6">
                                    <div><i class="bi bi-geo-alt text-danger me-1"></i>Phòng chiếu</div>
                                    <strong class="text-white">@ticket.RoomName</strong>
                                </div>
                                <div class="col-6">
                                    <div><i class="bi bi-door-open text-info me-1"></i>Số ghế</div>
                                    <strong class="text-warning">Ghế @ticket.SeatNumber</strong>
                                </div>
                                <div class="col-6">
                                    <div><i class="bi bi-calendar-event text-warning me-1"></i>Suất chiếu</div>
                                    <strong class="text-white">@ticket.StartTime.ToString("HH:mm - dd/MM/yyyy")</strong>
                                </div>
                                <div class="col-6">
                                    <div><i class="bi bi-credit-card text-success me-1"></i>Giá vé &amp; TT</div>
                                    <strong class="text-white">@ticket.Price.ToString("N0") ₫ (@(ticket.PaymentStatus ?? "Paid"))</strong>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-25">
                            <span class="text-white-50" style="font-size:0.75rem;">
                                Đặt lúc: @ticket.BookingTime.ToString("HH:mm dd/MM/yyyy")
                            </span>

                            @if (isUpcoming)
                            {
                                <form asp-action="Cancel" asp-route-id="@ticket.TicketId" method="post"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy vé #@ticket.TicketId (Ghế @ticket.SeatNumber) không?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm rounded-pill px-3 fw-bold text-danger"
                                            style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);">
                                        <i class="bi bi-x-circle me-1"></i> Hủy Vé
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="wt-pass-stub">
                        <div class="wt-qr-box">
                            <i class="bi bi-qr-code-scan"></i>
                        </div>
                        <div class="text-white fw-bold small">GHẾ @ticket.SeatNumber</div>
                        <div class="text-white-50" style="font-size:0.7rem;">Quét tại cổng IMAX</div>
                    </div>
                </div>
            }
        </div>
    }
</section>
