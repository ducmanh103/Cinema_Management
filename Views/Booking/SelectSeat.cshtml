@model List<SeatStatusDto>
@{
    var showtime = ViewBag.Showtime as ShowtimeDto;
    ViewData["Title"] = "Chọn Ghế — " + (showtime?.MovieTitle ?? "Phòng Chiếu");
    ViewBag.FullWidth = true;
    ViewBag.HideMobileDock = true; // Ẩn dock điều hướng chung trên mobile để nhường chỗ cho thanh thanh toán giữ ghế ghim đáy màn hình

    decimal basePrice = showtime?.Price ?? 90000m;
    var seatRows = (Model ?? new List<SeatStatusDto>())
        .GroupBy(s => s.SeatNumber[0])
        .OrderBy(g => g.Key)
        .ToList();

    bool isStaffOrAdmin = User.IsInRole("Admin") || User.IsInRole("Staff");
}

<style>
    .bk-stage {
        min-height: 90vh;
        padding: 32px 0 100px;
        background:
            radial-gradient(circle at 50% 0%, rgba(255, 46, 85, 0.08), transparent 50%),
            radial-gradient(circle at 20% 80%, rgba(56, 189, 248, 0.06), transparent 55%),
            #050711;
        position: relative;
    }

    .bk-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .bk-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 28px;
        align-items: start;
    }

    /* ─── Cinema Auditorium Stage Card ─── */
    .bk-auditorium-card {
        padding: 32px 24px;
        border-radius: 26px;
        background: rgba(13, 19, 36, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.09);
        backdrop-filter: blur(20px);
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    /* Curved Volumetric IMAX Screen */
    .bk-screen-wrap {
        position: relative;
        text-align: center;
        margin-bottom: 34px;
    }

    .bk-screen-arc {
        max-width: 640px;
        height: 14px;
        margin: 0 auto 10px;
        border-radius: 50% 50% 0 0 / 100% 100% 0 0;
        background: linear-gradient(90deg, transparent 0%, rgba(255, 46, 85, 0.5) 20%, #ffffff 50%, rgba(56, 189, 248, 0.5) 80%, transparent 100%);
        box-shadow: 0 14px 40px rgba(255, 46, 85, 0.4);
    }

    .bk-screen-caption {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.22em;
        color: #94A3B8;
        text-transform: uppercase;
    }

    /* Seat Matrix & Rows */
    .bk-seat-viewport {
        width: 100%;
        overflow-x: auto;
        padding: 10px 0 20px;
        scrollbar-width: thin;
    }

    .bk-seat-matrix {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: center;
        min-width: 580px;
        transition: transform 0.25s ease;
        transform-origin: top center;
    }

    .bk-seat-viewport.zoom-fit .bk-seat-matrix {
        min-width: 100%;
        gap: 6px;
    }

    .bk-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .bk-seat-viewport.zoom-fit .bk-row {
        gap: 4px;
    }

    .bk-row-label {
        width: 28px;
        text-align: center;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 800;
        font-size: 0.85rem;
        color: #64748B;
        user-select: none;
    }

    .bk-seat-viewport.zoom-fit .bk-row-label {
        width: 18px;
        font-size: 0.7rem;
    }

    .bk-seat {
        position: relative;
        width: 42px;
        height: 38px;
        border-radius: 10px 10px 5px 5px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(255, 255, 255, 0.05);
        color: #E2E8F0;
        font-size: 0.73rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        user-select: none;
    }

    .bk-seat-viewport.zoom-fit .bk-seat {
        width: clamp(24px, 7.2vw, 34px);
        height: clamp(24px, 7.2vw, 34px);
        font-size: 0.58rem;
        border-radius: 6px 6px 3px 3px;
    }

    .bk-seat::after {
        content: '';
        position: absolute;
        bottom: 3px;
        left: 5px;
        right: 5px;
        height: 2px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.2);
    }

    .bk-seat:hover:not(:disabled) {
        transform: translateY(-3px) scale(1.1);
        border-color: #FF2E55;
        color: #fff;
        z-index: 2;
    }

    .bk-seat.seat-vip {
        background: rgba(245, 185, 66, 0.12);
        border-color: rgba(245, 185, 66, 0.45);
        color: #F5B942;
    }

    .bk-seat.seat-booked {
        background: rgba(255, 255, 255, 0.02);
        border-color: rgba(255, 255, 255, 0.05);
        color: #475569;
        cursor: not-allowed;
        opacity: 0.45;
    }

    .bk-seat.seat-selected {
        background: linear-gradient(135deg, #FF2E55, #FF6B35) !important;
        border-color: #ffffff !important;
        color: #ffffff !important;
        transform: translateY(-4px) scale(1.12);
        box-shadow: 0 10px 24px rgba(255, 46, 85, 0.6);
        z-index: 3;
    }

    /* ─── Desktop Boarding Pass Summary Card ─── */
    .bk-summary-card {
        position: sticky;
        top: 96px;
        padding: 24px;
        border-radius: 24px;
        background: rgba(15, 23, 42, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(24px);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    }

    .bk-pay-option {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.09);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .bk-pay-option:has(input:checked) {
        background: rgba(255, 46, 85, 0.12);
        border-color: #FF2E55;
    }

    /* ─── Mobile Sticky Bottom Dock (Luôn ghim đáy màn hình điện thoại) ─── */
    .bk-mobile-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1050;
        background: rgba(9, 13, 26, 0.96);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-top: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.7);
        padding: 12px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    @@media (min-width: 992px) {
        .bk-mobile-bar {
            display: none !important;
        }
    }

    @@media (max-width: 991.98px) {
        .bk-stage {
            padding: 20px 0 110px; /* Thêm padding dưới để không bị che bởi thanh ghim */
        }
        .bk-container {
            padding: 0 12px;
        }
        .bk-layout {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        .bk-auditorium-card {
            padding: 20px 12px;
            border-radius: 20px;
        }
        /* Trên điện thoại, ẩn nút thanh toán trong thẻ tĩnh để tránh trùng lặp */
        .bk-summary-card #confirmBookingBtn {
            display: none !important;
        }
        .bk-summary-card {
            position: static;
            padding: 20px 16px;
            border-radius: 20px;
        }
    }
</style>

<section class="bk-stage">
    <div class="bk-container">
        <!-- Top Nav & Movie Info Header -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <a asp-controller="Showtimes" asp-action="Index" class="text-white-50 text-decoration-none small d-inline-flex align-items-center gap-1 mb-1 hover-white">
                    <i class="bi bi-arrow-left"></i> Chọn suất chiếu khác
                </a>
                <h1 class="text-white fw-bold mb-1" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(1.5rem,2.8vw,2.2rem);">
                    @(showtime?.MovieTitle ?? "Chọn Ghế Phòng Chiếu")
                </h1>
                <div class="d-flex flex-wrap align-items-center gap-2 text-white-50 small">
                    <span><i class="bi bi-building me-1"></i>@(showtime?.TheaterName ?? "CinemaHub")</span>
                    <span>•</span>
                    <span class="text-info fw-semibold"><i class="bi bi-door-open me-1"></i>@(showtime?.RoomName ?? "Phòng Chiếu")</span>
                    <span>•</span>
                    <span class="text-warning fw-semibold"><i class="bi bi-clock me-1"></i>@(showtime != null ? showtime.StartTime.ToString("HH:mm - dd/MM/yyyy") : "")</span>
                </div>
            </div>

            <button type="button" id="toggleZoomFitBtn" class="btn btn-sm d-md-none rounded-pill px-3 py-2 text-white"
                    style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.18);">
                <i class="bi bi-arrows-angle-contract me-1"></i> Thu vừa màn hình
            </button>
        </div>

        <div class="bk-layout">
            <!-- Left: Interactive 3D Auditorium Matrix -->
            <div class="bk-auditorium-card">
                <div class="bk-screen-wrap">
                    <div class="bk-screen-arc"></div>
                    <div class="bk-screen-caption">MÀN HÌNH CONG LASER • HƯỚNG NHÌN TRUNG TÂM</div>
                </div>

                <div class="bk-seat-viewport" id="seatViewport">
                    <div class="bk-seat-matrix">
                        @foreach (var row in seatRows)
                        {
                            <div class="bk-row">
                                <span class="bk-row-label">@row.Key</span>
                                @foreach (var seat in row.OrderBy(s => int.Parse(s.SeatNumber.Substring(1))))
                                {
                                    bool isVip = seat.SeatType == "VIP";
                                    decimal seatPrice = isVip ? basePrice + 15000m : basePrice;
                                    <button type="button"
                                            class="bk-seat @(isVip ? "seat-vip" : "") @(seat.IsBooked ? "seat-booked" : "")"
                                            data-seat-id="@seat.SeatId"
                                            data-seat-number="@seat.SeatNumber"
                                            data-seat-type="@seat.SeatType"
                                            data-seat-price="@seatPrice"
                                            @(seat.IsBooked ? "disabled" : "")
                                            title="Ghế @seat.SeatNumber (@seat.SeatType) — @seatPrice.ToString("N0") ₫">
                                        @seat.SeatNumber
                                    </button>
                                }
                                <span class="bk-row-label">@row.Key</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Seat Legend (Minimalist & Clean) -->
                <div class="d-flex flex-wrap justify-content-center gap-4 pt-3 mt-3 border-top border-secondary border-opacity-25 small text-white-50">
                    <span class="d-inline-flex align-items-center gap-2">
                        <span style="width:16px;height:16px;border-radius:4px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.2);"></span>
                        Ghế Thường (@basePrice.ToString("N0") ₫)
                    </span>
                    <span class="d-inline-flex align-items-center gap-2">
                        <span style="width:16px;height:16px;border-radius:4px;background:rgba(245,185,66,0.18);border:1px solid #F5B942;"></span>
                        Ghế VIP (@((basePrice + 15000m).ToString("N0")) ₫)
                    </span>
                    <span class="d-inline-flex align-items-center gap-2">
                        <span style="width:16px;height:16px;border-radius:4px;background:linear-gradient(135deg,#FF2E55,#FF6B35);"></span>
                        Đang Chọn
                    </span>
                    <span class="d-inline-flex align-items-center gap-2">
                        <span style="width:16px;height:16px;border-radius:4px;background:rgba(255,255,255,0.03);opacity:0.4;"></span>
                        Đã Đặt
                    </span>
                </div>
            </div>

            <!-- Right: Desktop Boarding Pass Summary -->
            <div class="bk-summary-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom border-secondary border-opacity-25">
                    <div>
                        <span class="badge rounded-pill px-3 py-1 mb-1" style="background:rgba(255,46,85,0.15);color:#FF8FA3;font-size:0.75rem;">Thông Tin Vé</span>
                        <h4 class="text-white fw-bold mb-0" style="font-size:1.15rem;">@(showtime?.MovieTitle ?? "Suất chiếu")</h4>
                    </div>
                    <i class="bi bi-ticket-perforated fs-2 text-white-50"></i>
                </div>

                <div class="d-flex flex-column gap-2 mb-4 small">
                    <div class="d-flex justify-content-between">
                        <span class="text-white-50">Cụm rạp:</span>
                        <strong class="text-white">@(showtime?.TheaterName ?? "CinemaHub")</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-white-50">Phòng chiếu:</span>
                        <strong class="text-white">@(showtime?.RoomName ?? "Phòng 1")</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-white-50">Suất chiếu:</span>
                        <strong class="text-white">@(showtime != null ? showtime.StartTime.ToString("HH:mm - dd/MM/yyyy") : "")</strong>
                    </div>
                    <div class="d-flex justify-content-between pt-2 border-top border-secondary border-opacity-25">
                        <span class="text-white-50">Ghế đã chọn:</span>
                        <strong class="text-white" id="selectedSeatLabel">Chưa chọn ghế</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-white-50">Hạng ghế:</span>
                        <strong class="text-white" id="selectedSeatTypeLabel">—</strong>
                    </div>
                </div>

                <!-- Payment Method Selector -->
                <div class="mb-4">
                    <label class="text-white-50 small fw-bold text-uppercase mb-2 d-block" style="font-size:0.75rem;">Phương Thức Thanh Toán</label>
                    <div class="d-flex flex-column gap-2">
                        <label class="bk-pay-option">
                            <input type="radio" name="paymentMethodRadio" value="VnPay" checked class="form-check-input m-0" />
                            <div>
                                <div class="text-white fw-bold small">Cổng VNPAY (QR / ATM / Thẻ Quốc Tế)</div>
                                <div class="text-white-50" style="font-size:0.73rem;">Xác thực vé điện tử QR tự động</div>
                            </div>
                        </label>

                        @if (isStaffOrAdmin)
                        {
                            <label class="bk-pay-option">
                                <input type="radio" name="paymentMethodRadio" value="Cash" class="form-check-input m-0" />
                                <div>
                                    <div class="text-white fw-bold small">Thu Tiền Mặt Tại Quầy (Nhân Viên)</div>
                                    <div class="text-white-50" style="font-size:0.73rem;">In vé trực tiếp cho khách tại rạp</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <div class="d-flex align-items-baseline justify-content-between mb-3 pt-3 border-top border-secondary border-opacity-25">
                    <span class="text-white-50 fw-semibold">Tổng thanh toán:</span>
                    <span class="fw-bolder" style="color:#F5B942;font-family:'Space Grotesk',sans-serif;font-size:1.75rem;" id="selectedSeatPriceLabel">0 ₫</span>
                </div>

                <div id="bookingFeedback" class="alert d-none py-2 px-3 small mb-3"></div>

                <!-- Desktop Checkout Button -->
                <button type="button"
                        id="confirmBookingBtn"
                        disabled
                        class="btn w-100 py-3 fw-bold text-white text-nowrap d-flex align-items-center justify-content-center gap-2"
                        style="background:linear-gradient(135deg,#FF2E55,#FF6B35);border-radius:14px;box-shadow:0 12px 28px rgba(255,46,85,0.38);border:none;min-height:50px;">
                    <span>Thanh Toán &amp; Giữ Ghế</span>
                    <i class="bi bi-arrow-right"></i>
                </button>

                <!-- Hidden VnPay POST Form -->
                <form id="vnpay-form" asp-controller="Payment" asp-action="CreateVnPayUrl" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ShowtimeId" value="@(showtime?.ShowtimeId ?? 0)" />
                    <input type="hidden" name="SeatId" id="vnpaySeatIdInput" value="" />
                    <input type="hidden" name="PaymentMethod" value="VnPay" />
                </form>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     MOBILE STICKY BOTTOM DOCK (GHIM ĐÁY MÀN HÌNH ĐIỆN THOẠI)
     Người dùng chạm ghế là thanh đáy cập nhật tức thì, bấm thanh toán ngay
     ========================================================================= -->
<div class="bk-mobile-bar" id="mobileStickyBar">
    <div class="d-flex flex-column text-start" style="line-height:1.25;">
        <div class="d-flex align-items-center gap-1">
            <span class="text-white-50 small">Ghế:</span>
            <strong class="text-white" id="mobileSeatLabel">Chưa chọn</strong>
            <span id="mobileSeatTypeBadge" class="badge rounded-pill d-none ms-1" style="font-size:0.68rem;background:rgba(255,255,255,0.1);color:#e2e8f0;"></span>
        </div>
        <div class="d-flex align-items-center gap-1 mt-1">
            <span class="text-white-50 small">Tổng:</span>
            <strong class="fw-bolder" id="mobileSeatPriceLabel" style="color:#F5B942;font-size:1.18rem;font-family:'Space Grotesk',sans-serif;">0 ₫</strong>
        </div>
    </div>

    <button type="button"
            id="mobileConfirmBtn"
            disabled
            class="btn fw-bold px-4 py-2 text-nowrap d-flex align-items-center gap-2"
            style="min-height:46px;border-radius:12px;background:linear-gradient(135deg,#FF2E55,#FF6B35);color:#fff;border:none;box-shadow:0 8px 20px rgba(255,46,85,0.4);font-size:0.95rem;">
        <span>Thanh Toán</span>
        <i class="bi bi-arrow-right"></i>
    </button>
</div>

@section Scripts {
    <script>
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || sessionStorage.getItem('vnpay_redirecting') === 'true') {
                sessionStorage.removeItem('vnpay_redirecting');
                window.location.reload();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            var seatBtns = document.querySelectorAll('.bk-seat:not(.seat-booked)');
            var seatLabel = document.getElementById('selectedSeatLabel');
            var typeLabel = document.getElementById('selectedSeatTypeLabel');
            var priceLabel = document.getElementById('selectedSeatPriceLabel');
            var confirmBtn = document.getElementById('confirmBookingBtn');

            // Mobile sticky bar elements
            var mobileSeatLabel = document.getElementById('mobileSeatLabel');
            var mobileTypeBadge = document.getElementById('mobileSeatTypeBadge');
            var mobilePriceLabel = document.getElementById('mobileSeatPriceLabel');
            var mobileConfirmBtn = document.getElementById('mobileConfirmBtn');

            var vnpayForm = document.getElementById('vnpay-form');
            var vnpaySeatInput = document.getElementById('vnpaySeatIdInput');
            var feedbackEl = document.getElementById('bookingFeedback');
            var zoomBtn = document.getElementById('toggleZoomFitBtn');
            var viewport = document.getElementById('seatViewport');

            var selectedSeat = null;
            var showtimeId = @(showtime?.ShowtimeId ?? 0);

            if (zoomBtn && viewport) {
                if (window.innerWidth < 768) {
                    viewport.classList.add('zoom-fit');
                }
                zoomBtn.addEventListener('click', function () {
                    viewport.classList.toggle('zoom-fit');
                });
            }

            function updateUI() {
                if (selectedSeat) {
                    var seatText = 'Ghế ' + selectedSeat.number;
                    var typeText = selectedSeat.type === 'VIP' ? 'Ghế VIP (+15,000đ)' : 'Ghế Tiêu Chuẩn';
                    var priceText = selectedSeat.price.toLocaleString('vi-VN') + ' ₫';

                    // Desktop update
                    if (seatLabel) seatLabel.textContent = seatText;
                    if (typeLabel) typeLabel.textContent = typeText;
                    if (priceLabel) priceLabel.textContent = priceText;
                    if (confirmBtn) confirmBtn.disabled = false;

                    // Mobile bar update
                    if (mobileSeatLabel) mobileSeatLabel.textContent = selectedSeat.number;
                    if (mobileTypeBadge) {
                        mobileTypeBadge.textContent = selectedSeat.type;
                        mobileTypeBadge.className = 'badge rounded-pill ms-1 ' + (selectedSeat.type === 'VIP' ? 'bg-warning text-dark' : 'bg-secondary text-white');
                        mobileTypeBadge.classList.remove('d-none');
                    }
                    if (mobilePriceLabel) mobilePriceLabel.textContent = priceText;
                    if (mobileConfirmBtn) mobileConfirmBtn.disabled = false;

                    if (vnpaySeatInput) vnpaySeatInput.value = selectedSeat.id;
                } else {
                    // Desktop reset
                    if (seatLabel) seatLabel.textContent = 'Chưa chọn ghế';
                    if (typeLabel) typeLabel.textContent = '—';
                    if (priceLabel) priceLabel.textContent = '0 ₫';
                    if (confirmBtn) confirmBtn.disabled = true;

                    // Mobile bar reset
                    if (mobileSeatLabel) mobileSeatLabel.textContent = 'Chưa chọn';
                    if (mobileTypeBadge) mobileTypeBadge.classList.add('d-none');
                    if (mobilePriceLabel) mobilePriceLabel.textContent = '0 ₫';
                    if (mobileConfirmBtn) mobileConfirmBtn.disabled = true;

                    if (vnpaySeatInput) vnpaySeatInput.value = '';
                }
            }

            seatBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    if (selectedSeat && selectedSeat.el === btn) {
                        btn.classList.remove('seat-selected');
                        selectedSeat = null;
                    } else {
                        seatBtns.forEach(function (b) { b.classList.remove('seat-selected'); });
                        btn.classList.add('seat-selected');
                        selectedSeat = {
                            el: btn,
                            id: parseInt(btn.getAttribute('data-seat-id'), 10),
                            number: btn.getAttribute('data-seat-number'),
                            type: btn.getAttribute('data-seat-type'),
                            price: parseFloat(btn.getAttribute('data-seat-price'))
                        };
                    }
                    updateUI();
                });
            });

            async function processCheckout(triggerBtn) {
                if (!selectedSeat) return;

                var methodRadio = document.querySelector('input[name="paymentMethodRadio"]:checked');
                var paymentMethod = methodRadio ? methodRadio.value : 'VnPay';

                if (confirmBtn) {
                    confirmBtn.disabled = true;
                    confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý...';
                }
                if (mobileConfirmBtn) {
                    mobileConfirmBtn.disabled = true;
                    mobileConfirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý...';
                }

                if (paymentMethod === 'VnPay') {
                    sessionStorage.setItem('vnpay_redirecting', 'true');
                    vnpayForm.submit();
                    return;
                }

                // Cash booking via REST API for Staff/Admin
                try {
                    var csrfToken = (window.CinemaSecurity && window.CinemaSecurity.getCsrfToken)
                        ? window.CinemaSecurity.getCsrfToken()
                        : (document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '');

                    var res = await fetch('/api/TicketsApi/book', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrfToken
                        },
                        body: JSON.stringify({
                            showtimeId: showtimeId,
                            seatId: selectedSeat.id,
                            paymentMethod: paymentMethod
                        })
                    });
                    var data = await res.json();
                    if (res.ok) {
                        if (feedbackEl) {
                            feedbackEl.className = 'alert alert-success py-2 px-3 small mb-3';
                            feedbackEl.textContent = data.message || 'Đặt vé thành công!';
                        }
                        setTimeout(function () {
                            window.location.href = '@Url.Action("MyTickets", "Booking")';
                        }, 900);
                    } else {
                        if (feedbackEl) {
                            feedbackEl.className = 'alert alert-danger py-2 px-3 small mb-3';
                            feedbackEl.textContent = data.message || 'Không thể đặt ghế này.';
                        }
                        if (confirmBtn) {
                            confirmBtn.disabled = false;
                            confirmBtn.innerHTML = '<span>Thanh Toán & Giữ Ghế</span> <i class="bi bi-arrow-right"></i>';
                        }
                        if (mobileConfirmBtn) {
                            mobileConfirmBtn.disabled = false;
                            mobileConfirmBtn.innerHTML = '<span>Thanh Toán</span> <i class="bi bi-arrow-right"></i>';
                        }
                    }
                } catch (err) {
                    if (feedbackEl) {
                        feedbackEl.className = 'alert alert-danger py-2 px-3 small mb-3';
                        feedbackEl.textContent = 'Lỗi kết nối máy chủ.';
                    }
                    if (confirmBtn) {
                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = '<span>Thanh Toán & Giữ Ghế</span> <i class="bi bi-arrow-right"></i>';
                    }
                    if (mobileConfirmBtn) {
                        mobileConfirmBtn.disabled = false;
                        mobileConfirmBtn.innerHTML = '<span>Thanh Toán</span> <i class="bi bi-arrow-right"></i>';
                    }
                }
            }

            if (confirmBtn) {
                confirmBtn.addEventListener('click', function () { processCheckout(confirmBtn); });
            }
            if (mobileConfirmBtn) {
                mobileConfirmBtn.addEventListener('click', function () { processCheckout(mobileConfirmBtn); });
            }
        });
    </script>
}
