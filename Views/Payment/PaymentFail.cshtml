@model VnPaymentResponseModel
@{
    ViewData["Title"] = "Thanh Toán Chưa Hoàn Tất";
}

<div class="py-5 my-4">
    <div class="mx-auto p-4 p-md-5 rounded-5 cinema-spotlight"
         style="max-width:600px;background:rgba(15,22,41,0.88);border:1px solid rgba(239,68,68,0.4);box-shadow:0 30px 70px rgba(0,0,0,0.65);">
        <div class="text-center mb-4">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                 style="width:78px;height:78px;background:rgba(239,68,68,0.16);border:2px solid #EF4444;color:#F87171;font-size:2.4rem;">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <span class="badge rounded-pill px-3 py-1 mb-2" style="background:rgba(239,68,68,0.18);color:#F87171;">GIAO DỊCH BỊ GIÁN ĐOẠN</span>
            <h2 class="text-white fw-bolder mb-1" style="font-family:'Space Grotesk',sans-serif;">Thanh Toán Chưa Thành Công</h2>
            <p class="text-white-50 small mb-0">
                @(TempData["Message"]?.ToString() ?? "Giao dịch đã bị hủy hoặc hết thời gian chờ thanh toán. Ghế của bạn đã được giải phóng để đặt lại.")
            </p>
        </div>

        @if (Model != null)
        {
            <div class="p-3 rounded-4 mb-4" style="background:rgba(255,255,255,0.04);border:1px dashed rgba(255,255,255,0.16);">
                <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25 small">
                    <span class="text-white-50">Mã phản hồi VNPAY:</span>
                    <strong class="text-danger font-monospace">@(Model.VnPayResponseCode ?? "N/A")</strong>
                </div>
                <div class="d-flex justify-content-between py-2 small">
                    <span class="text-white-50">Nội dung đơn:</span>
                    <strong class="text-white text-end">@(Model.OrderDescription ?? "Đặt vé CinemaHub")</strong>
                </div>
            </div>
        }

        <div class="d-flex flex-wrap gap-3">
            <a asp-controller="Showtimes" asp-action="Index"
               class="btn flex-grow-1 rounded-4 py-3 fw-bold text-white"
               style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                <i class="bi bi-arrow-repeat me-1"></i> Chọn Lại Ghế &amp; Thanh Toán
            </a>
            <a asp-controller="Home" asp-action="Index"
               class="btn rounded-4 px-4 py-3 fw-semibold text-white"
               style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);">
                Trang Chủ
            </a>
        </div>
    </div>
</div>
