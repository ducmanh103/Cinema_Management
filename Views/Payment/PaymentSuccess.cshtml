@model VnPaymentResponseModel
@{
    ViewData["Title"] = "Thanh Toán Thành Công";
}

<div class="py-5 my-4">
    <div class="mx-auto p-4 p-md-5 rounded-5 cinema-spotlight"
         style="max-width:600px;background:rgba(15,22,41,0.88);border:1px solid rgba(16,185,129,0.35);box-shadow:0 30px 70px rgba(0,0,0,0.65);">
        <div class="text-center mb-4">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                 style="width:78px;height:78px;background:rgba(16,185,129,0.16);border:2px solid #10B981;color:#34D399;font-size:2.4rem;">
                <i class="bi bi-check2-all"></i>
            </div>
            <span class="badge rounded-pill px-3 py-1 mb-2" style="background:rgba(16,185,129,0.18);color:#34D399;">GIAO DỊCH HOÀN TẤT</span>
            <h2 class="text-white fw-bolder mb-1" style="font-family:'Space Grotesk',sans-serif;">Đặt Vé Thành Công!</h2>
            <p class="text-white-50 small mb-0">Vé điện tử QR của bạn đã được kích hoạt trong Ví Vé CinemaHub.</p>
        </div>

        <div class="p-3 rounded-4 mb-4" style="background:rgba(255,255,255,0.04);border:1px dashed rgba(255,255,255,0.16);">
            <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25 small">
                <span class="text-white-50">Mã đơn hàng:</span>
                <strong class="text-white font-monospace">#@(Model?.OrderId ?? "N/A")</strong>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25 small">
                <span class="text-white-50">Mã giao dịch VNPAY:</span>
                <strong class="text-info font-monospace">@(Model?.TransactionId ?? "N/A")</strong>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25 small">
                <span class="text-white-50">Phương thức:</span>
                <strong class="text-white">@(Model?.PaymentMethod ?? "VNPAY")</strong>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25 small">
                <span class="text-white-50">Nội dung:</span>
                <strong class="text-white text-end" style="max-width:65%;">@(Model?.OrderDescription ?? "Thanh toán vé xem phim")</strong>
            </div>
            <div class="d-flex justify-content-between pt-3 align-items-baseline">
                <span class="text-white-50 fw-semibold">Tổng tiền đã thanh toán:</span>
                <strong class="text-warning fs-4 fw-bolder">@((Model?.Amount ?? 0).ToString("N0")) ₫</strong>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3">
            <a asp-controller="Booking" asp-action="MyTickets"
               class="btn flex-grow-1 rounded-4 py-3 fw-bold text-white"
               style="background:linear-gradient(135deg,#FF2E55,#FF6B35);">
                <i class="bi bi-qr-code-scan me-1"></i> Mở Ví Vé Điện Tử
            </a>
            <a asp-controller="Home" asp-action="Index"
               class="btn rounded-4 px-4 py-3 fw-semibold text-white"
               style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);">
                Về Trang Chủ
            </a>
        </div>
    </div>
</div>
