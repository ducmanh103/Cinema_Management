@{
    ViewData["Title"] = "Phân Tích Doanh Thu Phòng Vé";
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Now.Year;
    var availableYears = ViewBag.AvailableYears as List<int> ?? new List<int> { selectedYear };
    var topMovies = ViewBag.TopMovies as List<MovieRevenueDto> ?? new List<MovieRevenueDto>();
}

<!-- Filter & KPI Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="text-white fw-bold mb-1"><i class="bi bi-graph-up-arrow text-warning me-2"></i>Báo Cáo Tài Chính &amp; Doanh Thu Năm @selectedYear</h4>
        <p class="text-white-50 small mb-0">Thống kê doanh thu thực tế theo tháng, phương thức thanh toán và hiệu suất từng phim</p>
    </div>

    <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
        <label class="text-white-50 small fw-bold">Năm thống kê:</label>
        <select name="year" class="form-select form-select-sm bg-dark text-white border-secondary" onchange="this.form.submit()">
            @foreach (var y in availableYears)
            {
                <option value="@y" selected="@(y == selectedYear ? "selected" : null)">Năm @y</option>
            }
        </select>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="adm-kpi-card">
            <div>
                <div class="text-white-50 small">Doanh Thu Toàn Hệ Thống</div>
                <div class="fs-4 fw-bolder text-warning">@(((decimal)(ViewBag.TotalRevenue ?? 0m)).ToString("N0")) ₫</div>
            </div>
            <div class="adm-kpi-icon" style="background:rgba(245,185,66,0.16);color:#F5B942;"><i class="bi bi-coin"></i></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="adm-kpi-card">
            <div>
                <div class="text-white-50 small">Doanh Thu Năm @selectedYear</div>
                <div class="fs-4 fw-bolder text-success">@(((decimal)(ViewBag.YearRevenue ?? 0m)).ToString("N0")) ₫</div>
            </div>
            <div class="adm-kpi-icon" style="background:rgba(16,185,129,0.16);color:#34D399;"><i class="bi bi-calendar-check"></i></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="adm-kpi-card">
            <div>
                <div class="text-white-50 small">Vé Bán Trong Năm @selectedYear</div>
                <div class="fs-3 fw-bolder text-info">@((ViewBag.YearTickets ?? 0).ToString("N0"))</div>
            </div>
            <div class="adm-kpi-icon" style="background:rgba(56,189,248,0.16);color:#38BDF8;"><i class="bi bi-ticket-detailed"></i></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="adm-kpi-card">
            <div>
                <div class="text-white-50 small">Tổng Vé Đã Thanh Toán</div>
                <div class="fs-3 fw-bolder text-white">@((ViewBag.TotalPaidTickets ?? 0).ToString("N0"))</div>
            </div>
            <div class="adm-kpi-icon" style="background:rgba(255,46,85,0.16);color:#FF8FA3;"><i class="bi bi-check2-all"></i></div>
        </div>
    </div>
</div>

<!-- Chart + Top Movies -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="adm-card h-100">
            <h5 class="text-white fw-bold mb-3">Biểu Đồ Doanh Thu 12 Tháng (@selectedYear)</h5>
            <canvas id="revenueChartCanvas" height="260"></canvas>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="adm-card h-100">
            <h5 class="text-white fw-bold mb-3">Top Phim Doanh Thu Cao Nhất</h5>
            <div class="d-flex flex-column gap-3">
                @foreach (var m in topMovies.Take(6))
                {
                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 mb-2" style="background:#f8fafc;border:1px solid #f1f5f9;">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@m.PosterUrl" alt="@m.MovieTitle" style="width:42px;height:58px;object-fit:cover;border-radius:8px;"
                                 onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=200'" />
                            <div>
                                <div class="text-dark fw-bold small">@m.MovieTitle</div>
                                <div class="text-muted" style="font-size:0.75rem;">@m.TicketCount vé đã bán</div>
                            </div>
                        </div>
                        <div class="text-danger fw-bold small">@m.TotalRevenue.ToString("N0") ₫</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var ctx = document.getElementById('revenueChartCanvas');
            if (!ctx) return;

            var labels = @Html.Raw(ViewBag.ChartLabels ?? "[]");
            var revData = @Html.Raw(ViewBag.ChartRevenue ?? "[]");

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: revData,
                        backgroundColor: 'rgba(255, 46, 85, 0.75)',
                        borderColor: '#FF2E55',
                        borderWidth: 1,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { labels: { color: '#334155', font: { family: "'Plus Jakarta Sans', sans-serif", weight: '600' } } }
                    },
                    scales: {
                        x: { ticks: { color: '#64748b' }, grid: { color: 'rgba(0,0,0,0.06)' } },
                        y: { ticks: { color: '#64748b' }, grid: { color: 'rgba(0,0,0,0.06)' } }
                    }
                }
            });
        });
    </script>
}
