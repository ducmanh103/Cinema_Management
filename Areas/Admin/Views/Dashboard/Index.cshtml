@{
    ViewData["Title"] = "Tổng Quan Điều Hành";
    var recentTickets = ViewBag.RecentTickets as List<TicketDto> ?? new List<TicketDto>();
}

<!-- KPI Row -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="adm-kpi-card">
            <div>
                <div class="text-white-50 small fw-semibold mb-1">Tổng Kho Phim</div>
                <div class="fs-2 fw-bolder text-white">@(ViewBag.TotalMovies ?? 0)</div>
                <a asp-controller="Movies" asp-action="Index" class="text-info text-decoration-none small">Quản lý phim <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="adm-kpi-icon" style="background:rgba(56,189,248,0.15);color:#38BDF8;">
                <i class="bi bi-camera-reels-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="adm-kpi-card">
            <div>
                <div class="text-white-50 small fw-semibold mb-1">Vé Đã Phát Hành</div>
                <div class="fs-2 fw-bolder text-success">@(ViewBag.TotalTickets ?? 0)</div>
                <a asp-controller="Showtimes" asp-action="Index" class="text-success text-decoration-none small">Xem lịch chiếu <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="adm-kpi-icon" style="background:rgba(16,185,129,0.15);color:#34D399;">
                <i class="bi bi-ticket-perforated-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="adm-kpi-card">
            <div>
                <div class="text-white-50 small fw-semibold mb-1">Thành Viên Đăng Ký</div>
                <div class="fs-2 fw-bolder text-warning">@(ViewBag.TotalUsers ?? 0)</div>
                <span class="text-white-50 small">Tài khoản hoạt động</span>
            </div>
            <div class="adm-kpi-icon" style="background:rgba(245,185,66,0.15);color:#F5B942;">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="adm-kpi-card">
            <div>
                <div class="text-white-50 small fw-semibold mb-1">Tổng Doanh Thu</div>
                <div class="fs-3 fw-bolder text-danger">@(((decimal)(ViewBag.TotalRevenue ?? 0m)).ToString("N0")) ₫</div>
                <a asp-controller="Revenue" asp-action="Index" class="text-danger text-decoration-none small">Phân tích biểu đồ <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="adm-kpi-icon" style="background:rgba(255,46,85,0.15);color:#FF8FA3;">
                <i class="bi bi-cash-stack"></i>
            </div>
        </div>
    </div>
</div>

<!-- Recent Bookings Table -->
<div class="adm-card">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h5 class="text-white fw-bold mb-0"><i class="bi bi-receipt-cutoff text-info me-2"></i>Giao Dịch Đặt Vé Gần Nhất</h5>
            <p class="text-white-50 small mb-0">Theo dõi và quản lý các vé vừa được đặt trên toàn hệ thống</p>
        </div>
        <a asp-controller="Showtimes" asp-action="Index" class="adm-btn-primary text-decoration-none small">
            <i class="bi bi-plus-circle me-1"></i> Tạo Suất Chiếu Mới
        </a>
    </div>

    <div class="table-responsive">
        <table id="recentTicketsTable" class="table table-dark-glass align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã Vé</th>
                    <th>Khách Hàng</th>
                    <th>Phim</th>
                    <th>Rạp / Phòng / Ghế</th>
                    <th>Suất Chiếu</th>
                    <th>Giá Vé</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in recentTickets)
                {
                    <tr id="ticket-row-@t.TicketId">
                        <td class="font-monospace fw-bold text-info">#@t.TicketId</td>
                        <td>@t.CustomerName</td>
                        <td class="fw-bold text-white">@t.MovieTitle</td>
                        <td>
                            <span class="text-info">@t.RoomName</span> •
                            <strong class="text-warning">Ghế @t.SeatNumber</strong>
                        </td>
                        <td>@t.StartTime.ToString("HH:mm dd/MM/yyyy")</td>
                        <td class="fw-bold text-warning">@t.Price.ToString("N0") ₫</td>
                        <td>
                            <span class="badge rounded-pill px-3 py-1"
                                  style="background:@(t.Status == "Booked" ? "rgba(16,185,129,0.18)" : "rgba(239,68,68,0.18)");color:@(t.Status == "Booked" ? "#34D399" : "#F87171");">
                                @t.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger rounded-3 js-delete-ticket"
                                    data-id="@t.TicketId">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<form id="delete-ticket-form" class="d-none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        $(function () {
            $('#recentTicketsTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 10
            });

            $(document).on('click', '.js-delete-ticket', function () {
                var id = $(this).data('id');
                if (!confirm('Bạn có chắc chắn muốn xóa vé #' + id + ' không?')) return;
                var token = $('#delete-ticket-form input[name="__RequestVerificationToken"]').val();

                $.post('@Url.Action("DeleteTicket", "Dashboard", new { area = "Admin" })', {
                    id: id,
                    __RequestVerificationToken: token
                }, function (res) {
                    if (res && res.success) {
                        $('#ticket-row-' + id).fadeOut(250, function () { $(this).remove(); });
                    } else {
                        alert(res.message || 'Không thể xóa vé.');
                    }
                });
            });
        });
    </script>
}
