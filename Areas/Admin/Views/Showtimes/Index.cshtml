@using CinemaManagement.Models
@using CinemaManagement.Models.ViewModels
@model List<ShowtimeDto>
@{
    ViewData["Title"] = "Quản lý suất chiếu";
    bool isAdmin = User.IsInRole("Admin");
    var movies = ViewBag.Movies as List<Movie> ?? new();
    var rooms = ViewBag.Rooms as List<Room> ?? new();
}

<section class="content-header">
    <h1>Suất chiếu <small>Danh sách lịch chiếu phim</small></h1>
    <ol class="breadcrumb">
        <li><a asp-controller="Dashboard" asp-action="Index"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Suất chiếu</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-calendar"></i> Danh sách suất chiếu (@Model.Count)</h3>
                    <div class="box-tools pull-right"><button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button></div>
                </div>
                <div class="box-body">
                    <div class="margin-bottom">
                        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#createShowtimeModal">
                            <i class="fa fa-plus"></i> Thêm suất chiếu mới
                        </button>
                    </div>
                    <div id="showtimes-table-wrapper" style="opacity:0; transition: opacity 0.25s ease;">
                    <table id="showtimes-table" class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr><th>ID</th><th>Phim</th><th>Rạp</th><th>Phòng chiếu</th><th>Giờ chiếu</th><th>Giá vé</th><th>Trạng thái</th><th>Thao tác</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var showtime in Model)
                            {
                                <tr>
                                    <td>@showtime.ShowtimeId</td>
                                    <td><strong>@showtime.MovieTitle</strong></td>
                                    <td>@showtime.TheaterName</td>
                                    <td>@showtime.RoomName</td>
                                    <td>@showtime.StartTime.ToString("HH:mm dd/MM/yyyy")</td>
                                    <td>@showtime.Price.ToString("N0") ₫</td>
                                    <td>
                                        @if (showtime.StartTime > DateTime.Now) { <span class="label label-success">Sắp chiếu</span> }
                                        else if (showtime.StartTime <= DateTime.Now && showtime.StartTime.AddMinutes(showtime.MovieDuration) > DateTime.Now) { <span class="label label-warning">Đang chiếu</span> }
                                        else { <span class="label label-default">Đã chiếu</span> }
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-xs btn-info btn-edit-showtime" data-id="@showtime.ShowtimeId" data-movie="@showtime.MovieId" data-room="@showtime.RoomId" data-time="@showtime.StartTime.ToString("yyyy-MM-ddTHH:mm")" data-price="@showtime.Price">
                                            <i class="fa fa-edit"></i> Sửa
                                        </button>
                                        @if (isAdmin)
                                        {
                                            <button type="button" class="btn btn-xs btn-danger btn-delete-showtime" data-id="@showtime.ShowtimeId" data-title="@showtime.MovieTitle">
                                                <i class="fa fa-trash"></i> Xoá
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MODAL: Thêm suất chiếu -->
<div class="modal fade" id="createShowtimeModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="CreateShowtime" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="background:#3c8dbc; color:#fff">
                    <button type="button" class="close" data-dismiss="modal" style="color:#fff"><span>&times;</span></button>
                    <h4 class="modal-title"><i class="fa fa-plus-circle"></i> Thêm suất chiếu mới</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Phim <span class="text-danger">*</span></label>
                        <select name="movieId" class="form-control" required>
                            <option value="">-- Chọn phim --</option>
                            @foreach (var m in movies) { <option value="@m.MovieId">@m.Title (@m.Duration phút)</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Phòng chiếu <span class="text-danger">*</span></label>
                        <select name="roomId" class="form-control" required>
                            <option value="">-- Chọn phòng --</option>
                            @foreach (var r in rooms) { <option value="@r.RoomId">@r.Theater?.TheaterName – @r.RoomName (@r.SeatCount ghế)</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Giờ chiếu <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="startTime" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>Giá vé (₫) <span class="text-danger">*</span></label>
                        <input type="number" name="price" class="form-control" min="0" step="1000" placeholder="Ví dụ: 85000" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Huỷ</button>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Lưu suất chiếu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Sửa suất chiếu -->
<div class="modal fade" id="editShowtimeModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="EditShowtime" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="showtimeId" id="edit-showtime-id" />
                <div class="modal-header" style="background:#00a65a; color:#fff">
                    <button type="button" class="close" data-dismiss="modal" style="color:#fff"><span>&times;</span></button>
                    <h4 class="modal-title"><i class="fa fa-edit"></i> Sửa suất chiếu <span id="edit-showtime-label"></span></h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Phim <span class="text-danger">*</span></label>
                        <select name="movieId" id="edit-movie-id" class="form-control" required>
                            <option value="">-- Chọn phim --</option>
                            @foreach (var m in movies) { <option value="@m.MovieId">@m.Title (@m.Duration phút)</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Phòng chiếu <span class="text-danger">*</span></label>
                        <select name="roomId" id="edit-room-id" class="form-control" required>
                            <option value="">-- Chọn phòng --</option>
                            @foreach (var r in rooms) { <option value="@r.RoomId">@r.Theater?.TheaterName – @r.RoomName (@r.SeatCount ghế)</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Giờ chiếu <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="startTime" id="edit-start-time" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>Giá vé (₫) <span class="text-danger">*</span></label>
                        <input type="number" name="price" id="edit-price" class="form-control" min="0" step="1000" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Huỷ</button>
                    <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="delete-showtime-form" asp-action="DeleteShowtime" method="post" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="delete-showtime-id-input" />
</form>

@section Scripts {
    <script>
        $(function () {
            $('#showtimes-table').DataTable({
                "language": { "url": "/adminlte/plugins/datatables/Vietnamese.json" },
                "order": [[0, "asc"]], "pageLength": 25, "responsive": true,
                "columnDefs": [{ "orderable": false, "targets": [7] }],
                "initComplete": function () { $('#showtimes-table-wrapper').css('opacity', '1'); }
            });
            $(document).on('click', '.btn-edit-showtime', function () {
                $('#edit-showtime-id').val($(this).data('id'));
                $('#edit-showtime-label').text('#' + $(this).data('id'));
                $('#edit-movie-id').val($(this).data('movie'));
                $('#edit-room-id').val($(this).data('room'));
                $('#edit-start-time').val($(this).data('time'));
                $('#edit-price').val($(this).data('price'));
                $('#editShowtimeModal').modal('show');
            });
            $(document).on('click', '.btn-delete-showtime', function () {
                var id = $(this).data('id'), title = $(this).data('title');
                if (confirm('Xoá suất chiếu #' + id + ' (' + title + ')?\nThao tác không thể hoàn tác!')) {
                    $('#delete-showtime-id-input').val(id);
                    $('#delete-showtime-form').submit();
                }
            });
        });
    </script>
}
