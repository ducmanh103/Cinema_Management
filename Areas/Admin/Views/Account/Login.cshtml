@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Cổng Quản Trị Hệ Thống — CinemaHub";
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Space+Grotesk:wght@700;800&display=swap" rel="stylesheet" />
    <style>
        body {
            background:
                radial-gradient(circle at 80% 20%, rgba(255, 46, 85, 0.14), transparent 45%),
                radial-gradient(circle at 20% 80%, rgba(99, 102, 241, 0.12), transparent 50%),
                #070a14;
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
            color: #f8fafc;
        }
        .adm-login-box {
            width: 100%;
            max-width: 440px;
            padding: 36px 30px;
            border-radius: 24px;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
        }
        .form-control:focus {
            border-color: #FF2E55;
            box-shadow: 0 0 0 3px rgba(255, 46, 85, 0.2);
        }
    </style>
</head>
<body>
    <div class="adm-login-box">
        <div class="text-center mb-4">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-4 text-white"
                 style="width:52px;height:52px;background:linear-gradient(135deg,#FF2E55,#FF6B35);font-size:1.4rem;box-shadow:0 10px 24px rgba(255,46,85,0.35);">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h3 class="text-white fw-bold mb-1" style="font-family:'Space Grotesk',sans-serif;font-size:1.5rem;">Cổng Quản Trị CinemaHub</h3>
            <p class="text-white-50 small mb-0">Hệ thống phân quyền dành riêng cho Admin &amp; Staff</p>
        </div>

        <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" id="adminLoginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@(ViewBag.ReturnUrl ?? ViewData["ReturnUrl"])" />
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label text-white-50 small fw-bold text-uppercase" style="letter-spacing:0.04em;">Tài khoản quản trị</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-white-50">
                        <i class="bi bi-person"></i>
                    </span>
                    <input asp-for="Username" id="admUsername" class="form-control bg-transparent border-secondary border-opacity-25 text-white py-2" placeholder="Nhập tên đăng nhập" autocomplete="username" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label text-white-50 small fw-bold text-uppercase" style="letter-spacing:0.04em;">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-white-50">
                        <i class="bi bi-lock"></i>
                    </span>
                    <input asp-for="Password" id="admPassword" type="password" class="form-control bg-transparent border-secondary border-opacity-25 text-white py-2" placeholder="••••••••" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary border-secondary border-opacity-25 text-white-50"
                            onclick="var p=document.getElementById('admPassword');p.type=p.type==='password'?'text':'password';">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input bg-transparent border-secondary" id="admRemember" />
                    <label asp-for="RememberMe" class="form-check-label text-white-50 small" for="admRemember">Duy trì đăng nhập</label>
                </div>
            </div>

            <button type="submit" class="btn w-100 rounded-4 py-3 fw-bold text-white mb-3"
                    style="background:linear-gradient(135deg,#FF2E55,#FF6B35);box-shadow:0 10px 24px rgba(255,46,85,0.3);border:none;">
                <span>Đăng Nhập Hệ Thống</span>
            </button>
        </form>

        <div class="text-center pt-2 border-top border-white border-opacity-10">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none small">
                <i class="bi bi-arrow-left me-1"></i> Trở về trang chủ CinemaHub
            </a>
        </div>
    </div>
</body>
</html>
