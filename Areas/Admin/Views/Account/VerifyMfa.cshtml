@model VerifyAdminMfaViewModel
@{
    Layout = null;
    ViewData["Title"] = "Xác thực bảo mật 2 lớp (MFA) — Quản trị CinemaHub";
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg-void: #0F1117;
            --bg-surface: #171B26;
            --bg-carbon: #121620;
            --ivory: #F8FAFC;
            --stone: #CBD5E1;
            --muted: #94A3B8;
            --vermilion: #E53935;
            --gold: #F59E0B;
            --border-line: rgba(255, 255, 255, 0.09);
            --border-strong: rgba(255, 255, 255, 0.16);
        }
        body {
            background:
                radial-gradient(circle at 80% 18%, rgba(245, 158, 11, 0.08), transparent 48%),
                radial-gradient(circle at 18% 82%, rgba(229, 57, 53, 0.1), transparent 50%),
                var(--bg-void);
            font-family: 'Be Vietnam Pro', sans-serif;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
            color: var(--ivory);
        }
        .adm-mfa-box {
            width: 100%;
            max-width: 480px;
            background: var(--bg-surface);
            border: 1px solid var(--border-strong);
            border-radius: 18px;
            box-shadow: 0 28px 64px rgba(0, 0, 0, 0.65);
            overflow: hidden;
        }
        .adm-mfa-plate {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 22px;
            background: var(--bg-carbon);
            border-bottom: 1px solid var(--border-line);
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--gold);
        }
        .adm-mfa-body {
            padding: 32px 28px;
        }
        .otp-input {
            letter-spacing: 12px;
            font-size: 1.85rem;
            text-align: center;
            font-weight: 800;
            color: var(--gold) !important;
            background: var(--bg-carbon) !important;
            border: 1px solid var(--border-strong) !important;
            border-radius: 12px;
        }
        .otp-input:focus {
            border-color: var(--gold) !important;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2) !important;
        }
        .btn-mfa-submit {
            background: linear-gradient(135deg, #E53935 0%, #C62828 100%);
            border: none;
            color: var(--ivory);
            font-size: 0.92rem;
            font-weight: 700;
            border-radius: 12px;
            padding: 13px;
            transition: all 0.2s ease;
            box-shadow: 0 10px 24px rgba(229, 57, 53, 0.28);
        }
        .btn-mfa-submit:hover {
            background: linear-gradient(135deg, #F44336 0%, #D32F2F 100%);
            transform: translateY(-2px);
            color: var(--ivory);
        }
    </style>
</head>
<body>
    <div class="adm-mfa-box">
        <div class="adm-mfa-plate">
            <span><i class="bi bi-shield-lock me-1"></i> Xác thực bảo mật 2 lớp</span>
            <span>Quản trị viên CinemaHub</span>
        </div>

        <div class="adm-mfa-body">
            <div class="text-center mb-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:54px;height:54px;border-radius:14px;background:rgba(229,57,53,0.16);border:1px solid var(--vermilion);color:var(--gold);font-size:1.5rem;">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h3 class="fw-bold mb-1" style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.45rem;color:var(--ivory);">Bảo Mật 2 Lớp (MFA)</h3>
                <p class="small mb-0" style="color:var(--stone);">Xác thực quyền quản trị viên trước khi mở bảng điều khiển</p>
            </div>

            <div class="p-3 mb-4 d-flex align-items-center gap-2" style="background:var(--bg-carbon);border:1px solid var(--border-line);border-radius:12px;font-size:0.84rem;color:var(--stone);">
                <i class="bi bi-info-circle-fill fs-5 flex-shrink-0" style="color:var(--gold);"></i>
                <div>
                    Mã OTP 6 chữ số đã được gửi tới Email <strong style="color:var(--ivory);">@Model.MaskedEmail</strong> và kênh <strong style="color:var(--ivory);">Telegram Bot</strong> quản trị.
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="p-2 px-3 small mb-3" style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.45);border-radius:10px;color:#6ee7b7;">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="p-2 px-3 small mb-3" style="background:rgba(229,57,53,0.15);border:1px solid rgba(229,57,53,0.5);border-radius:10px;color:#fca5a5;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                </div>
            }

            <form asp-area="Admin" asp-controller="Account" asp-action="VerifyMfa" method="post" id="mfaForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="OtpCode" class="form-label small fw-bold" style="font-size:0.82rem;color:var(--stone);">
                        Nhập mã OTP 6 chữ số
                    </label>
                    <input asp-for="OtpCode"
                           id="mfaOtpInput"
                           class="form-control otp-input py-2"
                           placeholder="••••••"
                           maxlength="6"
                           minlength="6"
                           inputmode="numeric"
                           pattern="[0-9]{6}"
                           autocomplete="one-time-code"
                           value=""
                           autofocus />
                    <span asp-validation-for="OtpCode" class="text-danger small"></span>
                    <div class="small mt-2 d-flex justify-content-between align-items-center" style="color:var(--muted);font-size:0.78rem;">
                        <span><i class="bi bi-clock me-1"></i> Mã có hiệu lực trong 5 phút</span>
                        <span id="countdownText" style="color:var(--gold);font-weight:700;"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-mfa-submit w-100 mb-3 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-shield-check"></i>
                    <span>Xác nhận &amp; Đăng nhập</span>
                </button>
            </form>

            <div class="d-flex justify-content-between align-items-center pt-3 mt-2" style="border-top:1px solid var(--border-line);">
                <form asp-area="Admin" asp-controller="Account" asp-action="ResendMfaOtp" method="post" id="resendForm">
                    @Html.AntiForgeryToken()
                    <button type="submit" id="btnResend" class="btn btn-link text-decoration-none p-0 small" style="color:var(--gold);font-size:0.82rem;font-weight:600;">
                        <i class="bi bi-arrow-clockwise me-1"></i> Gửi lại mã OTP
                    </button>
                </form>

                <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="text-decoration-none small" style="color:var(--stone);font-size:0.82rem;">
                    <i class="bi bi-box-arrow-left me-1"></i> Đăng nhập lại
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) window.location.reload();
        });

        document.addEventListener('DOMContentLoaded', function () {
            var input = document.getElementById('mfaOtpInput');
            var form = document.getElementById('mfaForm');
            var resendForm = document.getElementById('resendForm');
            var submitBtn = document.querySelector('.btn-mfa-submit');
            var btnResend = document.getElementById('btnResend');
            var isSubmitting = false;

            function submitMfaForm() {
                if (isSubmitting || !form) return;
                if (input) {
                    var sanitized = input.value.replace(/\D/g, '').slice(0, 6);
                    input.value = sanitized;
                    if (!/^\d{6}$/.test(sanitized)) return;
                    input.readOnly = true;
                }
                isSubmitting = true;
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> <span>Đang xác thực...</span>';
                }
                if (btnResend) {
                    btnResend.disabled = true;
                    btnResend.classList.add('opacity-50', 'pe-none');
                }
                form.submit();
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    if (isSubmitting) {
                        e.preventDefault();
                        return;
                    }
                    var val = input ? input.value.replace(/\D/g, '').slice(0, 6) : '';
                    if (/^\d{6}$/.test(val)) {
                        e.preventDefault();
                        submitMfaForm();
                    }
                });
            }

            if (resendForm) {
                resendForm.addEventListener('submit', function (e) {
                    if (isSubmitting) {
                        e.preventDefault();
                        return;
                    }
                    isSubmitting = true;
                    if (input) input.readOnly = true;
                    if (submitBtn) submitBtn.disabled = true;
                    if (btnResend) {
                        btnResend.disabled = true;
                        btnResend.classList.add('opacity-50', 'pe-none');
                        btnResend.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Đang gửi lại...';
                    }
                });
            }

            if (input) {
                input.value = '';
                input.focus();

                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        if (!isSubmitting && /^\d{6}$/.test(this.value.replace(/\D/g, ''))) {
                            submitMfaForm();
                        } else if (!isSubmitting && form && form.reportValidity) {
                            form.reportValidity();
                        }
                        return;
                    }
                    if (isSubmitting) {
                        e.preventDefault();
                        return;
                    }
                    var allowedKeys = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab'];
                    if (allowedKeys.includes(e.key) || e.ctrlKey || e.metaKey) return;
                    if (!/^[0-9]$/.test(e.key) || this.value.length >= 6) {
                        e.preventDefault();
                    }
                });

                input.addEventListener('input', function () {
                    if (isSubmitting) return;
                    var sanitized = this.value.replace(/\D/g, '').slice(0, 6);
                    if (this.value !== sanitized) this.value = sanitized;
                    if (this.value.length === 6) {
                        submitMfaForm();
                    }
                });

                input.addEventListener('paste', function (e) {
                    e.preventDefault();
                    if (isSubmitting) return;
                    var paste = (e.clipboardData || window.clipboardData).getData('text') || '';
                    this.value = paste.replace(/\D/g, '').slice(0, 6);
                    if (this.value.length === 6) {
                        submitMfaForm();
                    }
                });
            }

            var timeLeft = @Model.RemainingSeconds;
            var countdownEl = document.getElementById('countdownText');
            function updateTimer() {
                var m = Math.floor(timeLeft / 60);
                var s = timeLeft % 60;
                if (countdownEl) {
                    countdownEl.textContent = (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
                }
                if (timeLeft > 0) {
                    timeLeft--;
                    setTimeout(updateTimer, 1000);
                } else if (countdownEl && !isSubmitting) {
                    countdownEl.textContent = 'ĐÃ HẾT HẠN';
                    countdownEl.classList.add('text-danger');
                    if (input) input.disabled = true;
                    if (submitBtn) submitBtn.disabled = true;
                }
            }
            updateTimer();

            var cooldown = @Model.ResendCooldownSeconds;
            if (btnResend && cooldown > 0) {
                btnResend.disabled = true;
                btnResend.classList.add('opacity-50', 'pe-none');
                var origText = '<i class="bi bi-arrow-clockwise me-1"></i> Gửi lại mã OTP';
                function updateCooldown() {
                    if (isSubmitting) return;
                    if (cooldown > 0) {
                        btnResend.innerHTML = '<i class="bi bi-clock me-1"></i> Gửi lại sau ' + cooldown + 's';
                        cooldown--;
                        setTimeout(updateCooldown, 1000);
                    } else {
                        btnResend.disabled = false;
                        btnResend.classList.remove('opacity-50', 'pe-none');
                        btnResend.innerHTML = origText;
                    }
                }
                updateCooldown();
            }
        });
    </script>
</body>
</html>
