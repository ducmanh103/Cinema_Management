@model CinemaManagement.Models.Movie
@{
    ViewData["Title"] = "Chi Tiết Phim: " + Model.Title;
    var genres = ViewBag.Genres as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<div class="adm-card mx-auto" style="max-width:980px;">
    <!-- HEADER WITH BANNER IF AVAILABLE -->
    @if (!string.IsNullOrWhiteSpace(Model.BannerUrl))
    {
        <div class="w-100 rounded-4 overflow-hidden mb-4 position-relative shadow-sm" style="height:220px; border:1px solid #e2e8f0;">
            <img src="@Model.BannerUrl" alt="Banner @Model.Title" class="w-100 h-100" style="object-fit:cover;"
                 onerror="this.parentElement.style.display='none'" />
            <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background:linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
                <span class="badge bg-primary text-white px-2 py-1 rounded-pill small"><i class="bi bi-aspect-ratio me-1"></i> Ảnh Banner 16:9</span>
            </div>
        </div>
    }

    <div class="row g-4 align-items-start">
        <div class="col-md-4">
            <div class="position-relative">
                <img src="@Model.PosterUrl"
                     alt="@Model.Title"
                     class="w-100 rounded-4 shadow-sm border"
                     style="aspect-ratio:2/3;object-fit:cover;"
                     onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=600'" />
                <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 text-white rounded-pill px-2 py-1 small">
                    Poster 2:3
                </span>
            </div>
        </div>

        <div class="col-md-8">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 fw-bold">Mã Phim #@Model.MovieId</span>
                <span class="badge rounded-pill px-3 py-1 fw-semibold"
                      style="background:@(Model.Status == "Now Showing" ? "#f0fdf4" : Model.Status == "Coming Soon" ? "#fffbeb" : "#f8fafc");color:@(Model.Status == "Now Showing" ? "#16a34a" : Model.Status == "Coming Soon" ? "#d97706" : "#64748b");border:1px solid @(Model.Status == "Now Showing" ? "#bbf7d0" : Model.Status == "Coming Soon" ? "#fde68a" : "#e2e8f0");">
                    @(Model.Status == "Now Showing" ? "Đang khởi chiếu" : Model.Status == "Coming Soon" ? "Sắp khởi chiếu" : "Ngừng chiếu")
                </span>
            </div>

            <h2 class="text-dark fw-bolder mb-3" style="font-family:'Space Grotesk',sans-serif;">@Model.Title</h2>

            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var g in genres)
                {
                    <span class="badge rounded-pill px-3 py-1" style="background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;font-size:0.85rem;">@g</span>
                }
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <div class="p-3 rounded-4 bg-light border">
                        <div class="text-muted small fw-bold text-uppercase">Thời lượng</div>
                        <div class="text-dark fw-bold fs-5">@Model.Duration phút</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded-4 bg-light border">
                        <div class="text-muted small fw-bold text-uppercase">Ngày khởi chiếu</div>
                        <div class="text-danger fw-bold fs-5">@(Model.ReleaseDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded-4 bg-light border">
                        <div class="text-muted small fw-bold text-uppercase">Tổng số vé đã đặt</div>
                        <div class="text-dark fw-bold fs-5">@((int)(ViewBag.TotalTickets ?? 0)) vé</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded-4 bg-light border">
                        <div class="text-muted small fw-bold text-uppercase">Doanh thu ghi nhận</div>
                        <div class="text-success fw-bold fs-5">@(((decimal)(ViewBag.TotalRevenue ?? 0m)).ToString("N0")) đ</div>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <div class="text-muted small fw-bold text-uppercase mb-1">Mô tả nội dung:</div>
                <p class="text-secondary mb-0" style="line-height:1.7;">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có tóm tắt nội dung cho bộ phim này." : Model.Description)
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                <a asp-action="Edit" asp-route-id="@Model.MovieId" class="adm-btn-primary text-decoration-none">
                    <i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa Phim
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">
                    <i class="bi bi-arrow-left me-1"></i> Danh Sách Phim
                </a>
            </div>
        </div>
    </div>
</div>
