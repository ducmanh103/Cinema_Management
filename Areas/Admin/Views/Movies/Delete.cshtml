@model CinemaManagement.Models.Movie
@{
    ViewData["Title"] = "Xác Nhận Xóa Phim";
}

<div class="adm-card mx-auto" style="max-width:680px;border-color:rgba(239,68,68,0.4);">
    <div class="text-center mb-4">
        <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
             style="width:68px;height:68px;background:rgba(239,68,68,0.16);color:#F87171;font-size:2rem;">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h3 class="text-white fw-bold mb-1">Xác Nhận Xóa Bộ Phim Này?</h3>
        <p class="text-white-50 small mb-0">Hành động này sẽ xóa vĩnh viễn phim <strong class="text-white">@Model.Title</strong> cùng các dữ liệu liên quan.</p>
    </div>

    <div class="d-flex align-items-center gap-3 p-3 rounded-4 mb-4" style="background:#f8fafc;border:1px solid #e2e8f0;">
        <img src="@Model.PosterUrl"
             alt="@Model.Title"
             style="width:64px;height:92px;object-fit:cover;border-radius:10px;"
             onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=200'" />
        <div>
            <h5 class="text-dark fw-bold mb-1">@Model.Title</h5>
            <div class="text-muted small">Thời lượng: @Model.Duration phút • Khởi chiếu: @(Model.ReleaseDate?.ToString("dd/MM/yyyy") ?? "—")</div>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-3">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MovieId" />
        <button type="submit" class="btn btn-danger rounded-3 px-4 py-2 fw-bold">
            <i class="bi bi-trash3-fill me-1"></i> Xác Nhận Xóa Vĩnh Viễn
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 py-2">Hủy Bỏ</a>
    </form>
</div>
