@model List<MovieDto>
@{
    ViewData["Title"] = "Quản Lý Kho Phim";
    var movies = Model ?? new List<MovieDto>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 py-2 px-3 small mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="adm-card">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h5 class="text-dark fw-bold mb-1"><i class="bi bi-film text-danger me-2"></i>Danh Sách Phim Điện Ảnh (@movies.Count)</h5>
            <p class="text-muted small mb-0">Quản lý kho phim, upload tệp poster &amp; banner từ xa lên server, cập nhật thể loại và suất chiếu</p>
        </div>
        <a asp-action="Create" class="adm-btn-primary text-decoration-none">
            <i class="bi bi-plus-lg me-1"></i> Thêm Phim Mới
        </a>
    </div>

    <div class="table-responsive">
        <table id="adminMoviesTable" class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Poster &amp; Banner</th>
                    <th>Tên Phim</th>
                    <th>Thể Loại</th>
                    <th>Thời Lượng</th>
                    <th>Khởi Chiếu</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in movies)
                {
                    <tr>
                        <td class="font-monospace text-muted">#@m.MovieId</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@m.PosterUrl"
                                     alt="@m.Title"
                                     title="Poster dọc (2:3)"
                                     style="width:44px;height:62px;object-fit:cover;border-radius:6px;border:1px solid #e2e8f0;"
                                     onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=200'" />
                                @if (!string.IsNullOrWhiteSpace(m.BannerUrl))
                                {
                                    <div title="Banner ngang (16:9)">
                                        <img src="@m.BannerUrl"
                                             alt="Banner @m.Title"
                                             style="width:68px;height:38px;object-fit:cover;border-radius:6px;border:1px solid #cbd5e1;"
                                             onerror="this.style.display='none'" />
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border small" style="font-size:0.68rem;" title="Chưa có banner ngang">Chưa có banner</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@m.Title</div>
                            @if (!string.IsNullOrWhiteSpace(m.Description))
                            {
                                <div class="text-muted small text-truncate" style="max-width:240px;">@m.Description</div>
                            }
                        </td>
                        <td>
                            @if (m.Genres != null && m.Genres.Any())
                            {
                                foreach (var g in m.Genres)
                                {
                                    <span class="badge rounded-pill me-1 mb-1" style="background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;font-weight:500;">@g</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td>@m.Duration phút</td>
                        <td>@(m.ReleaseDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>
                            <span class="badge rounded-pill px-3 py-1 fw-semibold"
                                  style="background:@(m.Status == "Now Showing" ? "#f0fdf4" : m.Status == "Coming Soon" ? "#fffbeb" : "#f8fafc");color:@(m.Status == "Now Showing" ? "#16a34a" : m.Status == "Coming Soon" ? "#d97706" : "#64748b");border:1px solid @(m.Status == "Now Showing" ? "#bbf7d0" : m.Status == "Coming Soon" ? "#fde68a" : "#e2e8f0");">
                                @(m.Status == "Now Showing" ? "Đang chiếu" : m.Status == "Coming Soon" ? "Sắp chiếu" : "Ngừng chiếu")
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Details" asp-route-id="@m.MovieId" class="btn btn-sm btn-outline-info rounded-3" title="Chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@m.MovieId" class="btn btn-sm btn-outline-warning rounded-3" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@m.MovieId" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa phim">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#adminMoviesTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 10,
                language: {
                    search: "Tìm kiếm phim:",
                    lengthMenu: "Hiển thị _MENU_ phim",
                    info: "Đang hiển thị _START_ đến _END_ trong tổng số _TOTAL_ phim",
                    paginate: {
                        first: "Đầu",
                        last: "Cuối",
                        next: "Sau",
                        previous: "Trước"
                    }
                }
            });
        });
    </script>
}
