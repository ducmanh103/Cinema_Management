@using CinemaManagement.Models.ViewModels
@model List<MovieDto>
@{
    ViewData["Title"] = "Quản lý phim";
}

<section class="content-header">
    <h1>Phim <small>Danh sách phim trong hệ thống</small></h1>
    <ol class="breadcrumb">
        <li><a asp-controller="Dashboard" asp-action="Index"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Phim</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-film"></i> Danh sách phim (@Model.Count)</h3>
                    <div class="box-tools pull-right">
                        <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body">
                    <div class="margin-bottom">
                       <a asp-controller="Movies" asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> Thêm phim mới</a>
                    </div>
                    <table id="movies-table" class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th style="width: 50px;">Poster</th>
                                <th>ID</th>
                                <th>Tên phim</th>
                                <th>Thể loại</th>
                                <th>Thời lượng</th>
                                <th>Khởi chiếu</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var movie in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                        {
                                            <img src="@movie.PosterUrl" alt="@movie.Title" style="width: 40px; height: 60px; object-fit: cover;" onerror="this.src='/images/default-movie.jpg';" />
                                        }
                                        else
                                        {
                                            <div style="width: 40px; height: 60px; background: #ddd; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #777;">Trống</div>
                                        }
                                    </td>
                                    <td class="vertical-align-middle">@movie.MovieId</td>
                                    <td class="vertical-align-middle"><strong>@movie.Title</strong></td>
                                    <td class="vertical-align-middle">@(string.Join(", ", movie.Genres))</td>
                                    <td class="vertical-align-middle">@movie.Duration phút</td>
                                    <td class="vertical-align-middle">@(movie.ReleaseDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                    <td class="vertical-align-middle">
                                        @if (movie.Status == "Now Showing")
                                        {
                                            <span class="label label-success">Đang chiếu</span>
                                        }
                                        else if (movie.Status == "Coming Soon")
                                        {
                                            <span class="label label-warning">Sắp chiếu</span>
                                        }
                                        else
                                        {
                                            <span class="label label-default">Ngừng chiếu</span>
                                        }
                                    </td>
                                    <td class="vertical-align-middle">
                                        <a asp-controller="Movies" asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-xs btn-info"><i class="fa fa-edit"></i> Sửa</a>
                                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId" class="btn btn-xs btn-default"><i class="fa fa-eye"></i> Chi tiết</a>
                                        <a asp-controller="Movies" asp-action="Delete" asp-route-id="@movie.MovieId" class="btn btn-xs btn-danger"><i class="fa fa-trash"></i> Xoá</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <style>.vertical-align-middle { vertical-align: middle !important; }</style>
    <script>
        $(function () {
            $('#movies-table').DataTable({
                "language": { "url": "/adminlte/plugins/datatables/Vietnamese.json" },
                "order": [[1, "desc"]],
                "pageLength": 10,
                "responsive": true,
                "columnDefs": [{ "orderable": false, "targets": [0, 7] }]
            });
        });
    </script>
}
