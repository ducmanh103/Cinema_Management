<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@(Context.RequestServices.GetService<Microsoft.AspNetCore.Antiforgery.IAntiforgery>()?.GetAndStoreTokens(Context).RequestToken)" />
    <title>@ViewData["Title"] — Hệ Thống Quản Trị CinemaHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <style>
        :root {
            --adm-bg: #0F1117;
            --adm-surface: #141821;
            --adm-card: #171B26;
            --adm-card-elevated: #1E2433;
            --adm-border: rgba(255, 255, 255, 0.09);
            --adm-border-strong: rgba(255, 255, 255, 0.16);
            --adm-border-focus: #F59E0B;
            --adm-text: #F8FAFC;
            --adm-text-secondary: #CBD5E1;
            --adm-text-muted: #94A3B8;
            --adm-red: #E53935;
            --adm-red-hover: #F44336;
            --adm-gold: #F59E0B;
            --adm-cyan: #38BDF8;
            --adm-emerald: #10B981;
            --adm-sidebar-w: 268px;
            --font-display: 'Plus Jakarta Sans', 'Be Vietnam Pro', sans-serif;
            --font-sans: 'Be Vietnam Pro', sans-serif;
        }

        body {
            font-family: var(--font-sans);
            background:
                radial-gradient(ellipse 80% 50% at 80% 0%, rgba(245, 158, 11, 0.05), transparent 55%),
                var(--adm-bg);
            color: var(--adm-text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ─── Admin Sidebar ─── */
        .adm-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--adm-sidebar-w);
            background: var(--adm-surface);
            border-right: 1px solid var(--adm-border-strong);
            display: flex;
            flex-direction: column;
            z-index: 1040;
            transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 16px 0 40px rgba(0, 0, 0, 0.45);
        }

        .adm-brand {
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--adm-border);
            text-decoration: none;
            background: #11151E;
        }

        .adm-brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #E53935 0%, #C62828 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--adm-text);
            font-size: 1.1rem;
            box-shadow: 0 6px 16px rgba(229, 57, 53, 0.3);
            flex-shrink: 0;
        }

        .adm-brand-title {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 1.1rem;
            letter-spacing: -0.02em;
            color: var(--adm-text);
            line-height: 1.15;
        }

        .adm-brand-sub {
            font-size: 0.72rem;
            color: var(--adm-gold);
            font-weight: 600;
            margin-top: 2px;
        }

        .adm-nav {
            padding: 16px 12px;
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .adm-nav-section {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--adm-text-muted);
            padding: 14px 12px 6px;
        }

        .adm-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            border: 1px solid transparent;
            color: var(--adm-text-secondary);
            font-weight: 600;
            font-size: 0.88rem;
            text-decoration: none;
            transition: all 0.2s ease;
            position: relative;
        }

        .adm-nav-link i {
            font-size: 1.05rem;
            width: 20px;
            text-align: center;
            color: var(--adm-text-muted);
            transition: color 0.2s ease;
        }

        .adm-nav-link:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--adm-text);
        }

        .adm-nav-link:hover i {
            color: var(--adm-gold);
        }

        .adm-nav-link.active {
            background: rgba(229, 57, 53, 0.14);
            border: 1px solid rgba(229, 57, 53, 0.45);
            color: var(--adm-text);
            font-weight: 700;
        }

        .adm-nav-link.active i {
            color: var(--adm-red);
        }

        .adm-sidebar-footer {
            padding: 14px 16px;
            border-top: 1px solid var(--adm-border);
            background: #11151E;
        }

        /* ─── Main Operations Area ─── */
        .adm-main {
            margin-left: var(--adm-sidebar-w);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: transparent;
        }

        .adm-topbar {
            position: sticky;
            top: 0;
            z-index: 1020;
            padding: 14px 28px;
            background: rgba(20, 24, 33, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--adm-border-strong);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .adm-content {
            padding: 28px;
            flex: 1;
        }

        /* ─── Cards & KPI Blocks ─── */
        .adm-card {
            padding: 24px;
            border-radius: 16px;
            background: var(--adm-card);
            border: 1px solid var(--adm-border-strong);
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
            color: var(--adm-text);
            transition: border-color 0.22s ease, box-shadow 0.22s ease;
        }

        .adm-card:hover {
            border-color: rgba(245, 158, 11, 0.35);
        }

        .adm-card-title {
            font-family: var(--font-display);
            font-weight: 800;
            color: var(--adm-text);
            font-size: 1.15rem;
            letter-spacing: -0.015em;
        }

        .adm-card-sub {
            color: var(--adm-text-secondary);
            font-size: 0.85rem;
        }

        .adm-kpi-card {
            padding: 20px;
            border-radius: 14px;
            background: var(--adm-card);
            border: 1px solid var(--adm-border-strong);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
            transition: transform 0.22s ease, border-color 0.22s ease;
            position: relative;
            overflow: hidden;
        }

        .adm-kpi-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--adm-gold);
            opacity: 0.85;
        }

        .adm-kpi-card:hover {
            transform: translateY(-2px);
            border-color: rgba(245, 158, 11, 0.45);
        }

        .adm-kpi-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            border: 1px solid var(--adm-border);
            flex-shrink: 0;
        }

        /* ─── Tables & DataTables ─── */
        .table-dark-glass,
        table.dataTable,
        .table {
            --bs-table-bg: transparent !important;
            --bs-table-color: var(--adm-text) !important;
            --bs-table-border-color: var(--adm-border) !important;
            color: var(--adm-text) !important;
            vertical-align: middle;
        }

        .table-dark-glass thead th,
        table.dataTable thead th,
        .table thead th {
            background: #121620 !important;
            color: var(--adm-text-secondary) !important;
            font-size: 0.78rem !important;
            font-weight: 700 !important;
            padding: 12px 14px !important;
            border-bottom: 1px solid var(--adm-border-strong) !important;
            border-top: 1px solid var(--adm-border) !important;
        }

        .table-dark-glass tbody td,
        table.dataTable tbody td,
        .table tbody td {
            padding: 12px 14px !important;
            color: var(--adm-text) !important;
            border-bottom: 1px solid var(--adm-border) !important;
            background: transparent !important;
        }

        .table tbody tr:hover td,
        .table-hover tbody tr:hover td {
            background-color: rgba(255, 255, 255, 0.03) !important;
        }

        /* DataTables Pagination & Filter Controls */
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            color: var(--adm-text-secondary) !important;
            font-size: 0.84rem;
            margin: 8px 0;
        }

        .page-item .page-link {
            background: #121620;
            border-color: var(--adm-border-strong);
            color: var(--adm-text-secondary);
            border-radius: 8px !important;
            font-size: 0.82rem;
            margin: 0 2px;
        }

        .page-item.active .page-link {
            background: var(--adm-red);
            border-color: var(--adm-red);
            color: var(--adm-text);
        }

        /* ─── Form Controls & Modals ─── */
        .adm-content .form-control,
        .adm-content .form-select,
        .modal-content .form-control,
        .modal-content .form-select,
        .adm-card .form-control,
        .adm-card .form-select,
        .dataTables_wrapper input,
        .dataTables_wrapper select {
            background-color: #121620 !important;
            border: 1px solid var(--adm-border-strong) !important;
            color: var(--adm-text) !important;
            border-radius: 10px !important;
            font-size: 0.88rem;
            transition: all 0.2s ease;
        }

        .adm-content .form-control:focus,
        .adm-content .form-select:focus,
        .modal-content .form-control:focus,
        .modal-content .form-select:focus,
        .adm-card .form-control:focus,
        .adm-card .form-select:focus {
            border-color: var(--adm-gold) !important;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.18) !important;
            outline: none !important;
        }

        .adm-content label,
        .adm-card label,
        .modal-content label {
            color: var(--adm-text-secondary) !important;
            font-size: 0.82rem;
            font-weight: 600;
        }

        .modal-content {
            background: var(--adm-card) !important;
            border: 1px solid var(--adm-border-strong) !important;
            border-radius: 16px !important;
            color: var(--adm-text) !important;
            box-shadow: 0 28px 64px rgba(0, 0, 0, 0.75) !important;
            overflow: hidden;
        }

        .modal-header,
        .modal-footer {
            border-color: var(--adm-border) !important;
            background: #121620;
        }

        /* ─── Action Buttons ─── */
        .adm-btn-primary {
            background: linear-gradient(135deg, #E53935 0%, #C62828 100%);
            border: none;
            color: var(--adm-text) !important;
            font-weight: 700;
            font-size: 0.86rem;
            border-radius: 10px;
            padding: 9px 18px;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 8px 20px rgba(229, 57, 53, 0.25);
        }

        .adm-btn-primary:hover {
            background: linear-gradient(135deg, #F44336 0%, #D32F2F 100%);
            transform: translateY(-2px);
            color: var(--adm-text) !important;
        }

        /* Normalize legacy utility classes across all Admin sub-views */
        .adm-main .text-dark,
        .adm-main .text-white,
        .adm-card .text-dark,
        .adm-card .text-white,
        .modal-content .text-dark,
        .modal-content .text-white {
            color: var(--adm-text) !important;
        }

        .adm-main .text-muted,
        .adm-main .text-secondary,
        .adm-main .text-white-50,
        .adm-card .text-muted,
        .adm-card .text-white-50,
        .modal-content .text-muted,
        .modal-content .text-white-50 {
            color: var(--adm-text-secondary) !important;
        }

        .adm-main .bg-light,
        .adm-main .bg-white,
        .adm-main .bg-dark {
            background-color: #121620 !important;
            border-color: var(--adm-border) !important;
            color: var(--adm-text) !important;
        }

        .adm-main .btn-light {
            background: #1E2433 !important;
            border-color: var(--adm-border-strong) !important;
            color: var(--adm-text) !important;
            border-radius: 10px;
        }

        .adm-main .btn-light:hover {
            border-color: var(--adm-gold) !important;
            color: var(--adm-gold) !important;
        }

        .adm-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.72);
            backdrop-filter: blur(4px);
            z-index: 1035;
            display: none;
        }

        @@media (max-width: 991.98px) {
            .adm-sidebar {
                transform: translateX(-100%);
            }
            .adm-sidebar.show {
                transform: translateX(0);
            }
            .adm-backdrop.show {
                display: block;
            }
            .adm-main {
                margin-left: 0;
            }
            .adm-topbar {
                padding: 12px 16px;
            }
            .adm-content {
                padding: 16px 12px;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var userName = User.Identity?.Name ?? "Admin";
        var userRole = User.IsInRole("Admin") ? "Quản trị viên" : "Nhân viên điều phối";
    }

    <div class="adm-backdrop" id="admSidebarBackdrop"></div>

    <!-- Admin Sidebar -->
    <aside class="adm-sidebar" id="admSidebar">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="adm-brand">
            <div class="adm-brand-icon">
                <i class="bi bi-film"></i>
            </div>
            <div>
                <div class="adm-brand-title">CinemaHub</div>
                <div class="adm-brand-sub">Hệ thống quản trị rạp</div>
            </div>
        </a>

        <nav class="adm-nav">
            <div class="adm-nav-section">Quản lý vận hành</div>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="adm-nav-link @(currentController == "Dashboard" ? "active" : "")">
                <i class="bi bi-grid-1x2"></i>
                <span>Tổng quan hệ thống</span>
            </a>

            <a asp-area="Admin" asp-controller="Movies" asp-action="Index"
               class="adm-nav-link @(currentController == "Movies" ? "active" : "")">
                <i class="bi bi-camera-reels"></i>
                <span>Quản lý danh sách phim</span>
            </a>

            <a asp-area="Admin" asp-controller="Showtimes" asp-action="Index"
               class="adm-nav-link @(currentController == "Showtimes" ? "active" : "")">
                <i class="bi bi-calendar2-week"></i>
                <span>Quản lý lịch chiếu</span>
            </a>

            <a asp-area="Admin" asp-controller="Revenue" asp-action="Index"
               class="adm-nav-link @(currentController == "Revenue" ? "active" : "")">
                <i class="bi bi-bar-chart-line"></i>
                <span>Thống kê doanh thu</span>
            </a>

            @if (User.IsInRole("Admin"))
            {
                <div class="adm-nav-section mt-2">Quản trị hệ thống</div>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                   class="adm-nav-link @(currentController == "Users" ? "active" : "")">
                    <i class="bi bi-people"></i>
                    <span>Tài khoản &amp; Phân quyền</span>
                </a>
            }

            <div class="adm-nav-section mt-2">Trang khách hàng</div>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="adm-nav-link">
                <i class="bi bi-globe2"></i>
                <span>Xem trang chủ đặt vé</span>
            </a>
        </nav>

        <div class="adm-sidebar-footer">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center fw-bold"
                         style="width:36px;height:36px;border-radius:10px;background:var(--adm-red);color:var(--adm-text);font-size:0.88rem;">
                        @(userName.Length > 0 ? userName[0].ToString().ToUpper() : "A")
                    </div>
                    <div>
                        <div class="fw-bold small" style="line-height:1.2;color:var(--adm-text);">@userName</div>
                        <div style="font-size:0.72rem;color:var(--adm-gold);font-weight:600;">@userRole</div>
                    </div>
                </div>
                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius:8px;padding:5px 10px;" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="adm-main">
        <header class="adm-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-sm btn-outline-secondary d-lg-none" id="admToggleBtn" style="border-radius:8px;color:var(--adm-text);">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div>
                    <div style="font-size:0.74rem;font-weight:600;color:var(--adm-gold);">
                        Điều hành cụm rạp CinemaHub
                    </div>
                    <h5 class="mb-0 fw-bold" style="font-family:var(--font-display);font-size:1.15rem;color:var(--adm-text);">
                        @ViewData["Title"]
                    </h5>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <span class="px-3 py-1 d-none d-sm-inline-flex align-items-center gap-2"
                      style="background:rgba(16,185,129,0.12);color:#6ee7b7;border:1px solid rgba(16,185,129,0.4);border-radius:999px;font-size:0.75rem;font-weight:600;">
                    <span style="width:7px;height:7px;border-radius:50%;background:#10b981;box-shadow:0 0 6px #10b981;"></span>
                    Hệ thống hoạt động bình thường
                </span>
                <a asp-area="" asp-controller="Showtimes" asp-action="Index" class="btn btn-sm px-3"
                   style="background:#1E2433;border:1px solid var(--adm-border-strong);border-radius:10px;color:var(--adm-text);font-size:0.8rem;font-weight:600;">
                    <i class="bi bi-ticket-perforated me-1" style="color:var(--adm-gold);"></i> Lịch chiếu khách hàng
                </a>
            </div>
        </header>

        <main class="adm-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/security.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toggleBtn = document.getElementById('admToggleBtn');
            var sidebar = document.getElementById('admSidebar');
            var backdrop = document.getElementById('admSidebarBackdrop');

            if (toggleBtn && sidebar && backdrop) {
                toggleBtn.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                    backdrop.classList.toggle('show');
                });
                backdrop.addEventListener('click', function () {
                    sidebar.classList.remove('show');
                    backdrop.classList.remove('show');
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
